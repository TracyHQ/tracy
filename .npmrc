# npmjs is the only registry. Everything TCH needs that npmjs does not carry is a
# WORKSPACE MEMBER in this repository -- `@deepseek-ai/*` from `vendor/tracy/deepseek-harness`,
# the five forked plugins from `vendor/*` -- so there is no second registry to reach,
# no token to hold, and no machine that resolves this tree differently from another.
registry=https://registry.npmjs.org
