# ─────────────────────────────────────────────────────────────────────────────
# TCH — profile `native` (./run.sh native), the STANDALONE lane: dsh is the
# shell, with no Worker in front of it to mint a session.  Copy to `.env.native`.
# Read the header of `.env.example` first.
# ─────────────────────────────────────────────────────────────────────────────

# openssl rand -hex 24 — a value of ITS OWN, not the one in `.env`.
SETUP_KEY=

# Leave empty on a fresh checkout; dsh-passwords writes them back on first setup.
MCP_JWT_SECRET=
MCP_INTERNAL_SECRET=
MCP_DB_ENC_KEY=

MCP_DB_PATH=/ABSOLUTE/PATH/TO/TCH/data/platform.db

# 🔒 AUTO_TLS=0 is MANDATORY locally — see `.env.example`.
MCP_GATEWAY_AUTO_TLS=0
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PUBLIC_HOST=127.0.0.1:51731

# 🔒 A port of its OWN — web takes 51711, desktop 51721.  Drop this line and the
# password door falls back to 51711 and collides with profile `web`: the second
# one dies with EADDRINUSE and shuts itself down while its dsh keeps serving, so
# the browser returns 401 and looks perfectly healthy.
MCP_GATEWAY_PORT=51731

# Upstream is THIS profile's own dsh.  Drop this line and the door silently
# points at the default 51710 — profile `web`'s dsh — then dies with 401 while
# exchanging the launch token, and the only symptom is "port 51731 is not
# listening" (measured 2026-08-31).
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:51730

# ── Tracy sign-in door (optional) ───────────────────────────────────────────
# Leave the whole block empty for local work: the lane then keeps its PASSWORD
# door, which is all a dev checkout needs.
#
# Fill it only to point this lane at a real Tracy seat.  The moment
# MCP_SEAT_SECRET is set the password door closes itself (404) — two open doors
# are two sources of truth about "who is who", which is what TCH ADR 0001 exists
# to prevent (docs/adr/0001-seat-door-and-enforcement-boundary.md).
#
# MCP_TRACY_ACTOR_SECRET and MCP_SEAT_SECRET are REAL secrets and are not in this
# repo.  Ask Lee; do not copy a production value onto a dev machine.
MCP_TRACY_ORIGIN=
MCP_TRACY_SITE_KEY=
MCP_TRACY_SITE_LABEL=
MCP_TRACY_ACTOR_SECRET=
MCP_SEAT_SECRET=

# ── Electron shell target (optional) ────────────────────────────────────────
# Set it and the app does NOT spawn a local dsh, does not wait for the password
# gateway and does not read a launch token — all three belong to the lifecycle
# of a dsh the app owns; the sign-in door belongs to the remote origin instead.
# Empty or absent = the app runs dsh locally.
#   TRACY_DESKTOP_ORIGIN=https://cowork.tracy.ai
TRACY_DESKTOP_ORIGIN=
