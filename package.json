{
  "name": "tch",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Tracy Cowork Harness \u2014 Tracy's root repository on dsh 0.2.0-rc.2-tracy.49",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:check": "tsx scripts/check-all.ts",
    "typecheck": "tsc --noEmit -p packages/ui/tracy-ui && tsc --noEmit -p packages/brand/tracy-brand && tsc --noEmit -p packages/ui/tracy-chat-input && tsc --noEmit -p packages/ui/tracy-settings && tsc --noEmit -p packages/ui/tracy-sidebar && tsc --noEmit -p packages/dev/tracy-design && tsc --noEmit -p packages/site/tracy-add-site && tsc --noEmit -p packages/site/tracy-my-sites && tsc --noEmit -p packages/site/tracy-inbox && tsc --noEmit -p packages/site/tracy-site-tabs && tsc --noEmit -p packages/ui/tracy-mode-picker && tsc --noEmit -p packages/core/tracy-core && tsc --noEmit -p packages/web/tracy-harness && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint --fix --disable-nested-config && pnpm typecheck && pnpm format",
    "test:lint": "oxlint --deny-warnings --disable-nested-config && pnpm typecheck && pnpm format:check",
    "format": "biome format --write",
    "format:classes": "biome lint --write",
    "format:check": "biome format && biome lint",
    "test": "tsx scripts/check-tests.ts",
    "docs:check-links": "tsx scripts/check-doc-links.ts",
    "docs:media": "node apps/tracy-docs/scripts/media.mjs",
    "prepare": "node -e \"if(!process.env.CI){try{require('child_process').execSync('prek install',{stdio:'inherit'})}catch{}}\"",
    "dsh:build": "node scripts/build-dsh.mjs",
    "profiles": "node scripts/materialize-profile.mjs",
    "journal": "node scripts/journal.mjs",
    "api:snapshot": "node scripts/build-api-spec.mjs && biome format --write --files-max-size=4194304 apps/tracy-web/api-reference.snapshot.json",
    "dev": "bash dev.sh",
    "test:workers": "node --test --test-timeout=120000 --test-force-exit apps/*/test/*.test.mjs scripts/test/*.test.mjs packages/*/*/test/*.test.mjs",
    "test:interop": "node --import tsx --test scripts/test/*.test.ts",
    "test:clock-shift": "node scripts/run-clock-shift.mjs",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "skills:check": "tsx scripts/skills-check.ts",
    "docs:index": "tsx scripts/gen-doc-index.ts",
    "docs:check-index": "tsx scripts/gen-doc-index.ts --check",
    "docs:check-frontmatter": "tsx scripts/check-doc-frontmatter.ts",
    "bundles:regen": "node scripts/regenerate-bundles.mjs",
    "desktop:preview": "pnpm --filter @tracy/desktop preview",
    "test:ci:joomla-quickstart": "node --import tsx scripts/ci/turbo-setup.mjs --check --task-part owner=packages/cms/tracy-joomla-quickstart",
    "test:ci:wordpress-quickstart": "node --import tsx scripts/ci/turbo-setup.mjs --check --task-part owner=packages/cms/tracy-wordpress-quickstart",
    "test:ci:scripts": "node --import tsx scripts/ci/turbo-setup.mjs --check --task-part owner=scripts",
    "test:ci:interop": "node --import tsx scripts/ci/turbo-setup.mjs --check --task-part interop",
    "test:ci:vendor": "node --import tsx scripts/ci/turbo-setup.mjs --check --task-part vendor"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "acorn": "8.18.0",
    "esbuild": "0.25.12",
    "js-yaml": "^5.4.1",
    "linkedom": "0.18.13",
    "oxlint": "^1.80.0",
    "tsx": "4.22.4",
    "turbo": "2.11.5",
    "typescript": "^5.9.3",
    "undici": "7.29.1",
    "website-opportunities": "workspace:*",
    "ws": "^8.21.3"
  }
}
