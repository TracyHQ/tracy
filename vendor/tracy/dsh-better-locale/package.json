{
  "name": "@huanlin/dsh-plugin-better-locale",
  "version": "0.3.0-tracy.13",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin"
  ],
  "description": "DSH web 插件：通过 DSH v0.1.2-alpha.1 原生第三方语言 API（locale.addLanguage + register(ns, locale, dict)）注册 19 种内置语言字典（ja/ko/fr/...），语言直接出现在 DSH 设置页原生 Language 行中切换，未覆盖文案按 fallback 链回退英文。 | DSH web plugin: registers 19 bundled third-language dictionaries (ja/ko/fr/...) through DSH v0.1.2-alpha.1's native language-pack API (locale.addLanguage + register(ns, locale, dict)); languages become selectable in DSH's own Language settings row, with per-key fallback to English.",
  "type": "module",
  "license": "AGPL-3.0",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "import": "./lib/invariant.js",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/check-upstream-merges.mjs",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts",
    "bundle:client": "tsdown -c tsdown.config.ts",
    "gen:translations": "node scripts/generate-translation-md.mjs",
    "build:types": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2-tracy.26",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2-tracy.26"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
