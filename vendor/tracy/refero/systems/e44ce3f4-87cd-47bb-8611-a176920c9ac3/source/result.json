    "components": [
      {
        "name": "Global Pill Navigation",
        "role": "Top-level page and category navigation",
        "description": "Use Abacaxilatin at 16px / 21.12px, weight 400, in Editorial Ink. Each category item sits in a 999px-radius pill with rgba(186, 186, 186, 0.16) fill; the compact navigation rhythm uses 8px gaps and 10px vertical padding."
      },
      {
        "name": "Text Navigation Link",
        "role": "Secondary header route",
        "description": "Set in Editorial Ink with the 16px Abacaxilatinweb navigation treatment. Use a quiet #f5f5f5 rounded backing only where a route needs active-state containment; keep the route pair separated by 8px."
      },
      {
        "name": "Hero Editorial Heading",
        "role": "Opening statement",
        "description": "Use Gt Alpina Standard at 64px, weight 300, 69.12px line-height, in Editorial Ink. Place the statement in a broad white field with large open space below before the image begins."
      },
      {
        "name": "Blue Environmental Hero Image",
        "role": "Full-width visual break beneath the opening statement",
        "description": "Use a raw-edge, square-cornered photographic or environmental texture treated almost entirely in Climate Blue #4098ff and Paper White #ffffff. Do not place it in a card, add a shadow, or round its corners."
      },
      {
        "name": "Editorial Intro Block",
        "role": "Section lead and explanatory copy",
        "description": "Pair a 20px Abacaxilatinweb eyebrow at 21.6px line-height with 18px Abacaxilatinweb body copy at 27px line-height, both in Editorial Ink. Separate paragraphs by 32px and let the text occupy a deliberately restrained reading column."
      },
      {
        "name": "System Accordion Row",
        "role": "Expandable climate-system category",
        "description": "Use a 1px top divider in Rule Gray #d9d9d9, a 26px Abacaxilatinweb label at 39px line-height, and an Editorial Ink plus icon aligned at the far edge. Keep each row on a white surface with 24px vertical spacing; render its superscript-like count at 18px / 27px."
      },
      {
        "name": "All-Items Text Link",
        "role": "Compact continuation link below an accordion group",
        "description": "Set in Abacaxilatinweb at 14px, weight 500, 27.02px line-height, Editorial Ink, followed by a small right chevron. Do not use a filled container."
      },
      {
        "name": "Cyan Institution Chip",
