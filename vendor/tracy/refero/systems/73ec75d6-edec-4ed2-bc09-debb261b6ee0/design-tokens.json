{
  "color": {
    "paper": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Paper — Page backgrounds, navigation, text-on-dark, and light button surfaces"
    },
    "ink": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Ink — Display headings, navigation, body copy, icons, dark media panels, and hairline graphic details"
    },
    "near-black": {
      "$value": "#111111",
      "$type": "color",
      "$description": "Near Black — Secondary dark text and headings where pure Ink is not used"
    },
    "quiet-graphite": {
      "$value": "#595959",
      "$type": "color",
      "$description": "Quiet Graphite — Supporting body copy, explanatory text, and subdued interface labels"
    },
    "soft-gray": {
      "$value": "#919191",
      "$type": "color",
      "$description": "Soft Gray — Muted metadata, inactive supporting text, and low-emphasis labels"
    },
    "oat-surface": {
      "$value": "#f7f4f1",
      "$type": "color",
      "$description": "Oat Surface — Feature-card surfaces, pale pill buttons, understated separators, and surface outlines"
    },
    "ledger-brown": {
      "$value": "#3b281d",
      "$type": "color",
      "$description": "Ledger Brown — Filled pill buttons and dark navigation controls — the brown-black fill keeps conversion controls tactile rather than corporate-blue"
    },
    "espresso-panel": {
      "$value": "#211006",
      "$type": "color",
      "$description": "Espresso Panel — Dark product-demo surfaces, data-led card backgrounds, and high-contrast visual blocks"
    },
    "copper-link": {
      "$value": "#e07122",
      "$type": "color",
      "$description": "Copper Link — Inline product-card links and compact interface highlights — a warm cue that reads as commerce material rather than a universal brand wash"
    },
    "terracotta-disc": {
      "$value": "#d66733",
      "$type": "color",
      "$description": "Terracotta Disc — Large circular decorative card accents and isolated graphic moments"
    },
    "active-green": {
      "$value": "#1e681d",
      "$type": "color",
      "$description": "Active Green — Green text accent for links, tags, and emphasized short phrases. Use as a supporting accent, not as a status color"
    },
    "active-green-surface": {
      "$value": "#288a26",
      "$type": "color",
      "$description": "Active Green Surface — Green text accent for links, tags, and emphasized short phrases. Use as a supporting accent, not as a status color"
    },
    "pending-ochre": {
      "$value": "#8b6900",
      "$type": "color",
      "$description": "Pending Ochre — Yellow text accent for links, tags, and emphasized short phrases. Use as a supporting accent, not as a status color"
    },
    "expiry-red": {
      "$value": "#99001c",
      "$type": "color",
