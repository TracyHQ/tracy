      {
        "name": "Photographic Display Hero",
        "role": "Opening full-bleed editorial statement.",
        "description": "Fill the hero with muted, dark documentary photography; place the content in the left portion of the image and let the subject occupy the opposing side. Set the display headline in Geist 400 at 120px, 111.6px line-height, -8px tracking, and #f7f5f1; use #fffdf6 for the compact supporting copy."
      },
      {
        "name": "App Download Badge",
