    "components": [
      {
        "name": "Transparent Top Navigation",
        "role": "Persistent public navigation over both light sections and dark hero media.",
        "description": "Use a 65px-tall horizontal bar with a 1px solid #e6e3dd bottom divider on light sections; over dark hero media, use a low-contrast light divider. Render the B150 wordmark at the far left and Fragment Mono navigation at 10px/400, 15px line-height, +0.3px tracking, uppercase."
      },
      {
        "name": "Light Pill Navigation Button",
        "role": "Public conversion control in the header and light sections.",
        "description": "Use #ffffff or #fffdf6 fill, #1f1915 text, a 1px solid #e6e3dd border, 1440px radius, and 12px vertical padding with 16px or 20px horizontal padding."
      },
      {
        "name": "Dark Hero Glass Pill",
        "role": "Conversion control placed directly over dark photography.",
        "description": "Use rgba(255,253,246,0.16) fill with a 1px solid rgba(255,253,246,0.32) border, #fffdf6 label text, 1440px radius, and 12px 20px padding."
