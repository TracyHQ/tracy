{
  "color": {
    "drawing-ink": {
      "$value": "#0a1217",
      "$type": "color",
      "$description": "Drawing Ink — Primary text, dark product panels, dark feature sections, icons, and structural strokes"
    },
    "paper": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Paper — Page canvas, card surfaces, light product panels, and reversed text"
    },
    "drafting-gray": {
      "$value": "#f1f1f1",
      "$type": "color",
      "$description": "Drafting Gray — Muted card surfaces, logo tiles, product-widget backgrounds, and secondary action surfaces"
    },
    "hairline": {
      "$value": "#e6e7e8",
      "$type": "color",
