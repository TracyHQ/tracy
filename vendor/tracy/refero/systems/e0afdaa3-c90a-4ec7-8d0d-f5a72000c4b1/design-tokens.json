      "$value": "#85898b",
      "$type": "color",
      "$description": "Stone — Muted helper text, secondary metadata, and low-emphasis interface marks"
    },
    "graphite": {
      "$value": "#54595d",
      "$type": "color",
      "$description": "Graphite — Supporting body copy on light surfaces"
    },
    "archive-black": {
      "$value": "#000000",
      "$type": "color",
