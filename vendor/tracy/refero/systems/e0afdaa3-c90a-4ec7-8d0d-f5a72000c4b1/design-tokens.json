    },
    "complete-status": {
      "$value": "#1a7f55",
      "$type": "color",
      "$description": "Complete Status — Green wash for highlight backgrounds, decorative bands, and soft emphasis behind content. Use as a supporting accent, not as a status color"
    },
    "plan-blue": {
      "$value": "#24476b",
      "$type": "color",
      "$description": "Plan Blue — Blue wash for highlight backgrounds, decorative bands, and soft emphasis behind content"
    }
