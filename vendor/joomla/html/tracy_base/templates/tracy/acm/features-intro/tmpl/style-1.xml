      <field
        name="card-link-text"
        type="text"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_LINK_TEXT_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_LINK_TEXT_DESC"
