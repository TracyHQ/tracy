<?xml version="1.0" encoding="utf-8"?>
<form>
  <title>Features Intro Style 1</title>
  <fields name="features-intro">
    <fieldset name="head" label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_HEAD_LABEL">
      <field
        name="eyebrow"
        type="text"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_EYEBROW_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_EYEBROW_DESC"
      />
      <field
        name="title"
        type="text"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_TITLE_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_TITLE_DESC"
      />
      <field
