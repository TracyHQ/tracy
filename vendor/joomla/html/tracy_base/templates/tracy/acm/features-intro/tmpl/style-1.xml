      <field
        name="card-icon-alt"
        type="text"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_ICON_ALT_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_ICON_ALT_DESC"
      />
      <field
        name="card-title"
        type="text"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_TITLE_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_TITLE_DESC"
