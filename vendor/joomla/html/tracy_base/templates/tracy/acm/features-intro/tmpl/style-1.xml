    <fieldset name="cards" label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARDS_LABEL" multiple="1">
      <field
        name="card-icon"
        type="media"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_ICON_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_ICON_DESC"
