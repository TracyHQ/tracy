        type="textarea"
        rows="3"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_LEAD_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_LEAD_DESC"
      />
      <field
        name="spotlight-label"
        type="text"
        default=""
