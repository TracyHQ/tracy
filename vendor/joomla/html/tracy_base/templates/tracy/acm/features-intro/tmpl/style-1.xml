      <field
        name="card-text"
        type="textarea"
        rows="4"
        default=""
        label="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_TEXT_LABEL"
        description="TPL_TRACY_BASE_ACM_FEATURES_INTRO_CARD_TEXT_DESC"
