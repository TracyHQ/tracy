# ─────────────────────────────────────────────────────────────────────────────
# TCH — profile `desktop` (./run.sh desktop).  Copy to `.env.desktop`.
# Same shape as `.env.example`; only the two ports differ.  Read the header of
# `.env.example` first — it explains why each profile owns its own file.
# ─────────────────────────────────────────────────────────────────────────────

# openssl rand -hex 24 — a value of ITS OWN, not the one in `.env`.
SETUP_KEY=

# Leave empty on a fresh checkout; dsh-passwords writes them back on first setup.
MCP_JWT_SECRET=
MCP_INTERNAL_SECRET=
MCP_DB_ENC_KEY=

MCP_DB_PATH=/ABSOLUTE/PATH/TO/TCH/data/platform.db

# 🔒 AUTO_TLS=0 is MANDATORY locally — see `.env.example`.
MCP_GATEWAY_AUTO_TLS=0
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PORT=51721
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:51720
MCP_GATEWAY_PUBLIC_HOST=127.0.0.1:51721
