# Copy to .env, generate the secrets, fix the three absolute paths — done. Every other value in this
# file is a VALUE THAT RUNS LOCALLY, not a placeholder: this is the dev machine's file, and the
# server value sits in the `server:` comment beside it. Empty means off. Never commit .env.
#
# Full guide: docs/references/running-tracy-locally.md
#
# ⚠ An EMPTY value must never share its line with a `#` comment: Compose's `env_file` (unlike the
# shell's `source`) keeps everything after `=` when the value is empty, so `KEY=   # comment` puts
# the literal string "# comment" into the container, not an empty value. That is why the comment
# of an empty line sits on the line ABOVE it — not for symmetry.

# ── Addresses ───────────────────────────────────────────────────────────────────────────────────
TRACY_ORIGIN=http://tracy.test:51710        # server: https://cowork.tracy.ai
SITE_DOMAIN=tracy.test                     # server: tracy.ai — sites at <label>.tracy.test:51710 (local) / <label>.tracy.ai
SITE_DOMAIN_ALIASES=localhost              # EXTRA suffix the browser can still reach; server: empty
# server: .tracy.ai — empty = host-only cookie. The visible consequence locally: a page on
# <label>.localhost does NOT see the localhost:51710 session, so /wp-admin has no seat → going to /login is RIGHT.
SESSION_DOMAIN=tracy.test
# Public API host (`/v1`, docs, `/health`). Local `http://api.tracy.test:51710` (compose's two
# dnsmasq answer every `*.tracy.test`, nothing to add); dev `https://api.tracy.site`; server
# `https://api.tracy.ai`. Cloudflare's Universal SSL covers only ONE level under the zone, so
# `api.<zone>` fits. Must be a URL with a scheme and a hostname DIFFERENT from TRACY_ORIGIN's.
# Empty = no API host: every hostname behaves as before.
API_ORIGIN=
# Optional. The address the public Templates pages (/templates/*, /sitemap.xml, /llms.txt) state for
# themselves: canonical, og:url, JSON-LD, sitemap and llms.txt addresses. Empty = https://tracy.ai on
# the production deployment (TRACY_ORIGIN=https://cowork.tracy.ai), whose Cloudflare Worker serves
# /templates* there; TRACY_ORIGIN everywhere else. When it differs from TRACY_ORIGIN, a direct request
# for /templates* answers 301 to this origin, except the Worker's own (header CF-Worker: <its host>).
# Must be a bare origin (scheme and host). Build links, Get Started, pictures and the demo probe always
# stay on TRACY_ORIGIN. Search engines may index the pages only on the production deployment and only
# when this resolves to https://cowork.tracy.ai or https://tracy.ai.
TEMPLATES_PUBLIC_ORIGIN=
# Optional MCP origin. Defaults to TRACY_ORIGIN (https://cowork.tracy.ai in production).
# Empty uses TRACY_ORIGIN. Application pages keep their normal session authentication.
MCP_ORIGIN=
# Public domain verification token supplied by the OpenAI Portal; empty serves no proof.
MCP_OPENAI_CHALLENGE=
# Documentation host (apps/tracy-docs, served at the ROOT of its own hostname). REQUIRED: the image
# carries the docs site, and tracy-web refuses to start without this. The default is the local one,
# on TRACY_ORIGIN's port (compose's dnsmasq answers every `*.tracy.test`); dev
# `https://docs.tracy.site`; server `https://docs.tracy.ai`. Must be a URL with a scheme and a
# hostname different from TRACY_ORIGIN, API_ORIGIN and UPDATE_ORIGIN. Tracy's own hostname and the
# API host send `/docs/*` here with a 302.
DOCS_ORIGIN=http://docs.tracy.test:51710
# GitHub org that owns every site's repo. Empty = config.js's default (TracyHQ) — the same org in
# every environment, so normally left alone.
HOST_ORG=
# Badge script a published site embeds. Empty = config.js's default: `${TRACY_ORIGIN}/badge.js`
# (served by tracy-web itself, off by default). The retired Worker script `https://tracy.ai/dashboard/badge.js`
# is IGNORED with a warning line (ADR 0019) — don't put it back.
BADGE_URL=

# ── Secrets — GENERATE them, don't make them up: openssl rand -hex 32 (a DIFFERENT value per key) ─
SESSION_SECRET=
# dsh-passwords' /gateway/tracy door (desktop/loopback)
MCP_TRACY_ACTOR_SECRET=
# Hashes seat keys (`Authorization: Bearer trk_…`, table api_key). Empty = keys feature off:
# /api/me/keys answers 503 API_KEYS_NOT_CONFIGURED. ⚠ CHANGING this value voids EVERY issued key at once.
API_KEY_PEPPER=
# tracy-web → tracy-host
HOST_local_SECRET=
# tracy-web → dsh's seat door (= MCP_SEAT_SECRET of that same dsh)
SEAT_local_SECRET=

# ── Host ────────────────────────────────────────────────────────────────────────────────────────
HOST_NAME=local                            # name of THIS host (compose derives DSH_TRUSTED_HOSTS from it)
HOSTS=local                                # server: e.g. prod1,prod2 — each name needs its full four lines
# The host public quickstart demos are installed on (`/ops/cms/demos`): one of `HOSTS`, by name.
# Empty means "the host called demo if there is one, else none" — a server without one lists demos
# read-only and says why. Never the same host customers' sites go to, unless you mean that.
DEMO_HOST=
# Every host a demo MAY go on, when there is more than one: `name=What the screen shows`, comma
# separated, each one of `HOSTS`. The Demos and Quickstarts screens then offer a server per row
# (since 22/09/2026). The first is the default unless DEMO_HOST names another. A host listed here that
# is not the first of HOSTS may leave out its HOST_<name>_DSH_ORIGIN and SEAT_<name>_SECRET (both
# or neither): a host that only carries demos runs no dsh. Empty = DEMO_HOST alone, as before.
# dev: DEMO_HOSTS=dev=<demo-host>
DEMO_HOSTS=
# What the Demos screen SHOWS about the machine behind DEMO_HOST. Two independent demo servers
# means an address alone does not say which one a press lands on — these two are drawn on the
# picker, the row and the Install button so the reader cannot mistake them. Display only.
DEMO_SERVER_NAME=
DEMO_SERVER_IP=
# JoomlArt's own demo domain, when this deployment records those addresses. Setting the zone is
# what makes the second target appear at all; a deployment that does not know that machine draws
# no column for it. Tracy RECORDS these addresses and never installs onto that server.
DEMO_JOOMLART_ZONE=
DEMO_JOOMLART_SERVER_NAME=
DEMO_JOOMLART_SERVER_IP=
# How this deployment ASKS that server what it really serves. All four or none. The key named here
# is a forced-command key: its authorized_keys line runs one script and opens no shell, which is
# what makes holding a credential for somebody else's production server acceptable at all.
DEMO_JOOMLART_SSH_HOST=
DEMO_JOOMLART_SSH_PORT=
DEMO_JOOMLART_SSH_USER=
DEMO_JOOMLART_SSH_KEY=
# 🔒 THE SERVICE NAME, NOT host.docker.internal — and getting this wrong costs a whole afternoon. On
# Docker Desktop/macOS, `network_mode: host` puts the container in the host namespace of the LINUX VM,
# not macOS: tracy-host listening on 51720 is reachable only from another host-network container,
# NOT from macOS and NOT from tracy-web (on the bridge). `host.docker.internal` points at the macOS
# machine — the one place the listener is NOT. Symptom when wrong: site creation returns
# 502 FLEET_REFUSED while all seven services report healthy (each healthcheck probes only ITS OWN
# port). Use together with deploy/compose.macos.yml.
# server: http://host.docker.internal:51720 (same machine) or https://<host>-agent.<zone>/_host
HOST_local_ORIGIN=http://tracy-host:51720
HOST_local_DSH_ORIGIN=http://tracy-dsh:8080

# ── Three disk roots — MUST BE ABSOLUTE, and must exist ──────────────────────────────────────────
# mkdir -p ~/tracy-data/{sites,private,dsh-home}
#
# 🔒 A relative path makes docker refuse when STARTING the container, not when parsing compose —
# `compose config` is green and `up` dies. The first two roots are bound on BOTH SIDES
# (`${TRACY_SITES_ROOT}:${TRACY_SITES_ROOT}` for tracy-host, `:/site` for dsh — ADR 0014: "the path
# the agent sees does not change"), so a relative value resolves on the host side but sends a
# relative TARGET into the container.
TRACY_SITES_ROOT=/ABSOLUTE/PATH/tracy-data/sites     # server: /srv/tracy-sites
TRACY_PRIVATE_ROOT=/ABSOLUTE/PATH/tracy-data/private # server: /srv/tracy-private
# Must also be SEEDED once, or tracy-dsh restart-loops AFTER `up -d` has returned 0:
#   docker run --rm --entrypoint sh tracy/dsh:dev -c 'tar -C /desk-home -cf - profiles' \
#     | docker run -i --rm -v "$HOME/tracy-data/dsh-home":/out alpine tar -C /out -xf -
TRACY_DSH_HOME=/ABSOLUTE/PATH/tracy-data/dsh-home    # server: HOST_DSH_HOME of host-dsh.yml

# ── Local stack ─────────────────────────────────────────────────────────────────────────────────
# Required, no default (compose refuses to start without it): `openssl rand -hex 16`. Postgres reads it
# only when its volume is first created, so a stand that already has a volume keeps the password it was
# created with — `tracy` for every stand made before 26/10/2026. Use the same value in the two URLs below.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tracy:<POSTGRES_PASSWORD>@postgres:5432/tracy
POSTGRES_PORT=51730
TEST_DATABASE_URL=postgres://tracy:<POSTGRES_PASSWORD>@127.0.0.1:51730/tracy
# ── Tracy's port range — 517xx, and it does NOT overlap the pool handed to sites ────────────────
#
# 🔒 BEFORE 11/09 THE CONTROL PLANE'S PORT SAT INSIDE THE POOL IT HANDS OUT TO SITES. `provision.sh`
# gave new sites ports in 8081-8999, and `tracy-host` listened on 8090 — so a new site could be
# handed the very door tracy-host answers on. A laptop never shows it (empty pool); on production
# 8090 was already taken at first look (by a customer site's container), and `tracy-host`
# with `network_mode: host` would die on EADDRINUSE before its first health probe.
#
# Two changes, and BOTH are needed: the pool moved to 52000-52999, and 517xx is NAMED in `provision.sh`
# to be refused outright. Moving the pool alone gives two ranges that merely happen not to touch —
# change a number in either place and they touch again, silently.
#
# And the ports are UNUSUAL on purpose. 8080/8090/9000/5433 are the most contested ports on a Linux
# machine; any machine running anything besides Tracy eventually collides, and the symptom is a
# container that won't start with an error about an address, not about Tracy.
#
#   51700 tracy-dsh · 51710 tracy-web · 51720 tracy-host · 51730 postgres · 51740 minio
WEB_PORT=51710                             # host port of the tracy-web container
TRACY_HOST_PORT=51720                      # port tracy-host listens on IN the HOST's network namespace
DSH_IMAGE_TAG=dev                          # local: docker build -f packages/fleet/tracy-fleet-operation/dsh/Dockerfile -t tracy/dsh:dev . (HOST-DSH.md §1)
# Static address of the dnsmasq service — how tracy-dsh and a site's containers resolve
# `<label>.tracy.test`. The browser does not need it; it uses `<label>.localhost` (`.localhost`
# is pointed straight at loopback by the OS/browser, no DNS server involved). Empty on a server.
# IP range of the `tracy` network — the FIRST THREE octets, no trailing dot.
#
# 🔒 A REAL FLEET HOST RUNS OUT OF ADDRESS RANGES. Docker gives every compose project a /16 out of
# 172.16/12, and a fleet host has one project per site. Measured on a production host (11/09, 14 sites):
# 172.17 to 172.31 ALL TAKEN, the 192.168 /20 blocks filling up, and 172.30.0.0/16 in particular belonged to
# a customer's site — so `up` died on `invalid pool request: Pool overlaps with other one on this
# address space` before it could start a single container.
# On a server pick a prefix inside 10.0.0.0/8 that nothing else on the machine uses.
TRACY_NETWORK_PREFIX=172.30.0
TRACY_SITE_DNS=172.30.0.53

# 🔒 Egress fence (iptables chain `TRACY-FLEET-EGRESS`). A laptop has no iptables, so provision.sh
# stops at the fencing step — AFTER the site's two containers are already up. `off` lets local run.
#
# ⚠ ON THE FLEET IT MUST GO BACK TO `on`. An unfenced site LOOKS EXACTLY like a fenced one, so this
# is the only thing in this file whose local value is wrong on a server silently. That is why
# provision.sh prints a warning on EVERY site build when it sees `off`, instead of trusting this file.
TRACY_EGRESS_FENCE=off

# ── Resource caps — what one site, and this host's dsh, may take from the machine ──────────────
# Every agent command runs inside the site's own web container (bash, node, the browser behind
# page.look, EmDash's astro build), so these caps are what keeps one site's heavy command off every
# other site on the host. ONE value per host, never per site. Empty = the default, measured on the
# stand 28/09/2026. provision.sh writes the site caps into every new site's compose file
# (render-compose.sh `tracy_site_limits`, which refuses a value it cannot use); a site already
# running gets them from `provision/apply-site-limits.sh --apply` (docker update, no recreate).
# Memory is whole megabytes or gigabytes (`1536m`, `2g`), swap held to the same number. Cores are a
# positive number, held to the machine's own count. Processes count threads too.
#
# Web container of a Joomla/WordPress site (default 2g), of an EmDash site (default 3g: astro build
# runs beside the server and took 1.9 GiB under a 3g cap), and MariaDB (default 1g).
TRACY_SITE_MEMORY=
TRACY_SITE_MEMORY_EMDASH=
TRACY_SITE_DB_MEMORY=
# Cores per site container (default 2, or 1 on a machine with fewer than 4), processes (default 1024).
TRACY_SITE_CPUS=
TRACY_SITE_PIDS=
# The one tracy-dsh: memory (default 4g), cores (default 2 — never more than the machine has, or dsh
# does not start), processes (default 4096). On a fleet host these go in /etc/tracy/host-dsh.env,
# where host-dsh.yml reads them; here deploy/compose.yml does.
TRACY_DSH_MEMORY=
TRACY_DSH_CPUS=
TRACY_DSH_PIDS=

# ── Artifact store (MinIO locally, R2 on a server) ──────────────────────────────────────────────
# One value for BOTH signing and downloading: SigV4 signs the `host` in the URL, so tracy-web, dsh and
# the site's containers must see the SAME endpoint, or a URL signed in one place breaks when called from another.
# `minio:9000` resolves only for tracy-web; `host.docker.internal` is the one address from which all three
# reach the host's MinIO port.
MINIO_PORT=51740                           # change if something already holds 51740 — and change the line below too
ARTIFACT_S3_ENDPOINT=http://host.docker.internal:51740  # server: the R2 endpoint
ARTIFACT_S3_BUCKET=tracy-artifacts
ARTIFACT_S3_ACCESS_KEY=tracy
# Required, no default (compose interpolates the local-only MinIO services on servers too, so a server
# sets it to any value): `openssl rand -hex 16`. MinIO reads it when its volume is first created — stands
# made before 26/10/2026 keep `tracy-tracy`.
MINIO_PASSWORD=
# local: the same value as MINIO_PASSWORD (user `tracy`) · server: the R2 secret
ARTIFACT_S3_SECRET_KEY=
# Optional. Only when this machine imports a site that runs ELSEWHERE (a local stand pulling a
# live WordPress site): the source PUTs its webroot parts to the store itself, and cannot reach
# `host.docker.internal`. Put an address the source CAN reach that forwards to MinIO (a tunnel to
# port MINIO_PORT that keeps the Host header — SigV4 signs it). Only webroot-part URLs are signed
# with it; everything else keeps ARTIFACT_S3_ENDPOINT. Leave empty on servers: R2 is public already.
ARTIFACT_S3_PUBLIC_ENDPOINT=

# Desktop app update feed (tasks/todo-desktop-auto-update.md). UPDATE_ORIGIN is the host the app's
# electron-updater asks: https://update.tracy.ai in production; empty = this deployment serves no feed.
# The feed streams read-only from RELEASES_S3_BUCKET (minio-init creates `tracy-releases` locally);
# the three RELEASES_S3_* below fall back to the ARTIFACT_S3_* values when empty. Only
# packages/desktop/tracy-desktop/build/release.sh writes to the bucket, with its own key.
UPDATE_ORIGIN=
RELEASES_S3_BUCKET=tracy-releases
RELEASES_S3_ENDPOINT=
RELEASES_S3_ACCESS_KEY=
RELEASES_S3_SECRET_KEY=

# Website Opportunities place pictures shared by every deployment (tasks/plan-wo-shared-places.md):
# the R2 bucket `tracy-google-place-media`, keys `media/google|other/<sha[0:2]>/<sha>.<ext>`. All four
# or none; NO fallback to ARTIFACT_S3_*. Empty = place pictures stay in the artifact store (`places/`).
# One shared token for every deployment; its values live in the operators' secret store, never in git.
PLACE_MEDIA_S3_ENDPOINT=
PLACE_MEDIA_S3_BUCKET=
PLACE_MEDIA_S3_ACCESS_KEY=
PLACE_MEDIA_S3_SECRET_KEY=
# The secret another deployment sends to POST /api/internal/wo-places/v1/ingest (header
# x-tracy-wo-places-secret), 32-256 of A-Z a-z 0-9 _ -. Empty = the door answers 404. Master only.
WO_PLACES_INGEST_SECRET=

# The Tracy Desktop download page the web template landing offers beside the quickstart download.
# Empty = https://tracy.ai/download/.
DESKTOP_DOWNLOAD_URL=

# The four keys below are a FALLBACK, no longer required (since 14/09). The import path now downloads
# the copy through GET URLs that tracy-web SIGNS: `POST /api/sites/:key/provision` sends `webrootUrl`/`dbUrl`,
# tracy-host puts them into env `TRACY_ARCHIVE_*_URL`, and `provision.sh` downloads with curl. Why: the
# tracy-host image has no `aws` CLI, so the `aws s3 cp` path with these four keys died at "fetching webroot"
# even with every key set — measured 14/09 locally, and that image is the same on every host. So the
# store keys live only in tracy-web.
#
# `provision.sh` still reads these four names when there is NO signed URL (someone running the script
# by hand on a machine with `aws`). Values are IDENTICAL to the four `ARTIFACT_S3_*` lines above, same store.
TRACY_MIGRATE_S3_ENDPOINT=http://host.docker.internal:51740
TRACY_MIGRATE_S3_BUCKET=tracy-artifacts
TRACY_MIGRATE_S3_ACCESS_KEY=tracy
TRACY_MIGRATE_S3_SECRET_KEY=tracy-tracy

# ── Off by default locally — none of these crashes the app, each answers with a code ─────────────
# Mail transport. `console` = sign-in codes go to the server LOG, no mail is sent. server: resend:re_xxx
# (and with resend, MAIL_FROM is REQUIRED — see below).
MAIL=console

# Sign in with Google / GitHub. Empty = the button is hidden, OTP still works — none is required.
#
# 🔒 THE VARIABLE NAMES ARE `*_OAUTH_CLIENT_*`, NOT `OAUTH_*`. This file once declared `OAUTH_GOOGLE_ID`
# and its three siblings — the old Worker's names — while `apps/tracy-web/src/config.js` reads the four
# names below. Filling in the old names makes `readOAuth` return `null`, the button disappears, and there
# is NO error anywhere: it looks exactly like a configuration left empty on purpose. Fixed 10/09 together
# with seven other keys with the same disease.
#
# The callbacks must be registered at the provider: `<TRACY_ORIGIN>/signin/google/callback` and
# `<TRACY_ORIGIN>/signin/github/callback`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Sign in with a JoomlArt account (signed redirect to aMember's `joomlartsso` module and back).
# Both empty = the door is off (`/signin/joomlart` answers 404). ONE set without the other is a
# ConfigError at boot, on purpose: the secret is shared with aMember's admin (`secret_tracy` on
# production, `secret_tracy_dev` elsewhere) and the two ends are set in one action.
# The `client` id is not configured: `https://cowork.tracy.ai` names itself `tracy`, every other
# origin `tracy-dev`, because aMember binds each client to one fixed return address
# (`<TRACY_ORIGIN>/signin/joomlart/callback`).
JOOMLART_SSO_URL=
JOOMLART_SSO_SECRET=
# Which client this deployment is at aMember: `tracy` on production, `tracy-dev` anywhere else.
# Each has its own secret and its own fixed callback there; required when the two above are set.
JOOMLART_SSO_CLIENT=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT=
# empty = no DNS, and go-live answers 501 NOT_CONFIGURED
CLOUDFLARE_TUNNEL=
# Customers' own domains through Cloudflare for SaaS (tracy-web, #1037): the zone id of SITE_DOMAIN
# (Cloudflare for SaaS enabled, with a fallback origin and a proxied `connect` CNAME) and an API token
# for THAT zone only, permission SSL and Certificates: Edit — its own token, never the tunnel's
# CLOUDFLARE_TOKEN. Both are needed; empty, or only one = Connect domain answers "not available on this
# server" (`OWN_DOMAIN_UNAVAILABLE`, the server still starts, the release checklist names the missing
# variable), and names connected earlier keep working. How to set up the zone:
# docs/references/custom-domains-cloudflare-saas.md.
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_TOKEN=
# Local stand only: a fake Cloudflare API address (`http://127.0.0.1:<port>/client/v4`). Empty = the real
# Cloudflare API — what every server needs. Production refuses to start with it set.
CLOUDFLARE_SAAS_API=
# Two names in the SITE_DOMAIN zone that serve own domains: the CNAME target customers point at
# (`<CONNECT_LABEL>.<zone>`, default `connect`) and the fallback origin = the tunnel's public hostname
# (`<ORIGIN_LABEL>.<zone>`, default `origin`; the dev machine uses `origin-dev`). Both are forbidden as
# site labels (the full label, SITE_ADDRESS_PREFIX included), whether or not Cloudflare for SaaS is on.
# A changed value must match exactly the name created on the Cloudflare dashboard.
CLOUDFLARE_SAAS_CONNECT_LABEL=
CLOUDFLARE_SAAS_ORIGIN_LABEL=
# ── Shard beta, master side (docs/sre/2026-10-15-shard-beta-design.md) ────────────────────────────
# Which side this process is: `master` (the default, every server before shards) or `shard`.
TRACY_DEPLOYMENT_ROLE=
# Seed of the `shard` table, master only: `s1,s2`. Each name needs SHARD_<name>_ORIGIN,
# SHARD_<name>_SECRET (64 hex, `openssl rand -hex 32`, the same value as SHARD_SECRET on that shard)
# and SHARD_<name>_TUNNEL_ID (the shard's Cloudflare tunnel uuid); optional _PROVIDER,
# _REGION (asia|america|europe|unknown, default unknown) and _MAX_SITES (default 200). Every boot
# writes origin, secret, tunnel, provider and region over the row (env wins); whether it takes
# people, its limit, pins and target tags are /ops › Shards' alone. A shard can also be added at
# /ops › Shards › Add without a deploy. Never add a shard to HOSTS.
SHARDS=
# The DNS token only a master holds: the zone id of SITE_DOMAIN and an API token with
# Zone › DNS › Edit on that zone alone. Both or neither; empty = site events record `pending` and
# the hourly reconcile writes them once the token is set.
CLOUDFLARE_DNS_ZONE_ID=
CLOUDFLARE_DNS_TOKEN=
# Who is moved onto a shard at sign-up: `*` for everyone, or a comma list of addresses and domains.
# Empty = nobody (the default, for a shared dev master). Somebody already on a shard always goes back.
SHARD_ADOPT_ALLOW=
# ── Shard beta, shard side (docs/sre/hop-dong-cua-shard.md §9) ───────────────────────────────────
# Read only with TRACY_DEPLOYMENT_ROLE=shard (above); the three keys below are then required
# (SHARD_MAX_SITES optional) and are refused on the master. Server values come from the shard
# installer (W4), never from this file. A shard sets DOCS_ORIGIN to the master's docs host.
# shard: the master's origin, e.g. https://cowork.tracy.ai (dev: https://cowork.tracy.site)
MASTER_ORIGIN=
# shard: HMAC secret of the shard <-> master channel, `openssl rand -hex 32`, generated on the VM
SHARD_SECRET=
# shard: tracy_sess_<HOST_NAME>; the shard still READS tracy_sess (the dsh plugins send that name)
SESSION_COOKIE_NAME=
# shard: optional cap of sites on this shard; empty = no local cap (the master keeps max_sites)
SHARD_MAX_SITES=
# tracy-host on a shard: `catch-all` = the tunnel sends every name to nginx/tracy-web; go-live and
# teardown then write and remove no tunnel rule. Empty on every other host.
TRACY_TUNNEL=
# Model key, reaching `tracy-dsh` as `DEEPSEEK_API_KEY` (compose.yml). Empty: chat sends but gets no
# answer — the agent turn dies with `MISSING_CREDENTIAL: llm-deepseek: no API key for
# provider route "deepseek-official"` — and the brand half of /design-inspiration answers 503.
# Production keeps this key in dsh's credentials service (written by the Models page), not in
# env; locally put it straight here so `up -d` just works, without remembering to open a settings page.
#
# 🔒 LEAVE EMPTY IF YOU WANT TO CHANGE KEYS FROM `/ops` — and not knowing this can cost a whole
# afternoon. Since 22/09 the `/ops` → Model & AI screen keeps keys in Postgres and the *Send keys to the
# fleet* button writes them into the `refs:` block of `/desk-home/.credentials.yaml` in `tracy-dsh`. dsh
# rereads keys on EVERY call and watches that file, so a new key takes effect on the next agent turn,
# no restart.
#
# BUT inherited env WINS over the file and is read-only (`credentials-local`): while a value is set here
# the file is shadowed and every key change from `/ops` changes nothing — silently, no error anywhere.
# Measured 22/09.
#
# ⚠ SWITCH-OVER ORDER, reversed and the agent loses its key: save the key on `/ops` → press *Send keys
# to the fleet* → confirm with `docker exec tracy-dsh grep refs /desk-home/.credentials.yaml` → ONLY THEN
# empty the lines below and `docker compose up -d tracy-dsh`.
MODEL_API_KEY=

# The vision model that labels Website Opportunities photographs (`apps/tracy-web/src/lib/picture-vision.js`).
# Empty: tracy-web uses `MODEL_API_KEY` above (DeepSeek; `deepseek-chat` takes pictures). Both empty: photographs are
# placed from their words alone. OpenRouter: its key + `TRACY_VISION_URL=https://openrouter.ai/api/v1/chat/completions`
# + `TRACY_VISION_MODEL`.
# TRACY_VISION_API_KEY=
# TRACY_VISION_MODEL=deepseek-chat
# TRACY_VISION_MAX_PICTURES=80

# Voice input in the chat box (the microphone beside Send): the ElevenLabs key is typed on
# /ops › Agents › Voice and saved sealed in Postgres (`apps/tracy-web/src/lib/speech.js`); this
# variable is only the FALLBACK used while no key is saved there. Held by `tracy-web` only — the
# browser streams its microphone to `/api/speech/stream` and never sees a key. The key needs the
# Speech to Text permission (/ops › Voice › Test says so); Text to Speech is needed only by
# `apps/tracy-web/scripts/speech-check.mjs`. Empty and nothing saved on /ops: no microphone.
SPEECH_TO_TEXT_API_KEY=
# How many voice sessions `tracy-web` keeps open at once with each speech service (default 4). One
# more is refused at once as "the speech service is busy" instead of failing mid-phrase. Raise it with
# the concurrency the key's plan allows.
SPEECH_STT_MAX_CONCURRENT=4

# Joomla quickstarts/templates from private JoomlArt-Products/joomlart-products releases.
# Fine-grained token: Contents read on that repository only; consumed by host and dsh. tracy-web
# uses it when there is no GitHub App, or when the App is not installed on that repository (a shard).
# Never enter this in a customer chat or copy it into the provisioned site's configuration.
TRACY_RELEASES_GITHUB_TOKEN=

# Read-only CI dashboard for the source repository (TRACY_SOURCE_REPO). Use a token with access to it
# (Pull requests, Contents, Checks and Actions: read). Kept on tracy-web only.
# Optional Administration read permission lets Ops show runner online/offline/busy;
# without it, job assignments remain visible but current runner availability is unknown.
TRACY_CI_GITHUB_TOKEN=
# The GitHub repository this code lives in, read by the /ops CI dashboard: TracyHQ/tch until the
# move to the public repo, then TracyHQ/tracy (the only two accepted). Empty means TracyHQ/tch.
# Cutover checklist: docs/references/public-repo-ci.md.
TRACY_SOURCE_REPO=

# LOCAL STAND ONLY: a folder of quickstart packs not published yet, one per <slug>/<cms>/ (the files
# a release would carry: tracy_setting.json, optional tracy_design_inspiration.json and
# tracy_site_question.json, the card's pictures, the files the setting installs). Each shows on
# Design inspiration as its own "(local)" card, tag local/<slug>/<cms>. Absolute path; mounted
# read-only at the same path into tracy-web and tracy-host by compose.macos.yml. Both apps refuse
# to boot with it set on a server. Docs: docs/references/running-tracy-locally.md §7.5.
TRACY_LOCAL_RELEASES_DIR=

# LOCAL STAND ONLY, needs TRACY_LOCAL_RELEASES_DIR: review mode for unpublished packs (apps/tracy-web/
# src/lib/local-review.js). 1 = the gallery offers the "(local)" cards only, the design system lock is
# open, and a local pack's Add site preview reads the newest site built from it (a pack has no demo).
TRACY_LOCAL_REVIEW=

# Scratch folder for the Customize your site check (ADR 0029): a release's files are downloaded
# here while it is checked, then deleted. Empty = the system's temporary folder.
TRACY_READINESS_DIR=

# One repo per site (ADR 0025 "door 1"): an App installed on TRACY'S org creates a private repo and
# issues short-lived tickets for git. All four empty = new sites get no repo, the job returns
# `repoError: NOT_CONFIGURED` — normal locally, not an error.
#
# 🔒 FOUR KEYS, AND ALL FOUR ARE NEEDED. `readGithub` returns `null` if any is missing, so three-of-four
# is silently the same as zero-of-four. The old names in this file (`GITHUB_HOST_APP_ID`,
# `GITHUB_HOST_APP_PRIVATE_KEY_FILE`) were the Worker's names and are NOT read here.
#
# ⚠ This App is NOT the App customers install themselves (door 2). Permissions belong to the App,
# so `administration: write` — needed to CREATE repos — on the customer App would show up on every
# customer's consent screen. Two Apps, on purpose.
GITHUB_APP_ID=
# PEM. `.env` cannot hold real newlines in an unquoted value, so writing `\n` works too —
# `readGithub` restores them, but only when the value has no real newline yet.
GITHUB_APP_PRIVATE_KEY=
# the org that App is installed on, and where EVERY site repo is created
GITHUB_ORG=
# guards GitHub's push webhook (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# ── The eight remaining keys `config.js` reads that this file never mentioned ───────────────────
#
# All eight are `opt()` — missing means a default or the feature off, none crashes the app. Listed
# because a key that exists only in code is a key nobody knows to set.

# Public landing for visitors NOT signed in, at the root. Empty = no landing: strangers go to /login.
GUEST_SITE_KEY=
# Where, inside the default host's dsh CONTAINER, a signed-in viewer's own creation workspace is
# made — the folder `POST /gateway/seat/session` registers per account under `/new/`. Default
# `/desk-home/onboarding`, which the dsh image's entrypoint creates. Set only when the dsh home is
# somewhere else; it is a container path, never a path on the machine running tracy-web.
ONBOARDING_HOME=
# Sender address, REQUIRED when MAIL=resend:… (`need()`, not `opt()`) — missing means the app won't boot.
MAIL_FROM=
# Mail sent by CUSTOMER SITES (PHP mail()/wp_mail() → tracy-sendmail shim → tracy-web's POST /_site-mail).
# Details: docs/references/customer-site-mail.md.
#   off  = door closed (default): every message gets 503, nothing else changes.
#   log  = runs every check, then logs the message instead of sending — to try the path on one machine.
#   smtp = really sends through Resend's SMTP (MIME/attachments kept as is).
SITE_MAIL=off
# Sending domain for customer sites, REQUIRED when SITE_MAIL is not off (e.g. sites.<Tracy's domain>).
# Must already be verified on Resend — not guessed from SITE_DOMAIN.
SITE_MAIL_DOMAIN=
# Resend key for customer-site mail. Empty = use the key of MAIL=resend:… ; SITE_MAIL=smtp with no
# key at all means the app won't boot.
SITE_MAIL_KEY=
# SMTP server to send through. Default smtp.resend.com / 465 (TLS from the start).
SITE_MAIL_SMTP_HOST=
SITE_MAIL_SMTP_PORT=
# Shared daily cap (UTC) for every site in tracy/tracy-domain mode — keeps the rest of the Resend
# plan for sign-in mail. Default 50.
SITE_MAIL_GLOBAL_DAILY=
# Default per-site limits: messages in the last 60 minutes (default 10) and per UTC day
# (default 20). Ops raises them per site on /ops.
SITE_MAIL_SITE_HOURLY=
SITE_MAIL_SITE_DAILY=
# Folder holding each site's site-access signing key (`<label>.key`), mounted read-only from the host's
# `$TRACY_PRIVATE_ROOT/.site-access`. Empty = `/var/lib/tracy/site-access`. Without a key a site gets no
# signed assertion, so a site already on the strict access plugin signs nobody in.
TRACY_SITE_ACCESS_DIR=
# tracy-domain mode (the customer's own domain on Tracy's SHARED Resend account). The key must be
# Full access (a Sending access key cannot read/create domains → the screen reports "not usable yet").
# How many domains the Resend plan holds, INCLUDING Tracy's own sending domain (Free plan: 3). When full,
# the site admin is told right away, before anything is created. Default 3.
SITE_MAIL_DOMAIN_LIMIT=
# Days a domain Tracy created waits for the customer to add DNS; past that and still unverified, the
# cron clock deletes it on Resend and the site sends from a Tracy address again. Default 3.
SITE_MAIL_DOMAIN_PENDING_DAYS=
# Text model for seeder/brand. Default: openrouter.ai/api/v1 + llama-3.3-70b-instruct.
# The picture door: the EmDash build draws a site's photographs for the customer's trade, and only
# OpenRouter's image models answer with images. Empty: the words are written, the pictures skipped.
# Same env-shadowing rule as `MODEL_API_KEY` above: empty lets `/ops` change it, a value here does not.
OPENROUTER_API_KEY=
MODEL_BASE_URL=
MODEL_WORDS=
# The port a site answers on in the address printed for the reader. Default 51710 — RIGHT on a laptop and
# WRONG on every real deploy, so `/api/config` takes the port from `TRACY_ORIGIN` itself, not from here.
# Prefix the address of a FLEET-CREATED site carries in front of the name people type.
#
# 🔒 EMPTY ON BOTH RUNNING DEPLOYS, and knowing why saves a search: dev has its OWN ZONE
# (`tracy.site`, since 11/09), production is on `tracy.ai`, so the two sides' `<label>`s never
# meet. Before that dev was going to share `tracy.ai`, and the `dev-` prefix kept
# `dev-lantern.tracy.ai` from taking the hostname of `lantern.tracy.ai` — a separate zone does that
# better, because it separates COOKIES (`SESSION_DOMAIN`) and not just names.
#
# The key stays: it is the only way to run another deployment INSIDE a zone that already has sites, and
# without it the first attempt to do so would overwrite a hostname serving someone else.
#
# ⚠ And don't replace it with a subzone: `dev.tracy.ai` is a TWO-level name, and Cloudflare's Universal
# certificate covers only `tracy.ai` + `*.tracy.ai`. Measured 07/09 and again 10/09: Cloudflare refuses the
# TLS handshake itself for two-level SNI — not a wrong certificate, nothing at all. With a separate domain
# (`tracy.site`), `*.tracy.site` is ONE level, and Universal covers it.
#
# 🔒 NEWLY CREATED SITES ONLY. An IMPORTED site carries the CUSTOMER's address — prefixing it would rename
# someone else's domain. And the prefix goes into the ADDRESS, not the name people type: type `bao-cao`, get
# `dev-bao-cao`, and the naming rules still judge exactly `bao-cao`.
SITE_ADDRESS_PREFIX=

# The DNS resolver a customer's own domain is read with, as `ip[:port]` (several separated by
# commas); a host name is refused at start. Empty = the machine's own resolver, which is what every
# real deployment wants; a local stand names the resolver serving its test zone.
TRACY_DNS_RESOLVER=

# This environment's name, spelled exactly as the prebuilt-site inventory's pool key spells it
# (`apps/tracy-web/src/lib/inventory-pool-key.js`). Not decoration: without it a dev stand and
# production share ONE pool key, and stock prepared on one side looks like supply for the other.
# Empty = `local`.
TRACY_ENVIRONMENT=
# Invitations sandbox: synthetic contacts only; no external mail. Explicit local/dev environment required.
INVITATIONS_SANDBOX_ENABLED=
# Private non-secret path; separate named volume, never part of PostgreSQL backups.
# Local compose supplies the path, but still requires explicit TRACY_ENVIRONMENT=local.
# On dev enable explicitly after verifying the volume owner/mode. Keep staging/prod empty.
INVITATIONS_REAL_KEY_DIR=
# Invitations Gmail OAuth is dev/local only. Configure all four together. Keep the dedicated
# 32-byte base64 key outside database backups; rotate with a planned credential reconnect.
INVITATIONS_GMAIL_CLIENT_ID=
INVITATIONS_GMAIL_CLIENT_SECRET=
INVITATIONS_GMAIL_KEY_ID=
INVITATIONS_GMAIL_KEY=
# The one mailbox invitations are sent from; the OAuth sign-in must be exactly this address.
INVITATIONS_GMAIL_ADDRESS=
# Real campaign test sends (local/dev only, read as off anywhere else): `test` lets an owner/admin
# send an approved draft to one address of INVITATIONS_TEST_RECIPIENTS (comma-separated). Never a
# customer. INVITATIONS_TEST_DAILY_LIMIT caps test sends per rolling 24 hours (default 50).
INVITATIONS_SENDING=
INVITATIONS_TEST_RECIPIENTS=
INVITATIONS_TEST_DAILY_LIMIT=
# `pilot` (instead of `test`) also lets an owner/admin send an approved invitation to its own
# customer, one press at a time, at most INVITATIONS_PILOT_MAX (default 2000, at most 10000), 180 s apart, after
# aMember confirms an active plan (AMEMBER_API_KEY). Every message carries an unsubscribe link.
INVITATIONS_PILOT_MAX=

SITE_HTTP_PORT=
# Turnstile in front of the OTP door. Empty + TURNSTILE_DISABLED empty = no captcha.
TURNSTILE_SECRET=
# Only `1` or `true` disables it — `TURNSTILE_DISABLED=false` does NOT turn the captcha back on; it would
# disable it if read as "declared means on"; `config.js` deliberately reads an affirmative, not presence.
TURNSTILE_DISABLED=

# ── Two keys WRITTEN BY CI, not filled in by people ────────────────────────────────────────────
# `deploy/scripts/deploy-tracy-stack.sh` writes them into the LIVE MACHINE's env file after every
# successful deploy (`write_tag`), so on a laptop they mean nothing and empty is right. Listed here
# because whoever sets up a new machine will see them appear in `/etc/tracy/tracy-web.env` and needs to
# know who wrote them: `APP_IMAGE_TAG` is the running version, `APP_IMAGE_TAG_PREVIOUS` is what
# `--rollback` returns to. Editing them by hand changes nothing running — they are only a record.
#
# ⚠ `write_tag` rewrites the WHOLE FILE (filters out these two lines and appends, via a temp file and `mv`).
# A hand edit made during a deploy is lost — edit, then deploy again; don't edit mid-deploy.
APP_IMAGE_TAG=
APP_IMAGE_TAG_PREVIOUS=

# Show newly issued OTP on the local login page; requires console mail and non-production runtime.
# macOS compose enables this by default. Set 0 to test the normal email flow.
LOCAL_LOGIN_PREVIEW=


# Own-domain HTTPS probe (sites/domain-probe.js), for a LOCAL STAND only: 1 = the probe may dial a
# private address, PORT = the HTTPS port it dials instead of 443. Empty = public addresses on 443;
# without them a stand's own domain stays pending. Refused at boot in production.
TRACY_OWN_DOMAIN_PROBE_ALLOW_PRIVATE=
TRACY_OWN_DOMAIN_PROBE_PORT=

# Comment picker in the Browser tab (tasks/todo-comment-to-edit.md §S): 1 = ticket door + site proxy on; empty = off (production default).
TRACY_COMMENT_PICKER=
# 1 = a plain-HTTP local stand may redeem picker tickets without Sec-Fetch-Dest; refused at boot on any other origin.
TRACY_COMMENT_PICKER_INSECURE_DEV=

# Backup export doors (`POST /api/sites/:key/backups/:version/export`):
# `on` or `off`, default on. ADR 0024 amendment 3 permits Owner-only downloads. Set `off` to return
# 404 `EXPORT_OFF` from both doors while investigating an operational issue.
BACKUP_EXPORT=on

# Who may read customers' own words on /ops › Beta › Usage (the sample of turns behind the numbers):
# comma-separated addresses of the people given the quality review — not every Tracy staff seat.
# Unset: nobody, and the screen shows numbers only. Every read is written to `audit`.
USAGE_TEXT_READERS=

# Legacy setting: on/off are accepted, but neither restricts sign-in. Whitelist is marketing only.
BETA_GATE=off
AMEMBER_API_URL=https://www.joomlart.com/member/api/check-access/by-email
AMEMBER_API_KEY=
# WordPress owns submissions/confirmation mail (spec 76). tracy uses the signed-token backend.
BETA_WAITLIST_MODE=wordpress
# Landing page owned by the marketing site. Empty defaults to https://tracy.ai/whitelist/.
BETA_WAITLIST_URL=
# Missing Telegram settings disable delivery, not analytics or the service.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
ALERT_LABEL=

# AI Assistant → a person: a Customer Service bot of its own (never the alert bot above) in a forum
# supergroup with Topics on; the bot must be an admin allowed to Manage topics. MODE: off (default),
# webhook (public host: set the webhook to <origin>/api/assistant/telegram/webhook with SECRET as
# secret_token), polling (a laptop with no public address). STAFF_IDS empty = every group member.
CS_TELEGRAM_MODE=off
CS_TELEGRAM_BOT_TOKEN=
CS_TELEGRAM_CHAT_ID=
CS_TELEGRAM_WEBHOOK_SECRET=
CS_TELEGRAM_STAFF_IDS=

# Tracy's Discord bot (tools/discord-link-bot in tracy-marketing): the shared secret it sends as
# x-tracy-discord-secret to /api/discord/*. 32-256 characters of A-Z a-z 0-9 _ -; blank = doors off.
DISCORD_LINK_SECRET=

# Private WordPress confirmation relay; blank secret disables it. Shares OTP Resend transport.
WHITELIST_CONFIRMATION_SECRET=
# Conservative confirmation-attempt budget per UTC day; does not reserve provider OTP quota.
WHITELIST_CONFIRMATION_DAILY=80

# Account subscription encryption key (32 random bytes in base64). Missing means connections are unavailable.
SEAT_PLAN_KEK=

# Server-side Apify token for Website Opportunities connectors; empty = social sources report credential_missing.
APIFY_TOKEN=
# Optional TripAdvisor enrichment; empty without a saved key means no TripAdvisor calls.
# /ops/wo Settings stores an encrypted override; clearing restores this key.
# SerpApi is primary; RapidAPI OneAPI and Litescrape are fallbacks.
SERPAPI_API_KEY=
LITESCRAPE_API_KEY=
# Website Opportunities provider keys, read only when no key is saved on /ops/wo (a saved key wins).
# Google key for Places (New), PageSpeed Insights and Maps Embed; empty = Places search falls back to
# Apify, then OpenStreetMap, the background site check skips PageSpeed, and the research job brings no
# Google details or photos. GOOGLE_PLACES_API_KEY is an older name for the same key, read second.
GOOGLE_API_KEY=
GOOGLE_PLACES_API_KEY=
# RapidAPI application key for the social stats of Find places (follower counts and posting dates of
# Facebook, Instagram, TikTok and YouTube pages through the listings named in /ops/wo); empty = only
# YouTube is measured (with GOOGLE_API_KEY), the other networks answer credential_missing.
RAPIDAPI_KEY=
# Optional primary public social research provider for Facebook, Instagram, and TikTok.
SCRAPECREATORS_API_KEY=
# Optional: up to 100 more Google reviews a place through Monid. Runs only once Monid is also added to the
# Google reviews order on /ops/wo; empty = never called.
MONID_API_KEY=
# Website Opportunities shared research (one research per restaurant, shared across accounts, paid by
# Tracy). Blank or anything else = on; 0, false or off = a new request runs the old per-account research,
# and pages still read research already published for a place.
WO_SHARED_RESEARCH=
# Website Opportunities site checks: on/1/true = a homepage that refuses the crawler (403 or a bot challenge) is read once
# more through a Chrome-fingerprint client. Blank or anything else = off; refused homepages stay `blocked`.
WO_SITE_READ_TLS=
# DeepSeek, Firecrawl and Jina keys can be saved and tested on /ops/wo; no pipeline step calls them yet,
# so empty changes nothing today.
DEEPSEEK_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
# Optional shared social service. Standalone uses the local provider pipeline; client mode needs the
# fixed HTTPS central origin and its service token. The central service uses a separate key pepper.
WO_SOCIAL_ROLE=
WO_SOCIAL_ORIGIN=
WO_SOCIAL_TOKEN=
WO_SOCIAL_KEY_PEPPER=
# Optional immutable design asset distribution. Leave all three blank to use bundled assets;
# otherwise configure the index file, HTTPS asset origin and absolute cache directory together.
TRACY_DESIGN_ASSET_INDEX=
TRACY_DESIGN_ASSET_ORIGIN=
TRACY_DESIGN_ASSET_CACHE=
# Explicit personal loopback installation; blank defaults to cloud mode. Local mode requires its
# own random 32-byte hex secret and installation UUID v4; neither is a customer account credential.
TRACY_MODE=
LOCAL_ACCESS_SECRET=
LOCAL_INSTALLATION_ID=
