# GitHub App used to write into customer repos (repo creation, branches, merges,
# webhooks).  It is NOT the `gh` login of whoever runs the command.
# The private key is a file, never an env value: keep the .pem under `.secrets/`,
# which is gitignored, and point at it here with an absolute path.
GITHUB_HOST_APP_ID=
GITHUB_HOST_APP_SLUG=
GITHUB_HOST_APP_PRIVATE_KEY_FILE=/ABSOLUTE/PATH/TO/TCH/.secrets/<app>.pem
