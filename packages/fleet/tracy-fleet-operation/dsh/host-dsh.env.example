# /etc/tracy/host-dsh.env — the deployment knobs of this host's dsh.
#
# Copy to /etc/tracy/host-dsh.env and fill in. `host-dsh-init.sh <host>` writes four of these lines
# (DSH_IMAGE_TAG, HOST_AGENT_HOSTNAME, HOST_SITES_ROOT, HOST_DSH_HOME) and KEEPS a file that already
# exists, so a new machine writes this file first, complete, and then runs the init.
#
# 🔒 READ TWICE, BY TWO READERS. `docker compose --env-file` interpolates host-dsh.yml from this
# file, AND host-dsh.yml lists it as the container's `env_file`. So every name here also becomes
# an environment variable INSIDE the dsh container. That is why nothing that only compose needs
# is named after something the image reads — see the TRACY_SITES_ROOT warning below.
#
# 🔒 NO SEAT SECRETS HERE. MCP_SEAT_SECRET, MCP_TRACY_ACTOR_SECRET, MCP_JWT_SECRET and the rest
# live in /srv/tracy/host-dsh/home/dsh-passwords.env, mode 0600, which the gateway reads through
# DSH_PASSWORDS_ENV_FILE. Anything put in THIS file is printed in full by `docker inspect
# tracy-dsh` to anyone in the docker group.
#
# MCP_TRACY_ORIGIN — the tracy-web this dsh sends people to and calls — is not here either: it is
# in dsh-passwords.env, written once by `host-dsh-init.sh --tracy-origin <url>` (default
# https://cowork.tracy.ai, production; dev passes https://cowork.tracy.site, a shard its own
# https://sN.tracy.ai).

# ── Required ──────────────────────────────────────────────────────────────────────────────────

# Tag of the tracy/dsh image this host runs — `<date>-<short repo sha>`, built and pushed by
# `.github/workflows/build-dsh-image.yml` and pulled from GHCR. `deploy-host-dsh.sh` rewrites this
# line on every deploy and keeps the previous value in DSH_IMAGE_TAG_PREVIOUS below, which is what
# a rollback reads.
#
# Not built here any more: one x86_64 runner builds it once, because DO cannot build it at all
# (2 cores, 3 GB, 17 GB free against a 5.8 GB image). Building by hand is still possible —
#   docker build -f packages/fleet/tracy-fleet-operation/dsh/Dockerfile \
#     --build-arg DSH_COMMIT=$(git ls-tree HEAD vendor/tracy/deepseek-harness | awk '{print $3}') \
#     -t tracy/dsh:dev .
# — and then DSH_IMAGE below points at it.
DSH_IMAGE_TAG=

# Written by deploy-host-dsh.sh, read by nothing else: the tag that was running before the last
# deploy. `deploy-host-dsh.sh --rollback` puts it back. Leave it alone by hand.
#DSH_IMAGE_TAG_PREVIOUS=

# The public hostname this dsh accepts in a Host header (DSH_TRUSTED_HOSTS in host-dsh.yml).
# `host-dsh-init.sh <host>` writes <host>-agent.tracy.ai:
# `prod1-agent.tracy.ai` on prod1, `s1-agent.tracy.ai` on shard s1. A name a request arrives under
# that is not on the list is a 421 that reads like an outage.
HOST_AGENT_HOSTNAME=

# The public site domain: a site answers at https://<label>.<this>/. Same value as SITE_DOMAIN in
# /etc/tracy/tracy-web.env (`tracy.site` on the dev host). site-tools reads it to recognise a
# site's own https origin; empty, `page.text` and `page.look` refuse every fleet page as
# REDIRECTED_OFF_SITE. `deploy-host-dsh.sh` refuses to deploy without it. Exactly one line, a bare
# hostname, no comment on that line (compose would read `KEY= # note` as empty).
TRACY_SITE_DOMAIN=

# ── Optional, with defaults that are right on both hosts ──────────────────────────────────────

# The scheme and port every site address shares, when they are not https with no port. Leave it
# empty on a fleet host: sites there are https://<label>.<TRACY_SITE_DOMAIN>, which is what empty
# means. Only a deployment whose sites carry a port or plain http (a local stand,
# `http://tracy.test:51710`) sets it, so `page.text` can follow a site's redirect to its own address.
# A malformed value is ignored with one warning at boot, never guessed.
#TRACY_DEPLOYMENT_ORIGIN=

# The image repository. Default is `<TRACY_IMAGE_PREFIX>/tracy-dsh`, the prefix being the GHCR
# owner the build workflow pushes to (`ghcr.io/tracyhq`) unless the deploy names the ECR one
# (`<account>.dkr.ecr.<region>.amazonaws.com/lab3-image/tracy-ai`). Point it at a local tag
# (`DSH_IMAGE=tracy/dsh`) to run something built on this machine — the only reason to set it, and
# the reason it is a variable rather than a literal in host-dsh.yml.
#DSH_IMAGE=ghcr.io/tracyhq/tracy-dsh

# Where provision/attach-site.sh binds site folders. Mounted at /site in the container.
#
# ⚠ NOT NAMED TRACY_SITES_ROOT, and that is the point. TRACY_SITES_ROOT is what
# @tracy/dsh-subprocess-docker reads for the sites root INSIDE the container, and it must stay
# unset there so the provider uses its /site default. A variable by that name in this file would
# be injected into the container by `env_file` and point the agent at a host path that does not
# exist inside it — every site would read as empty, with no error anywhere.
#HOST_SITES_ROOT=/srv/tracy-sites

# Where each site's private half lives, the webroot repo included (`<root>/<label>/webroot-
# baseline.git`). Read only by `deploy-host-dsh.sh`: the tracy-access.php resync commits its copy
# there as an outside commit of the site's history. Default /srv/tracy; unset and absent → the copy
# lands with no commit. Same reason for the `HOST_` name as above: the container must not receive it.
#HOST_PRIVATE_ROOT=/srv/tracy

# The container's /desk-home: sessions, storages, dsh-passwords-data, workspace,
# .credentials.yaml, dsh-passwords.env. Owned 33:33 (www-data), which is the uid the image runs
# as.
#HOST_DSH_HOME=/srv/tracy/host-dsh/home

# What this dsh may take from the machine (host-dsh.yml carries the measurements). Memory in whole
# megabytes or gigabytes, swap held to the same number; processes count threads.
#
# ⚠ TRACY_DSH_CPUS MUST NOT EXCEED THIS MACHINE'S CORES (`nproc`): docker refuses to create a
# container asking for more ("range of CPUs is from 0.01 to 2.00"), so the next `up -d` leaves the
# host with no dsh at all. The default, 2, fits every host; prod1 has 6 and can take 4.
#
# The caps of the SITE containers are not set here: they are tracy-host's (TRACY_SITE_* in
# /etc/tracy/tracy-web.env, read by provision/render-compose.sh).
#TRACY_DSH_MEMORY=4g
#TRACY_DSH_CPUS=2
#TRACY_DSH_PIDS=4096

# ── Not variables, written here so nobody has to go looking ───────────────────────────────────
#
# Set in host-dsh.yml's `environment:` because they are the same on every host, and a value that
# cannot differ should not be a knob:
#
#   DSH_PORT=51700                                dsh inside the container; never published
#   DSH_PASSWORDS_ENV_FILE=/desk-home/dsh-passwords.env
#   TRACY_DOCKER_HOST=tcp://docker-proxy:2375     the socket proxy, not a socket bind
#   DSH_TRUSTED_HOSTS=$HOST_AGENT_HOSTNAME,127.0.0.1:51700,127.0.0.1:8080
#
# The published port is 8080 in the container (the dsh-passwords gateway, i.e. the seat door)
# mapped to 127.0.0.1:51700 on the host. dsh's own 51700 stays inside.
#
# The socket proxy has no switches to set any more: what it allows is `docker-proxy.haproxy.cfg`,
# mounted from NEXT TO host-dsh.yml by a relative path. The two files ship together — /opt/tracy-
# fleet/dsh/ on a host — and host-dsh-init.sh refuses to run if the config is not there.

# ── Model key ─────────────────────────────────────────────────────────────────────────────────

# The key the agent talks to its model with. Reaches the container as `DEEPSEEK_API_KEY`
# (host-dsh.yml), which is the name `settings.yaml`'s default route `deepseek-official` reads.
# One name here and in `deploy/.env` on a laptop, so a person setting up a machine never has to
# know what the route inside dsh is called.
#
# 🔒 EMPTY = A MUTE AGENT THAT LOOKS ALIVE. The session is created, the message is accepted, and
# the turn dies with `MISSING_CREDENTIAL: llm-deepseek: no API key for provider route
# "deepseek-official"` three layers below anything a person is looking at. Measured 11/09 on the
# dev host, where this line simply did not exist.
#
# ⚠ Unlike the seat secrets, this one IS printed by `docker inspect tracy-dsh`. See the note at
# the top of this file: that is the cost of the harness reading its key from the environment, and
# it is why nothing stronger than a vendor key belongs in here.
MODEL_API_KEY=

# Private Joomla release assets. Repository-scoped token with Contents: read for
# JoomlArt-Products/joomlart-products. Also set it on tracy-host for quickstart provisioning.
# env_file passes it to dsh; only short-lived asset URLs reach the site's component.
TRACY_RELEASES_GITHUB_TOKEN=

# ── Telegram alerts (deploy/scripts/*-alert.sh, run by cron on the host) ──────────────────────

# Read by model-balance-alert.sh (DeepSeek balance) and server-status-alert.sh (CPU, RAM, disk,
# containers), installed by hand in /opt/tracy-fleet/ with a file in /etc/cron.d/. Both scripts
# grep this file themselves; nothing in the dsh image reads these names.
#
# ⚠ `env_file` still hands them to the dsh container (top of this file), so the bot token is
# printed by `docker inspect tracy-dsh` like MODEL_API_KEY.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=              -100… of the group
#TELEGRAM_THREAD_ID=            message_thread_id of the topic

# The name inside [..] at the start of every message. Several hosts post into ONE topic, and two
# of them can share a hostname, so name the environment: DEV, PROD. Empty = `hostname -s`.
#ALERT_LABEL=

# Thresholds and periods; the defaults are written at the top of each script.
#MODEL_BALANCE_MIN=2
#MODEL_BALANCE_REPORT_EVERY=3600
#SERVER_RAM_MAX=90
#SERVER_DISK_MAX=85
#SERVER_DISK_PATHS=/
#SERVER_LOAD_MAX=2
#SERVER_IGNORE_CONTAINERS=
#SERVER_STATUS_REPORT_EVERY=3600
