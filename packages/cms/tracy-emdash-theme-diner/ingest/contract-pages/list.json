{
  "layout": {
    "id": "BlogList",
    "view": "src/views/BlogList.astro",
    "family": "list"
  },
  "rules": [
    ["blog-card-title", ".dn-blog-card h3", "index.php/our-blog/index.html", false],
    ["blog-card-date", ".dn-blog-card .dn-card-meta", "index.php/our-blog/index.html", false],
    ["blog-card-intro", ".dn-blog-card .dn-card-intro", "index.php/our-blog/index.html", false],
    ["blog-more-title", ".dn-more h3", "index.php/our-blog/index.html", true],
    ["blog-pagination", ".dn-pagination a.is-active", "index.php/our-blog/index.html", true],
    ["aside-title", ".dn-aside h3", "index.php/our-blog/index.html", false]
  ],
  "parity": {
    "blog-card-img": {
      "site": ".dn-blog-card .dn-card-img img",
      "source": ".isotope-item .item-image img"
    },
    "blog-cats-title": {
      "site": ".dn-aside h3",
      "source": ".t3-sidebar .module-title"
    }
  },
  "pages": [
    {
      "id": "en-blog",
      "path": "/our-blog",
      "status": 200,
      "source": ["index.php/our-blog/index.html"],
      "identity": ".dn-post-grid",
      "collections": ["chrome", "posts", "masthead", "category_info"],
      "rules": [
        "masthead-title",
        "blog-card-title",
        "blog-card-date",
        "blog-card-intro",
        "blog-more-title",
        "blog-pagination",
        "aside-title"
      ],
      "parity": ["nav", "footerTitle", "ground", "blog-card-img"],
      "content": [
        [
          "blog-masthead",
          ".dn-masthead-title",
          "index.php/our-blog/index.html",
          "field",
          "masthead.title",
          "Our Blog"
        ],
        [
          "blog-first-title",
          ".dn-blog-card h3 a",
          "index.php/our-blog/index.html",
          "field",
          "posts.title",
          "We've been nominated for the Britain Restaurant Awards"
        ],
        [
          "blog-more-label",
          ".dn-more h3",
          "index.php/our-blog/index.html",
          "field",
          "chrome.more_label",
          "More Articles \u2026"
        ]
      ]
    },
    {
      "id": "en-blog-2",
      "path": "/our-blog?page=2",
      "status": 200,
      "source": ["index.php/our-blog/index~start=12.html"],
      "identity": ".dn-post-grid",
      "collections": ["chrome", "posts", "masthead", "category_info"],
      "rules": [
        "masthead-title",
        "blog-card-title",
        "blog-card-date",
        "blog-card-intro",
        "blog-pagination",
        "aside-title"
      ],
      "parity": ["nav", "footerTitle", "ground", "blog-card-img"],
      "content": [
        [
          "blog-masthead",
          ".dn-masthead-title",
          "index.php/our-blog/index~start=12.html",
          "field",
          "masthead.title",
          "Our Blog"
        ],
        [
          "blog-first-title",
          ".dn-blog-card h3 a",
          "index.php/our-blog/index~start=12.html",
          "field",
          "posts.title",
          "10 most alluring LTOs on menus in July"
        ]
      ]
    },
    {
      "id": "en-category",
      "path": "/restaurant-news",
      "status": 200,
