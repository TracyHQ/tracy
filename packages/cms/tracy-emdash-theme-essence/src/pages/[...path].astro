---
/**
 * One router for every locale. Astro resolves `Astro.currentLocale` from the URL, so a single catch-all serves the whole
 * site; unknown paths render the 404 view with a 404 status. Routes (seed/site-model.json): the Home, `/blog/<post>`,
 * `/category/<term>`, `/tag/<term>`, `/author/<author>`, `/our-authors`, `/contact` and `/search`.
 */
export const prerender = false
import { splitPath } from '@/lib/i18n'
import { loadChrome } from '@/lib/chrome'
import Home from '@/views/Home.astro'
import Post from '@/views/Post.astro'
import Category from '@/views/Category.astro'
import Authors from '@/views/Authors.astro'
import Contact from '@/views/Contact.astro'
import Search from '@/views/Search.astro'
import NotFound from '@/views/NotFound.astro'
import { childLive } from '@/lib/link-gate'
import { loadAuthors, loadCategoryInfo, loadPosts } from '@/lib/posts'

const { locale, path } = splitPath(Astro.url.pathname)
const chrome = await loadChrome(locale)
const segs = path.split('/').filter(Boolean)
const SLUG = /^[a-z0-9][a-z0-9-]*$/
const clean = segs.length === 0 ? '/' : `/${segs.join('/')}`

type View = { component: any; props: Record<string, unknown> } | null
let view: View = null
if (clean === '/') view = { component: Home, props: {} }
else if (segs.length === 1 && segs[0] === 'our-authors') view = { component: Authors, props: {} }
else if (segs.length === 1 && segs[0] === 'contact') view = { component: Contact, props: {} }
else if (segs.length === 1 && segs[0] === 'search') view = { component: Search, props: {} }
else if (segs.length === 2 && SLUG.test(segs[1])) {
  if (segs[0] === 'blog') view = { component: Post, props: { slug: segs[1] } }
  else if (segs[0] === 'category' || segs[0] === 'tag' || segs[0] === 'author')
    view = { component: Category, props: { by: segs[0], slug: segs[1] } }
}

// The status must be known before the page starts to stream: a view that sets it itself answers 200 in the built site. So a
// post, category, tag or author that does not exist is turned into the 404 view here.
if (view && segs.length === 2 && segs[0] !== undefined) {
  const slug = segs[1]
  const known =
    segs[0] === 'blog'
      ? (await loadPosts(locale)).some((p) => p.slug === slug)
      : segs[0] === 'category'
        ? (await loadCategoryInfo(locale)).some((c) => c.slug === slug)
        : segs[0] === 'tag'
          ? (await loadPosts(locale)).some((p) => p.tags.some((t) => t.slug === slug))
          : (await loadAuthors(locale)).some((a) => a.slug === slug)
  if (!known) view = null
}

// a page the customer unticked (its record is unpublished), and everything that hangs under it, answers 404
if (view && !(await childLive(Astro.request, locale, clean))) view = null
const Component = view?.component ?? NotFound
if (!view) Astro.response.status = 404
---

<Component chrome={chrome} locale={locale} path={path} {...(view?.props ?? {})} />
