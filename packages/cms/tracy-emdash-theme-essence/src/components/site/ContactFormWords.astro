---
/**
 * Writes the `contact` entry's words over the plugin embed (default slot): field labels, the checkbox line and the
 * button. The plugin prints the labels of the form definition; the page must print the entry's, so an editor's change
 * shows. Provenance stamps are added to the replaced elements.
 */
import type { Row } from '@/lib/content'
import type { Stamp } from '@/lib/stamps'

interface Props {
  c: Row
  stamp: Stamp
}
const { c, stamp: $c } = Astro.props
const html = Astro.slots.has('default') ? await Astro.slots.render('default') : ''
const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const attrs = (field: string) =>
  Object.entries($c(field))
    .map(([k, v]) => ` ${k}="${esc(v).replace(/"/g, '&quot;')}"`)
    .join('')
let out = html
for (const [name, key] of [['name', 'name_label'], ['email', 'email_label'], ['subject', 'subject_label'], ['message', 'message_label']] as const) {
  if (!c[key]) continue
  out = out.replace(
    new RegExp(`<label\\b([^>]*\\bfor="[^"]*-${name}"[^>]*)>\\s*[^<]*`),
    (_m, a) => `<label${a}${attrs(key)}>${esc(c[key])}`
  )
}
if (c.copy_label)
  out = out.replace(
    /(<label\b[^>]*ec-form-checkbox-label[^>]*>\s*<input\b[^>]*\bname="copy"[^>]*>)\s*[^<]*/,
    (_m, a) => `${a} <span${attrs('copy_label')}>${esc(c.copy_label)}</span>`
  )
if (c.send_label)
  out = out.replace(
    /(<button\b[^>]*\bec-form-submit\b[^>]*)>\s*[^<]*/,
    (_m, a) => `${a}${attrs('send_label')}>${esc(c.send_label)}`
  )
---

<Fragment set:html={out} />
