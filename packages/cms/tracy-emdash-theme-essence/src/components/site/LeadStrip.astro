---
/** The top strip of the Home: overlay cards on a picture, three at a time on a wide screen, a scroll-snap row with dots. */
import { formatDate, href } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { authorPath, postPath, type AuthorRow, type PostRow } from '@/lib/posts'
import { stampFor } from '@/lib/stamps'
import { liveLinks } from '@/lib/link-gate'
import { ui } from '@/lib/ui'
import type { Chrome } from '@/lib/chrome'
import ListPill from '@/components/site/ListPill.astro'

interface Props { posts: PostRow[]; chrome: Chrome; authors: Record<string, AuthorRow> }
const { posts, chrome, authors } = Astro.props
const { tag, w } = ui(chrome.locale)
const liveAuthor = await liveLinks(Astro.request, chrome.locale, Object.values(authors).map((a) => authorPath(a.slug)))
const stamps = (p: PostRow) => stampFor(Astro.request, 'posts', { id: p.id, slug: p.slug })
---

{posts.length > 0 && (
	<section class="es-strip" data-es-strip data-label={w.pageOf}>
		<div class="es-wrap">
			<ul class="es-strip-track" data-es-track>
				{posts.map((p) => {
					const $p = stamps(p)
					const src = mediaUrl(p.cover)
					const a = authors[p.author]
					return (
						<li class="es-strip-item" {...$p()}>
							{src && <img src={src} alt="" width={p.cover?.width ?? 355} height={p.cover?.height ?? 362} loading="eager" decoding="async" {...$p('cover')} />}
							<div class="es-strip-content">
								<ListPill post={p} chrome={chrome} class="es-strip-pill" />
								<h3><a href={href(chrome.locale, postPath(p))} {...$p('title')}>{p.title}</a></h3>
								<p class="es-strip-meta">
									{a && <span {...$p('author')}>{chrome.site.by_label} {liveAuthor(authorPath(a.slug)) ? <a href={href(chrome.locale, authorPath(a.slug))}>{a.name}</a> : <b>{a.name}</b>}</span>}
									<time datetime={p.date} {...$p('date')}>{formatDate(p.date, tag)}</time>
								</p>
							</div>
						</li>
					)
				})}
			</ul>
			<div class="es-dots" data-es-dots></div>
		</div>
	</section>
)}

<script>
	// Dots for the scroll-snap strip: one per screenful, built from the measured widths so they follow the breakpoint.
	document.querySelectorAll<HTMLElement>('[data-es-strip]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-es-track]')
		const dots = root.querySelector<HTMLElement>('[data-es-dots]')
		if (!track || !dots) return
		const items = Array.from(track.children) as HTMLElement[]
		const template = root.dataset.label || '{page}'
		let buttons: HTMLButtonElement[] = []
		let step = 1
		const build = () => {
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0
			const itemW = items[0].offsetWidth + gap
			step = Math.max(1, Math.round((track.clientWidth + gap) / itemW))
			const pages = Math.ceil(items.length / step)
			dots.hidden = pages < 2
			dots.textContent = ''
			buttons = Array.from({ length: pages }, (_, i) => {
				const b = document.createElement('button')
				b.type = 'button'
				b.className = 'es-dot'
				b.setAttribute('aria-label', template.replace('{page}', String(i + 1)).replace('{pages}', String(pages)))
				b.addEventListener('click', () => track.scrollTo({ left: items[Math.min(i * step, items.length - 1)].offsetLeft - items[0].offsetLeft, behavior: 'smooth' }))
				dots.appendChild(b)
				return b
			})
			mark()
		}
		const mark = () => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0
			const page = atEnd ? buttons.length - 1 : Math.min(buttons.length - 1, Math.round(track.scrollLeft / ((items[0].offsetWidth + gap) * step)))
			buttons.forEach((b, i) => b.classList.toggle('is-active', i === page))
		}
		track.addEventListener('scroll', mark, { passive: true })
		new ResizeObserver(build).observe(track)
		build()
	})
</script>
