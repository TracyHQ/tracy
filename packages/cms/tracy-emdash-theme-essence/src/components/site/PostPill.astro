---
/** A category or tag pill: grey rounded label with a coloured dot (the dot colour cycles by the slug, as the source's `cat-*` classes do). */
import { categoryDot } from '@/lib/category-dot'

interface Props {
  href: string | null
  label: string
  slug: string
  /** `bare`: no grey ground (the pill sits on a white card). */
  tone?: 'grey' | 'white'
}
const { href, label, slug, tone = 'grey' } = Astro.props
const dot = categoryDot(slug)
---

{href
	? <a class:list={['es-pill-cat', tone === 'white' && 'is-white']} href={href} style={`--dot:${dot}`}>{label}</a>
	: <span class:list={['es-pill-cat', tone === 'white' && 'is-white']} style={`--dot:${dot}`}>{label}</span>}
