---
/**
 * The contact form: the Forms plugin's embed with the words of the `contact` entry written over the field labels,
 * the checkbox and the button, so editing them in the CMS changes the page (the form definition keeps the same
 * words only as the fields the plugin validates against). No form id = the area is drawn disabled, never a fake submit.
 */
import { blockComponents } from '@emdash-cms/plugin-forms/astro'
import ContactFormWords from '@/components/site/ContactFormWords.astro'
import FormWords from '@/components/site/FormWords.astro'
import { uiTag } from '@/lib/ui'
import type { Locale } from '@/lib/i18n'
import type { Row } from '@/lib/content'
import type { Stamp } from '@/lib/stamps'

interface Props {
  locale: Locale
  c: Row
  stamp: Stamp
}
const { locale, c, stamp: $c } = Astro.props
const FormEmbed = (blockComponents as any)['emdash-form']
const formId = String(c.form_id ?? '').trim()
const LABELS: [string, string][] = [['name', c.name_label], ['email', c.email_label], ['subject', c.subject_label], ['message', c.message_label]]
---

<div class="es-contact-form">
	{formId ? (
		<ContactFormWords c={c} stamp={$c}><FormWords tag={uiTag(locale)}><FormEmbed node={{ formId }} /></FormWords></ContactFormWords>
	) : (
		<form class="ec-form is-disabled" aria-disabled="true" onsubmit="return false">
			<fieldset class="ec-form-page" disabled>
				{LABELS.map(([k, label]) => (
					<div class="ec-form-field"><label class="ec-form-label" for={`es-off-${k}`} {...$c(`${k}_label`)}>{label}</label>{k === 'message' ? <textarea id={`es-off-${k}`} class="ec-form-input"></textarea> : <input id={`es-off-${k}`} class="ec-form-input" type="text" />}</div>
				))}
			</fieldset>
		</form>
	)}
</div>

<script>
	// the plugin prints its textarea with whitespace inside, which hides the placeholder: an untouched field starts empty
	document.querySelectorAll<HTMLTextAreaElement>('.es-contact-form textarea').forEach((t) => { if (!t.value.trim()) t.value = '' })
</script>
