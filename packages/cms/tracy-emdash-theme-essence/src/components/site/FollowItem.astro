---
/** One round social glyph of the sidebar's Follow me box: a link when the editor gave a real address, else the glyph alone. */
import Icon from '@/components/site/Icon.astro'

interface Props { net: string; url: string | null; title: string }
const { net, url, title } = Astro.props
---

{url ? <a class={`es-round is-${net}`} href={url} title={title} aria-label={title}><Icon name={net} size={16} weight="fill" /></a> : <span class={`es-round is-${net}`} title={title}><Icon name={net} size={16} weight="fill" /></span>}
