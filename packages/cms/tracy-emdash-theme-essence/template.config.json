{
  "id": "tracy-essence",
  "label": "JA Essence",
  "version": "0.1.0",
  "locales": [
    "en"
  ],
  "defaultLocale": "en",
  "site": {
    "title": "JA Essence",
    "tagline": ""
  },
  "contentOrder": [],
  "forms": {
    "file": "tools/forms.json",
    "bindings": [
      {
        "form": "contact-{locale}",
        "collection": "contact",
        "slug": "contact-layout",
        "field": "form_id"
      },
      {
        "form": "subscribe-{locale}",
        "collection": "chrome",
        "slug": "chrome",
        "field": "form_id"
      }
    ]
  },
  "mail": {
    "fromEmail": "no-reply@ja-essence.example",
    "fromName": "JA Essence"
  },
  "audit": {
    "indexable": [
      "^/(?!search)(?!404$).*"
    ],
    "noindex": [
      "^/search"
    ],
    "notFound": [
      "^/404$"
    ],
    "canonicalQuery": [
      "page"
    ],
    "unknownProbes": [
      "/blog/nope"
    ],
    "alternates": "all-locales"
  },
  "qa": {
    "theme": {
      "selector": "html",
      "attribute": "data-theme",
      "values": {
        "light": null,
        "dark": "dark"
      },
      "storageKey": "tracy-essence-theme"
    },
    "expectedStatus": {
      "/404": 404
    }
  },
  "$comment": "Template identity and site-specific wiring read by the generic tools. Demo content: the JA Essence sample site (line-art blog)."
}
