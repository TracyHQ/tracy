{
  "layout": {
    "id": "Category",
    "view": "src/views/Category.astro",
    "family": "list"
  },
  "rules": [
    [
      "cat-title",
      ".es-cat:not([data-by=\"author\"]) .es-cat-title",
      "category/category-style-1/index.html"
    ],
    [
      "cat-count",
      ".es-cat-count",
      "category/category-style-1/index.html"
    ],
    [
      "cat-desc",
      ".es-cat-desc",
      "category/category-style-1/index.html"
    ],
    [
      "side-title",
      ".es-side-title",
      "detail/layout-1/index.html"
    ],
    [
      "newsletter-title",
      "#es-newsletter-title",
      "detail/layout-1/index.html"
    ],
    [
      "newsletter-text",
      ".es-newsletter-text, .es-newsletter-status",
      "detail/layout-1/index.html"
    ],
    [
      "grid-card-title",
      ".es-cat:not([data-by=\"author\"]) .es-grid-card:not(.is-wide) .es-card-title",
      "category/category-style-1/index.html",
      true
    ],
    [
      "wide-card-title",
      ".es-grid-card.is-wide .es-card-title",
      "category/category-style-1/index.html",
      true
    ],
    [
      "author-title",
      ".es-cat[data-by=\"author\"] .es-cat-title",
      "category/category-style-1/index.html",
      true
    ],
    [
      "author-card-title",
      ".es-cat[data-by=\"author\"] .es-grid-card .es-card-title",
      "category/category-style-1/index.html",
      true
    ]
  ],
  "parity": {
    "catTitle": {
      "site": ".es-cat-title",
      "source": "h1.page-subtitle"
    },
    "catCard": {
      "site": ".es-card-title",
      "source": ".page-header h2"
    },
    "authorHeading": {
      "site": ".es-cat-title",
      "source": ".author-name"
    }
  },
  "pages": [
    {
      "id": "en-cat-grid",
      "path": "/category/blog-health",
      "source": [
        "category/category-style-1/index.html"
      ],
      "identity": ".es-cat-title",
      "collections": [
        "chrome",
        "posts",
        "pages",
        "authors",
        "social"
      ],
      "rules": [
        "cat-title",
        "cat-count",
        "cat-desc",
        "grid-card-title",
        "page-count"
      ],
      "parity": [
        "nav",
        "catTitle",
        "catCard",
        "ground"
      ],
      "content": [
        [
          "title",
          ".es-cat-title",
          "category/category-style-1/index.html",
          "derived",
          "categories.title (list heading)",
          "Health"
        ],
        [
          "card1",
          ".es-card-title",
          "category/category-style-1/index.html",
          "derived",
          "posts, first of the category",
          "Capturing Essence: Expressive Line Art Techniques"
        ],
        [
          "pager",
          ".es-page-count",
          "category/category-style-1/index.html",
          "derived",
          "template word (page counter)",
          "Page 1 of 2"
        ]
      ],
      "images": "placeholders"
    },
    {
      "id": "en-cat-stack",
