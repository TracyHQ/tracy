{
  "_note": "Forms plugin definitions: the contact form (Name, Email, Subject, Your message, 'Send a copy to yourself') and the newsletter box (one email + consent), both stored by the Forms plugin only. The visible words come from the `contact` entry (contact-layout) and the `chrome` entry; the labels here are the field definitions the plugin validates against. Created by tools/seed-apply.mjs forms; ids are bound by template.config.json forms.bindings. The plugin sends no copy to the sender: the checkbox is stored with the submission.",
  "forms": [
    {
      "name": "Contact form (EN)",
      "slug": "contact-en",
      "pages": [
        {
          "fields": [
            { "id": "name-en", "type": "text", "label": "Name", "name": "name", "required": true, "width": "full", "placeholder": "Name" },
            { "id": "email-en", "type": "email", "label": "Email", "name": "email", "required": true, "width": "full", "placeholder": "Mail" },
            { "id": "subject-en", "type": "text", "label": "Subject", "name": "subject", "required": true, "width": "full", "placeholder": "Subject" },
            { "id": "message-en", "type": "textarea", "label": "Your message", "name": "message", "required": false, "width": "full", "placeholder": "Message" },
            { "id": "copy-en", "type": "checkbox", "label": "Send a copy to yourself", "name": "copy", "required": false, "width": "full", "defaultValue": "true" }
          ]
        }
      ],
      "settings": {
        "confirmationMessage": "Thank you for your email.",
        "notifyEmails": ["hello@ja-essence.example"],
        "digestEnabled": false,
        "spamProtection": "honeypot",
        "submitLabel": "Send message",
        "retentionDays": 0
      }
    },
    {
      "name": "Subscribe (EN)",
      "slug": "subscribe-en",
      "pages": [
        {
          "fields": [
            { "id": "email-en", "type": "email", "label": "Email", "name": "email", "required": true, "width": "full", "placeholder": "Email" },
            { "id": "consent-en", "type": "checkbox", "label": "I agree with the Terms and conditions and the Privacy policy", "name": "consent", "required": true, "width": "full", "defaultValue": "true" }
          ]
        }
      ],
      "settings": {
        "confirmationMessage": "Thank you for your submission.",
        "notifyEmails": ["hello@ja-essence.example"],
        "digestEnabled": false,
        "spamProtection": "honeypot",
        "submitLabel": "Sign up",
        "retentionDays": 0
      }
    }
  ]
}
