---
/** Glyphs of the page chrome as inline SVG (Phosphor, MIT, rendered on the server): the contact row, the menu button, the arrows, the networks. */
import { createElement } from 'react'
import * as Phosphor from '@phosphor-icons/react/dist/ssr'

interface Props {
  name: string
  size?: number
  weight?: 'regular' | 'fill' | 'bold' | 'light'
  class?: string
}
const { name, size = 16, weight = 'fill', class: cls = '' } = Astro.props
const BY_NAME: Record<string, string> = {
  phone: 'Phone',
  envelope: 'Envelope',
  bars: 'List',
  'caret-right': 'CaretRight',
  'caret-left': 'CaretLeft',
  close: 'X',
  facebook: 'FacebookLogo',
  twitter: 'TwitterLogo',
  x: 'XLogo',
  instagram: 'InstagramLogo',
  linkedin: 'LinkedinLogo',
  youtube: 'YoutubeLogo',
  rss: 'RssSimple',
  link: 'Link'
}
const solidEnvelope = name === 'envelope' && weight === 'fill'
const Glyph = (Phosphor as unknown as Record<string, any>)[BY_NAME[name] ?? 'Link']
---

{solidEnvelope ? (
  <svg class={cls || undefined} xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><defs><mask id="nv-envelope-flap"><rect width="16" height="16" fill="#fff" /><path d="M2 4.6 8 9.2 14 4.6" fill="none" stroke="#000" stroke-width="1.3" /></mask></defs><rect x="1" y="3" width="14" height="10" rx="1.6" mask="url(#nv-envelope-flap)" /></svg>
) : (
<Fragment set:html={(await import('react-dom/server')).renderToStaticMarkup(createElement(Glyph, { size, weight, 'aria-hidden': true, className: cls || undefined }))} />
)}
