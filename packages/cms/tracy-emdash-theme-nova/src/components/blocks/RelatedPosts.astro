---
/** "Related Posts" under a blog article (source `mod_related_items` default): three other articles as cards. */
import type { Chrome } from '@/lib/chrome'
import { href } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { postPath } from '@/lib/posts'
import { stampFor } from '@/lib/stamps'
import { cut, introOf, loadPostsInOrder } from '@/components/site/nova-posts'

interface Props {
  chrome: Chrome
  category?: string
  postSlug?: string
}
const { chrome, postSlug } = Astro.props
const locale = chrome.locale
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const list = (await loadPostsInOrder(locale)).filter((p) => p.kind !== 'project' && p.slug !== postSlug)
// the newest three, as the source's module lists them
const items = list.slice(0, 3)
---

{items.length > 0 && (
	<section class="nv-related nv-sec nv-band nv-pt-l nv-pb-l">
		<div class="nv-ct">
			<div class="nv-sec-title"><span class="nv-sec-h" {...$c('related_title')}>{chrome.site.related_title}</span></div>
			<div class="nv-related-grid">
				{items.map((p) => {
					const $p = stampFor(Astro.request, 'posts', { id: p.id, slug: p.slug })
					const src = mediaUrl(p.cover)
					return (
						<article class="nv-related-item" {...$p()}>
							{src && <a class="nv-related-pic" href={href(locale, postPath(p))} tabindex="-1" aria-hidden="true" {...$p('cover')}><img src={src} alt="" width={p.cover?.width ?? 793} height={p.cover?.height ?? 561} loading="lazy" decoding="async" /></a>}
							<h4 class="nv-related-title"><a href={href(locale, postPath(p))} {...$p('title')}>{p.title}</a></h4>
							<p class="nv-related-intro">{cut(introOf(p), 150)}</p>
						</article>
					)
				})}
			</div>
		</div>
	</section>
)}
