{
  "_note": "Forms plugin definitions: the contact form of the Contact page (Full name, Your email, Your phone, Your subject, Message), stored by the Forms plugin and mailed to the notification address. The visible words come from the `contact` entry (contact-layout); the labels here are the field definitions the plugin validates against. Created by tools/seed-apply.mjs forms; the id is bound by template.config.json forms.bindings.",
  "forms": [
    {
      "name": "Contact form (EN)",
      "slug": "contact-en",
      "pages": [
        {
          "fields": [
            {
              "id": "name-en",
              "type": "text",
              "label": "Full name",
              "name": "name",
              "required": true,
              "width": "half",
              "placeholder": "Full name"
            },
            {
              "id": "email-en",
              "type": "email",
              "label": "Your email",
              "name": "email",
              "required": true,
              "width": "half",
              "placeholder": "Your email"
            },
            {
              "id": "phone-en",
              "type": "text",
              "label": "Your phone",
              "name": "phone",
              "required": false,
              "width": "half",
              "placeholder": "Your phone"
            },
            {
              "id": "subject-en",
              "type": "text",
              "label": "Your subject",
              "name": "subject",
              "required": true,
              "width": "half",
              "placeholder": "Your subject"
            },
            {
              "id": "message-en",
              "type": "textarea",
              "label": "Message",
              "name": "message",
              "required": true,
              "width": "full",
              "placeholder": "Message"
            }
          ]
        }
      ],
      "settings": {
        "confirmationMessage": "Thank you for your message.",
        "notifyEmails": ["hello@ja-nova.example"],
        "digestEnabled": false,
        "spamProtection": "honeypot",
        "submitLabel": "Send your request",
        "retentionDays": 0
      }
    }
  ]
}
