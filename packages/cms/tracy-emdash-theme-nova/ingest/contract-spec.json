{
  "$comment": "Decisions for ingest/build-contract.mjs: which pages, which roles, which strings. Numbers are not here: they are measured on the SOURCE (live Joomla) into ingest/source-measures.json.",
  "variants": ["1440-light", "1440-dark", "390-light", "390-dark"],
  "base": ["body-type", "header", "nav-link", "footer", "footer-title"],
  "roles": [
    ["body-type", "body", "body", ["font-family", "font-size", "font-weight", "line-height", "color", "background-color"]],
    ["header", ".nv-header", "header.header-block", ["background-color", "color"]],
    ["nav-link", ".nv-nav > ul > li:not(.is-active) > a:not(:hover)", ".t4-megamenu .navbar-nav > li.nav-item:not(.active):not(.current) > a.nav-link:not(:hover)", ["font-size", "font-weight", "letter-spacing", "text-transform", "color"], true],
    ["footer", ".nv-footer", "#t4-footer", ["font-size", "color", "background-color"]],
    ["footer-title", ".nv-footer-title", "#t4-footer .module-title", ["font-size", "font-weight", "line-height", "color"]],
    ["hero-title", ".nv-hero-title", ".hero-title"],
    ["h2-info", ".nv-info-title h2", ".info-title h2"],
    ["cta-title", ".nv-cta-title", "h2.cta-title"],
    ["cta-line", ".nv-cta-line", ".cta-desc h2"],
    ["h3-item", ".nv-item-inner h3", ".item-inner h3"],
    ["h4-team", ".nv-teams-name", ".teams-text h4"],
    ["h4-item", ".nv-item-inner h4", ".item-inner h4"],
    ["btn-primary", ".nv-btn-primary:not(:hover), .nv-blk-btn.is-primary:not(:hover)", ".btn.btn-primary:not(:hover)", ["font-size", "font-weight", "line-height", "color", "background-color", "border-top-left-radius", "padding-top", "padding-left"]],
    ["btn-light", ".nv-btn-light:not(:hover), .nv-btn.is-light:not(:hover), .nv-blk-btn.is-light:not(:hover)", ".btn.btn-light:not(:hover)", ["font-size", "font-weight", "line-height", "color", "background-color", "border-top-left-radius", "padding-top", "padding-left"]],
    ["page-h1", "main h1:not(.sr-only):not(.nv-hero-title):not(.nv-list-sub):not(.nv-contact-h1)", "h1:not(.visually-hidden):not(.hero-title):not(.page-subtitle):not(.cta-title)"],
    ["list-sub", "h1.nv-list-sub", "h1.page-subtitle"],
    ["card-title", ".nv-card-title", "h2.item-title, .items-leading h2, .items-row h2, .blog-items h2"],
    ["err-code", ".nv-err-code", ".error-code"],
    ["err-msg", ".nv-err-msg h1", ".error-msg h2"]
  ],
  "pages": [
    { "id": "home", "path": "/", "src": "/", "roles": ["hero-title", "h2-info", "cta-title", "btn-primary", "btn-light"], "identity": ".nv-hero-title" },
    { "id": "about", "path": "/about", "src": "/about-us-2", "roles": ["h2-info", "h3-item", "h4-team", "cta-line"] },
    { "id": "career", "path": "/career", "src": "/about-us-2/career", "roles": ["btn-primary", "cta-line"] },
    { "id": "contact", "path": "/contact", "src": "/about-us-2/contact", "roles": ["cta-line"] },
    { "id": "services", "path": "/services", "src": "/services", "roles": ["h2-info", "h4-item", "cta-line"] },
    { "id": "svc-illustration", "path": "/illustration", "src": "/illustration", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-development", "path": "/development", "src": "/development", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-mobile-application", "path": "/mobile-application", "src": "/mobile-application", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-cloud-solutions", "path": "/cloud-solutions", "src": "/cloud-solutions", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-it-infrastructure", "path": "/it-infrastructure", "src": "/it-infrastructure", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-cybersecurity", "path": "/cybersecurity", "src": "/cybersecurity", "roles": ["page-h1", "cta-line"] },
    { "id": "svc-virtualization", "path": "/virtualization", "src": "/virtualization", "roles": ["page-h1", "cta-line"] },
    { "id": "project", "path": "/project", "src": "/project", "roles": ["cta-line"] },
    { "id": "project-illustration", "path": "/project/illustration", "src": "/project/illustration", "roles": ["page-h1", "cta-line"] },
    { "id": "project-branding", "path": "/project/branding", "src": "/project/branding", "roles": ["page-h1", "cta-line"] },
    { "id": "project-ui-ux-design", "path": "/project/ui-ux-design", "src": "/project/ui-ux-design", "roles": ["page-h1", "cta-line"] },
    { "id": "project-detail", "path": "/project/illustration/packaging-design", "src": "/project/illustration/packaging-design", "roles": ["page-h1", "cta-line"] },
    { "id": "blog", "path": "/blog", "src": "/category-blog", "roles": ["list-sub", "cta-line"] },
    { "id": "post", "path": "/blog/how-business-technology-changed-how-we-think-about-death", "src": "/category-blog/how-business-technology-changed-how-we-think-about-death", "roles": ["page-h1", "cta-line"] },
    { "id": "search", "path": "/search", "src": "/smart-search", "roles": [] },
    { "id": "not-found", "path": "/404", "src": "/nope-404", "status": 404, "bare": true, "roles": ["err-code", "err-msg"] }
  ]
}
