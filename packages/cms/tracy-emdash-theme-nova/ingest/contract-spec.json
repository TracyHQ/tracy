{
  "$comment": "Decisions for ingest/build-contract.mjs: which pages, which roles, which strings. Numbers are not here: they are measured on the SOURCE (live Joomla) into ingest/source-measures.json.",
  "variants": ["1440-light", "1440-dark", "390-light", "390-dark"],
  "base": ["body-type", "header", "nav-link", "footer", "footer-title"],
  "roles": [
    [
      "body-type",
      "body",
      "body",
      ["font-family", "font-size", "font-weight", "line-height", "color", "background-color"]
    ],
    ["header", ".nv-header", "header.header-block", ["background-color", "color"]],
    [
      "nav-link",
      ".nv-nav > ul > li:not(.is-active):not(.has-sub) > a:not(:hover)",
      ".t4-megamenu .navbar-nav > li.nav-item:not(.active):not(.current) > a.nav-link:not(:hover)",
      ["font-size", "font-weight", "letter-spacing", "text-transform", "color"],
      true
    ],
    ["footer", ".nv-footer", "#t4-footer", ["font-size", "color", "background-color"]],
    [
      "footer-title",
      ".nv-footer-title",
      "#t4-footer .module-title",
      ["font-size", "font-weight", "line-height", "color"]
    ],
    [
      "hero-title",
      ".nv-hero-title",
      ".hero-title",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "h2-info",
      ".nv-info-title h2",
      ".info-title h2",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "cta-title",
      ".nv-cta-title",
      "h2.cta-title",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "cta-line",
      ".nv-cta-line",
      ".cta-desc",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "h3-item",
      ".nv-item-inner h3",
      ".item-inner h3",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "h4-team",
      ".nv-teams-name",
      ".teams-text h4",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "h4-item",
      ".nv-item-inner h4",
      ".item-inner h4",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "btn-primary",
      ".nv-btn-primary:not(:hover), .nv-blk-btn.is-primary:not(:hover)",
      ".btn.btn-primary:not(:hover)",
      [
        "font-size",
        "font-weight",
        "line-height",
        "color",
        "background-color",
        "border-top-left-radius",
        "padding-top",
        "padding-left"
      ]
    ],
    [
      "btn-light",
      ".nv-btn-light:not(:hover), .nv-btn.is-light:not(:hover), .nv-blk-btn.is-light:not(:hover)",
      ".btn.btn-light:not(:hover)",
      [
        "font-size",
        "font-weight",
        "line-height",
        "color",
        "background-color",
        "border-top-left-radius",
        "padding-top",
        "padding-left"
      ]
    ],
    [
      "page-h1",
      "main h1:not(.sr-only):not(.nv-hero-title):not(.nv-list-sub):not(.nv-contact-h1):not(.nv-list-h1)",
      ".page-header h1",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "list-sub",
      "h1.nv-list-sub",
      "h1.page-subtitle",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "card-title",
      ".nv-card-title",
      "h2.item-title, .items-leading h2, .items-row h2, .blog-items h2",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "err-code",
      ".nv-err-code",
      ".error-code",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform", "color"]
    ],
    [
      "err-msg",
      ".nv-err-msg h1",
      ".error-msg h2",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform", "color"]
    ],
    [
      "list-h1",
      "h1.nv-list-h1",
      ".com-content-category-blog.type-project h1",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ],
    [
      "contact-h1",
      "h1.nv-contact-h1",
      ".contact h1",
      ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform"]
    ]
  ],
  "pages": [
    {
      "id": "home",
      "path": "/",
      "src": "/",
      "roles": ["hero-title", "h2-info", "cta-title", "btn-primary", "btn-light"],
      "identity": ".nv-hero-title",
      "content": [
        ["hero", ".nv-hero-title", ".hero-title", "field", "home hero block title"],
        ["cta-title", ".nv-cta-title", "h2.cta-title", "field", "home cta block title"],
        ["info", ".nv-info-title h2", ".info-title h2", "field", "home info block title"],
        ["btn-primary", ".nv-btn-primary", ".btn.btn-primary", "field", "home hero button label"]
      ]
    },
    {
      "id": "about",
      "path": "/about",
      "src": "/about-us-2",
      "roles": ["h2-info", "h3-item", "h4-team", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["info", ".nv-info-title h2", ".info-title h2", "field", "about info block title"],
        ["team-1", ".nv-teams-name", ".teams-text h4", "field", "about team block, first member"]
      ]
    },
    {
      "id": "career",
      "path": "/career",
      "src": "/about-us-2/career",
      "roles": ["btn-primary", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["show-more", ".nv-show-more", ".show-more", "setting", "chrome label: show more"]
      ]
    },
    {
      "id": "contact",
      "path": "/contact",
      "src": "/about-us-2/contact",
      "roles": ["contact-h1", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["title", ".nv-contact-title", "h2", "field", "contact block title"]
      ]
    },
    {
      "id": "services",
      "path": "/services",
      "src": "/services",
      "roles": ["h2-info", "h4-item", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["info", ".nv-info-title h2", ".info-title h2", "field", "services info block title"],
        ["item-1", ".nv-item-inner h4", ".item-inner h4", "field", "services features block, first item"]
      ]
    },
    {
      "id": "svc-illustration",
      "path": "/illustration",
      "src": "/illustration",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-development",
      "path": "/development",
      "src": "/development",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-mobile-application",
      "path": "/mobile-application",
      "src": "/mobile-application",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-cloud-solutions",
      "path": "/cloud-solutions",
      "src": "/cloud-solutions",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-it-infrastructure",
      "path": "/it-infrastructure",
      "src": "/it-infrastructure",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-cybersecurity",
      "path": "/cybersecurity",
      "src": "/cybersecurity",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "svc-virtualization",
      "path": "/virtualization",
      "src": "/virtualization",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "project",
      "path": "/project",
      "src": "/project",
      "roles": ["cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "project-illustration",
      "path": "/project/illustration",
      "src": "/project/illustration",
      "roles": ["list-h1", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["card-1", ".nv-card-title", "h2", "derived", "posts of the category"]
      ]
    },
    {
      "id": "project-branding",
      "path": "/project/branding",
      "src": "/project/branding",
      "roles": ["list-h1", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["card-1", ".nv-card-title", "h2", "derived", "posts of the category"]
      ]
    },
    {
      "id": "project-ui-ux-design",
      "path": "/project/ui-ux-design",
      "src": "/project/ui-ux-design",
      "roles": ["list-h1", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["card-1", ".nv-card-title", "h2", "derived", "posts of the category"]
      ]
    },
    {
      "id": "project-detail",
      "path": "/project/illustration/packaging-design",
      "src": "/project/illustration/packaging-design",
      "roles": ["page-h1", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["title", "h2.is-h1", "h2.h1", "field", "project title"]
      ]
    },
    {
      "id": "blog",
      "path": "/blog",
      "src": "/category-blog",
      "roles": ["list-sub", "cta-line"],
      "content": [
        ["h1", "h1", "h1", "field", "the page title (h1)"],
        ["card-1", ".nv-card-title", "h2", "derived", "posts, newest first"]
      ]
    },
    {
      "id": "post",
      "path": "/blog/how-business-technology-changed-how-we-think-about-death",
      "src": "/category-blog/how-business-technology-changed-how-we-think-about-death",
      "roles": ["page-h1", "cta-line"],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "search",
      "path": "/search",
      "src": "/smart-search",
      "roles": [],
      "content": [["h1", "h1", "h1", "field", "the page title (h1)"]]
    },
    {
      "id": "not-found",
      "path": "/404",
      "src": "/nope-404",
      "status": 404,
      "bare": true,
      "roles": ["err-code", "err-msg"],
      "content": [
        ["code", ".nv-err-code", ".error-code", "static", "template word"],
        ["title", ".nv-err-msg h1", ".error-msg h2", "static", "template word"],
        ["text", ".nv-err-other p", ".error-other-info p", "static", "template word"],
        ["back", ".nv-err-redirect a", ".page-redirect a", "static", "template word"]
      ]
    }
  ],
  "exceptions": [
    {
      "kind": "scan:contrast",
      "match": "nv-hl-(cyan|green|yellow|orange)",
      "reason": "Source does the same. Measured on the live source, page / (home), 1440 wide, light theme, getComputedStyle: .text-cyan 'investigation' rgb(45,195,245) on rgb(94,72,219) = 2.99; .text-cyan '36k' on rgb(247,247,247) = 1.92; .text-green '1200+' rgb(4,173,104) on rgb(230,246,240) = 2.62; .text-green 'We make' on white = 2.92; .text-yellow 'Share' rgb(248,171,17) on rgb(239,237,252) = 1.68; .text-orange '119' rgb(253,126,20) on rgb(247,247,247) = 2.40. Same colours on the same grounds on the site.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-pricing-price",
      "reason": "Source does the same. Live source, page / (home), 1440, light: .pricing-plan-price h2.text-yellow '$19.50' (and $29.50, $59.50) colour rgb(248,171,17) on rgb(247,247,247) = 1.81.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-sec-h",
      "reason": "Source does the same. Live source, page / (home), 1440, light: .bg-green .main-title 'Latest news from us' colour rgb(255,255,255) on rgb(4,173,104) = 2.92.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-teams-desc",
      "reason": "Source does the same. Live source, page / (home), 1440, light: .teams-desc h2 'This is why industry...' colour rgb(255,255,255) on rgb(248,171,17) = 1.94.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-contact-(label|hl)",
      "reason": "Source does the same. Live source, page /about-us-2/contact, 1440, light: '.title h3' span 'Phone' rgb(4,173,104) on rgb(247,247,247) = 2.73; span.text-green 'from you' (the contact lead) rgb(4,173,104) on white = 2.92.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-latest-intro|^a\\.$",
      "reason": "Source does the same. Live source, page / (home), 1440, light: .item-introtext colour rgba(255,255,255,0.75) over .item-inner rgba(0,0,0,0.7) laid on the card picture; the scan reads only the white page behind the picture (ratio 1). Same white over the same picture on the site.",
      "decision": "D15"
    },
    {
      "kind": "scan:contrast",
      "match": "nv-news-date",
      "reason": "Source does the same (lead decision L7, no colour change). Live source, page / (home), 1440, light: .item-date '11 July 2023' colour rgb(239,56,103) over .item-inner rgba(0,0,0,0.7) on the card photo (3.87 against plain white, which is all the scan sees behind the picture); the site's .nv-news-date measures rgb(239,56,103) on the same overlay and photo.",
      "decision": "L7"
    },
    {
      "kind": "scan:bright-border",
      "match": "nv-btn|nv-blk-btn|nv-pricing-tab|ec-form-submit",
      "reason": "Source does the same. Live source, page / (home), 1440, dark theme (?theme=dark): .btn.btn-primary 'Get started' border 1px rgb(94,72,219) on fill rgb(94,72,219) (invisible against its own fill); the active pricing tab 'Basic Plan' has border 1px rgb(94,72,219) on fill rgb(38,44,54), text rgb(157,140,255).",
      "decision": "D18"
    }
  ]
}
