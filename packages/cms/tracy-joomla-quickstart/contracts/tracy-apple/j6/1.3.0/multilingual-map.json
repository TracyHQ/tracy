  "unsupported": [
    {
      "scope": "category",
      "effect": "Category titles and descriptions stay in the source language wherever Joomla renders them directly: breadcrumbs on a category route, and the section list of the Magazine sidebar module.",
      "reason": "The published 1.1.0 contract exposes no category content slot, and the receiver cannot set a category alias on create — a translated category would take a generated alias and move every derived article into a tree whose ordering and ACL the base contract does not describe"
    },
    {
      "scope": "menu:tracy-utility",
      "effect": "The utility menu Joomla ships for account, contact and newsfeed routes is outside the contract inventory. Those routes keep one menu item for every language; their component views translate themselves from the installed language pack, but the menu item titles stay in the source language. No module renders this menu, so the titles are not on a page.",
      "reason": "Not identified by the published 1.1.0 contract, which covers the `tracy` menu only"
    },
    {
      "scope": "article:archived",
      "effect": "Archived articles keep their state and get no translation.",
      "reason": "Not identified by the published 1.1.0 contract, which covers published articles only"
    },
    {
      "scope": "acm-layout-defaults",
      "effect": "Copy written into a template ACM layout as the fallback for an empty module parameter renders in the source language on every page, translated or not. Measured 12/09/2026 on the Apple quickstart home page: 33 of 180 visible lines, among them the three feature cards and the four statistic labels.",
      "reason": "These strings are not content slots in the published 1.1.0 contract — grep the content map and they are absent — so they cannot be edited in the SOURCE language either. They live in `templates/tracy/acm/*/tmpl/style-1.php`, which the presentation lock hash-locks as design. Reaching them is a change to the contract or to the template, not to this extension."
    },
    {
      "scope": "text-in-images",
      "effect": "Words baked into an image stay in the source language.",
      "reason": "The contract carries image paths, not image content, and Tracy does not redraw customer artwork"
    },
    {
      "scope": "menuItem:type=url",
      "effect": "A menu item linking to a raw site path keeps that path. When the path names a source-language route the switcher still reaches the source page.",
      "reason": "A raw path is not an entity reference the receiver can remap with proof"
    }
  ],
  "counts": {
    "translate": 173,
    "shared": 25,
    "total": 198
  }
