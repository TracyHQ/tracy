	<!-- T4 merges subgroup="1" fieldsets into the matching base group of the Site settings -->
	<site>
		<fields name="typelist-site">
			<!-- Dark-mode logos (appended to the "Logo" settings group; printed by html/layouts/t4/element/logo.php) -->
