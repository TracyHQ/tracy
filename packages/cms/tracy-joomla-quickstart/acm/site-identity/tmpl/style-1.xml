<field name="address" type="textarea" label="TPL_TRACY_IDENTITY_ADDRESS" default="" />
<field name="hours" type="text" label="TPL_TRACY_IDENTITY_HOURS" default="" />
</fieldset>
<fieldset name="social" label="TPL_TRACY_IDENTITY_SOCIAL">
<field name="facebook" type="url" label="Facebook" default="" />
<field name="instagram" type="url" label="Instagram" default="" />
