---
/** The Paper-2 crumb band: Home / Section / Current. Absent on home, search, 404, style guide. */
import type { Attrs } from '@/lib/stamps'

interface Props {
  /** `stamp`: the provenance stamp of the field the label comes from (`src/lib/stamps.ts`). */
  items: Array<{ label: string; url?: string; stamp?: Attrs }>
}
const { items } = Astro.props
---

<nav class="breadcrumb" aria-label="Breadcrumb">
	<div class="container-site flex flex-wrap items-center py-3.5">
		{items.map((it, i) => (
			<>
				{i > 0 && <span class="sep" aria-hidden="true">/</span>}
				{it.url ? <a href={it.url} {...it.stamp}>{it.label}</a> : <span class="current" aria-current="page" {...it.stamp}>{it.label}</span>}
			</>
		))}
	</div>
</nav>
