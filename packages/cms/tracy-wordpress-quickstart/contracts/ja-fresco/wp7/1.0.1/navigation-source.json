  "templateParts": [
    {
      "id": 86,
      "slug": "header",
      "theme": "wp-ja-fresco",
      "area": "header",
      "sha256": "a5877c0b42b48d94aef7e8c52bbd6e522b3bf3fcbeefea4694b7afc0bfbceae4",
      "content": "<!-- wp:group {\"tagName\":\"header\",\"className\":\"t4-header\",\"layout\":{\"type\":\"default\"}} -->\n<header class=\"wp-block-group t4-header\">\n<!-- wp:group {\"className\":\"jf-container-fluid header-wrap\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-container-fluid header-wrap\">\n<!-- wp:site-logo {\"shouldSyncIcon\":false,\"className\":\"jf-logo tracy-logo-dark\"} /-->\n<!-- wp:navigation {\"ref\":80,\"overlayMenu\":\"mobile\",\"className\":\"t4-mainnav\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} /-->\n<!-- wp:group {\"className\":\"t4-header-r\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t4-header-r\">\n<!-- wp:buttons {\"className\":\"jf-book-open\"} -->\n<div class=\"wp-block-buttons jf-book-open\"><!-- wp:button {\"className\":\"btn-primary\"} -->\n<div class=\"wp-block-button btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"#jf-book-table\"><span class=\"jf-book-label\">Book Table</span></a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</header>\n<!-- /wp:group -->\n<!-- wp:group {\"anchor\":\"jf-book-table\",\"className\":\"jf-book-modal\",\"metadata\":{\"name\":\"header.book-table\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-book-modal\" id=\"jf-book-table\">\n<!-- wp:group {\"className\":\"jf-book-dialog\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-book-dialog\">\n<!-- wp:group {\"className\":\"jf-book-col jf-book-intro\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-book-col jf-book-intro\">\n<!-- wp:heading {\"className\":\"book-title\"} -->\n<h2 class=\"wp-block-heading book-title\">Book Table</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"book-desc\"} -->\n<p class=\"book-desc\">Book a table or just come along - we save space in every restaurant for walk-ins.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jf-book-col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-book-col\">\n<!-- wp:heading {\"level\":3,\"className\":\"book-phone-title\"} -->\n<h3 class=\"wp-block-heading book-phone-title\">Book via phone</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"book-phone\"} -->\n<p class=\"book-phone\"><a href=\"tel:+983 3839 493\">+983 3839 493</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"className\":\"book-order-title\"} -->\n<h3 class=\"wp-block-heading book-order-title\">Book via OpenTable</h3>\n<!-- /wp:heading -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"btn-outline-primary\"} -->\n<div class=\"wp-block-button btn-outline-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact\">Book Table</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
    },
    {
      "id": 87,
      "slug": "footer",
      "theme": "wp-ja-fresco",
      "area": "footer",
      "sha256": "06aa4ca97f146b087e6af66e5448e53931595f5dabeec1cc14c3f633e074caab",
      "content": "<!-- wp:group {\"tagName\":\"footer\",\"className\":\"t4-footer\",\"layout\":{\"type\":\"default\"}} -->\n<footer class=\"wp-block-group t4-footer\">\n<!-- wp:group {\"className\":\"jf-container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-container\">\n<!-- wp:group {\"className\":\"jf-footnav\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-footnav\">\n<!-- wp:group {\"className\":\"jf-foot-col\",\"metadata\":{\"name\":\"footer.welcome\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-foot-col\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Welcome to Fresco</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Fresco, founded in 2022, is dedicated to all those who love to wander far and wide.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p>We'd like to invite you on a culinary adventure, where you’ll explore undiscovered gourmet experiences.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jf-foot-col\",\"metadata\":{\"name\":\"footer.visit\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-foot-col\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Visit</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>317 Pacific C Hwy Huntington, CA 92648</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><a href=\"tel:+0000\">123.456-7</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><a href=\"mailto:no-reply@fresco.com\">no-reply@fresco.com</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jf-foot-col\",\"metadata\":{\"name\":\"footer.reservations\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-foot-col\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Reservations</h3>\n<!-- /wp:heading -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"btn-outline-light\"} -->\n<div class=\"wp-block-button btn-outline-light\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact\">Book you table</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- wp:heading {\"level\":3,\"className\":\"module-title jf-foot-hours\"} -->\n<h3 class=\"wp-block-heading module-title jf-foot-hours\">Hours</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>MONDAY thru FRIDAY<br>11am - 9pm</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p>SATURDAY/SUNDAY<br>10am - 11pm</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jf-foot-col\",\"metadata\":{\"name\":\"footer.about\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jf-foot-col\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">About</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":81,\"overlayMenu\":\"never\",\"className\":\"jf-foot-menu\",\"metadata\":{\"name\":\"nav.about\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"copyright\"} -->\n<p class=\"copyright\">Copyright © {year} {site.title}. All Rights Reserved.<br>Released under the <a href=\"https://www.gnu.org/licenses/gpl-2.0.html\">GNU General Public License.</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</footer>\n<!-- /wp:group -->\n"
    }
