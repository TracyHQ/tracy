      "content": "<!-- wp:group {\"tagName\":\"nav\",\"anchor\":\"t3-mainnav\",\"className\":\"wrap navbar navbar-default t3-mainnav\"} -->\n<nav class=\"wp-block-group wrap navbar navbar-default t3-mainnav\" id=\"t3-mainnav\">\n<!-- wp:group {\"className\":\"container-inner\"} -->\n<div class=\"wp-block-group container-inner\">\n<!-- wp:group {\"className\":\"navbar-header\"} -->\n<div class=\"wp-block-group navbar-header\">\n<!-- wp:html -->\n<button type=\"button\" class=\"btn btn-primary off-canvas-toggle\" aria-controls=\"jm-off-canvas\" aria-expanded=\"false\" aria-label=\"Open the menu\"><i class=\"fa fa-bars\" aria-hidden=\"true\"></i></button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"t3-navbar\"} -->\n<div class=\"wp-block-group t3-navbar\">\n<!-- wp:navigation {\"ref\":93,\"overlayMenu\":\"never\",\"className\":\"jd-mainmenu\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\"}} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:html -->\n<button type=\"button\" class=\"theme-toggle\" data-tracy-theme-toggle aria-pressed=\"false\" aria-label=\"Theme: light. Switch to dark\"><svg class=\"theme-toggle__moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"theme-toggle__sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</nav>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"header\",\"anchor\":\"t3-header\",\"className\":\"container t3-header\"} -->\n<header class=\"wp-block-group container t3-header\" id=\"t3-header\">\n<!-- wp:group {\"className\":\"row\"} -->\n<div class=\"wp-block-group row\">\n<!-- wp:group {\"className\":\"col-xs-12 col-sm-12 logo\"} -->\n<div class=\"wp-block-group col-xs-12 col-sm-12 logo\">\n<!-- wp:group {\"className\":\"logo-image\"} -->\n<div class=\"wp-block-group logo-image\">\n<!-- wp:site-logo {\"width\":128,\"shouldSyncIcon\":false,\"className\":\"jd-logo jd-logo--light\"} /-->\n<!-- wp:site-logo {\"width\":128,\"shouldSyncIcon\":false,\"className\":\"jd-logo jd-logo--dark\"} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</header>\n<!-- /wp:group -->\n<!-- wp:group {\"anchor\":\"jm-off-canvas\",\"className\":\"t3-off-canvas\"} -->\n<div class=\"wp-block-group t3-off-canvas\" id=\"jm-off-canvas\">\n<!-- wp:group {\"className\":\"t3-off-canvas-header\"} -->\n<div class=\"wp-block-group t3-off-canvas-header\">\n<!-- wp:heading {\"level\":2,\"className\":\"t3-off-canvas-header-title\"} -->\n<h2 class=\"wp-block-heading t3-off-canvas-header-title\">Sidebar</h2>\n<!-- /wp:heading -->\n<!-- wp:html -->\n<button type=\"button\" class=\"close\" aria-label=\"Close the menu\">×</button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"t3-off-canvas-body\"} -->\n<div class=\"wp-block-group t3-off-canvas-body\">\n<!-- wp:navigation {\"ref\":278,\"overlayMenu\":\"never\",\"className\":\"jm-off-canvas-nav\",\"metadata\":{\"name\":\"nav.site-pages\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
    },
    {
      "id": 97,
      "slug": "footer",
      "theme": "wp-ja-diner",
      "area": "footer",
      "sha256": "2f185767020df604060db3281accf1d619afe175d7e512087f7f5031dfa085de",
      "content": "<!-- wp:group {\"anchor\":\"t3-footer\",\"className\":\"wrap t3-footer\"} -->\n<div class=\"wp-block-group wrap t3-footer\" id=\"t3-footer\">\n<!-- wp:group {\"className\":\"container\"} -->\n<div class=\"wp-block-group container\">\n<!-- wp:group {\"className\":\"wrap-spotlight-footer\"} -->\n<div class=\"wp-block-group wrap-spotlight-footer\">\n<!-- wp:group {\"className\":\"t3-spotlight t3-footnav equal-height row\"} -->\n<div class=\"wp-block-group t3-spotlight t3-footnav equal-height row\">\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-4 col-xs-12 col\"} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-4 col-xs-12 col\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.location\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\"} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\"><span>Location.</span></h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\"} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:group {\"className\":\"mod-custom custom\"} -->\n<div class=\"wp-block-group mod-custom custom\">\n<!-- wp:paragraph {} -->\n<p><span>398 North 23th Dumbledore Street,<br>Hogsmeade Village, Britain.</span><br><a href=\"#\" title=\"Get Direction\">Get Direction <span class=\"icon ion-android-arrow-forward\" aria-hidden=\"true\"></span></a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-4 col-xs-12 col\"} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-4 col-xs-12 col\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.hours\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\"} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\"><span>Hours.</span></h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\"} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:group {\"className\":\"mod-custom custom\"} -->\n<div class=\"wp-block-group mod-custom custom\">\n<!-- wp:paragraph {} -->\n<p><span>Tuesday - Saturday: 9a.m - Close.<br>Sunday: 10a.m - Close.<br>Monday: Closed.</span></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-4 col-xs-12 col\"} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-4 col-xs-12 col\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.contact\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\"} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\"><span>Contact.</span></h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\"} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:group {\"className\":\"mod-custom custom\"} -->\n<div class=\"wp-block-group mod-custom custom\">\n<!-- wp:paragraph {} -->\n<p><span>M. +201 382 348 5327<br>P. +201 166 993 7763</span><br><a href=\"mailto:Info@joomlart.com\">Info@joomlart.com</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"section\",\"className\":\"t3-copyright\"} -->\n<section class=\"wp-block-group t3-copyright\">\n<!-- wp:group {\"className\":\"t3-copyright-inner\"} -->\n<div class=\"wp-block-group t3-copyright-inner\">\n<!-- wp:group {\"className\":\"row\"} -->\n<div class=\"wp-block-group row\">\n<!-- wp:group {\"className\":\"copyright col-sm-6\"} -->\n<div class=\"wp-block-group copyright col-sm-6\">\n<!-- wp:group {\"className\":\"module\"} -->\n<div class=\"wp-block-group module\">\n<!-- wp:paragraph {\"metadata\":{\"name\":\"footer.copyright\"}} -->\n<p><small>Copyright © {year} {site.title}. All Rights Reserved.</small></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
    }
