      "sha256": "465b8d722cb79337243cd81a0f3f76002187b844651ef9843bd02107cbf5f220",
      "content": "<!-- wp:group {\"className\":\"t3-topbar\",\"metadata\":{\"name\":\"header.topbar\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-topbar\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:list {\"className\":\"list-info topbar-left\"} -->\n<ul class=\"wp-block-list list-info topbar-left\"><!-- wp:list-item {\"className\":\"jm-icon-pin\"} -->\n<li class=\"jm-icon-pin\">312 North 24th Street Brooklyn, New York</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item {\"className\":\"jm-icon-call\"} -->\n<li class=\"jm-icon-call\">212.218.8500</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n<!-- wp:social-links {\"className\":\"list-info social topbar-right is-style-logos-only\"} -->\n<ul class=\"wp-block-social-links list-info social topbar-right is-style-logos-only\"><!-- wp:social-link {\"url\":\"#\",\"service\":\"facebook\",\"label\":\"Facebook\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"twitter\",\"label\":\"Twitter\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"instagram\",\"label\":\"Instagram\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"feed\",\"label\":\"Rss\"} /--></ul>\n<!-- /wp:social-links -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"div\",\"className\":\"t3-header\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-header\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:group {\"className\":\"jm-brand\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jm-brand\">\n<!-- wp:site-logo {\"width\":160,\"shouldSyncIcon\":false,\"className\":\"jm-logo jm-logo\\u002d\\u002dlight tracy-logo-bare\"} /-->\n<!-- wp:site-logo {\"width\":160,\"shouldSyncIcon\":false,\"className\":\"jm-logo jm-logo\\u002d\\u002ddark tracy-logo-bare\"} /-->\n<!-- wp:paragraph {\"className\":\"logo logo-text\"} -->\n<p class=\"logo logo-text\"><a href=\"/\">{site.title}<strong>.</strong></a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jm-head-info wrap-info\",\"metadata\":{\"name\":\"header.info\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jm-head-info wrap-info\">\n<!-- wp:html -->\n<ul><li><h5>Call Us:</h5><span>212.218.8500</span></li><li><h5>Email Us:</h5><a title=\"Send Mail\" href=\"mailto:inquiry@stark.com\">inquiry@stark.com</a></li><li><h5>Open Hours:</h5><span>9am-6pm / Mon-Fri</span></li></ul>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"header-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group header-inner\">\n<!-- wp:navigation {\"ref\":158,\"overlayMenu\":\"mobile\",\"className\":\"t3-mainnav\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} /-->\n<!-- wp:group {\"className\":\"headright\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group headright\">\n<!-- wp:search {\"label\":\"Search\",\"showLabel\":false,\"placeholder\":\"Search ...\",\"buttonText\":\"Search\",\"buttonPosition\":\"button-only\",\"buttonUseIcon\":true,\"isSearchFieldHidden\":true,\"className\":\"head-search\"} /-->\n<!-- wp:html -->\n<button type=\"button\" class=\"theme-toggle\" data-tracy-theme-toggle aria-pressed=\"false\" aria-label=\"Theme: light. Switch to dark\"><svg class=\"theme-toggle__moon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"theme-toggle__sun\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></button>\n<!-- /wp:html -->\n<!-- wp:html -->\n<button type=\"button\" class=\"off-canvas-toggle\" aria-controls=\"jm-off-canvas\" aria-expanded=\"false\" aria-label=\"Open the sidebar\"><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span></button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"anchor\":\"jm-off-canvas\",\"className\":\"t3-off-canvas\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas\" id=\"jm-off-canvas\">\n<!-- wp:group {\"className\":\"t3-off-canvas-header\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas-header\">\n<!-- wp:heading {\"level\":2,\"className\":\"t3-off-canvas-header-title\"} -->\n<h2 class=\"wp-block-heading t3-off-canvas-header-title\">Sidebar</h2>\n<!-- /wp:heading -->\n<!-- wp:html -->\n<button type=\"button\" class=\"close\" aria-label=\"Close the sidebar\">×</button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"t3-off-canvas-body\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas-body\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Site Pages</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":160,\"overlayMenu\":\"never\",\"className\":\"jm-off-canvas-nav\",\"metadata\":{\"name\":\"nav.joomla-pages\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
