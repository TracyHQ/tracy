      "sha256": "c603f1eeb76166d0c689cd91e6e440fd076b3b2f3c9111b9bddf46941d088a78",
      "content": "<!-- wp:group {\"className\":\"jim-footer__contact jim-band jim-band--primary\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__contact jim-band jim-band--primary\">\n<!-- wp:group {\"className\":\"jim-container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-container\">\n<!-- wp:group {\"className\":\"jim-fcontact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-fcontact\">\n<!-- wp:heading {\"level\":2,\"className\":\"jim-fcontact__heading\"} -->\n<h2 class=\"wp-block-heading jim-fcontact__heading\">Our team of qualified plumbers is ready and always available, anytime, anywhere.</h2>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"jim-fcontact__items\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-fcontact__items\">\n<!-- wp:group {\"className\":\"jim-fcontact__item\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-fcontact__item\">\n<!-- wp:paragraph {\"className\":\"jim-fcontact__sub\"} -->\n<p class=\"jim-fcontact__sub\">Email us</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-fcontact__title\"} -->\n<p class=\"jim-fcontact__title\"><a href=\"mailto:helpus24@gmail.com\">helpus24@gmail.com</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-fcontact__item\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-fcontact__item\">\n<!-- wp:paragraph {\"className\":\"jim-fcontact__sub\"} -->\n<p class=\"jim-fcontact__sub\">Our address</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-fcontact__title\"} -->\n<p class=\"jim-fcontact__title\">Melbourne, Australia</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-fcontact__item\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-fcontact__item\">\n<!-- wp:paragraph {\"className\":\"jim-fcontact__sub\"} -->\n<p class=\"jim-fcontact__sub\">Support 24/7</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-fcontact__title\"} -->\n<p class=\"jim-fcontact__title\">1 800 458 56 97</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__nav jim-band jim-band\\u002d\\u002dprimary\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__nav jim-band jim-band--primary\">\n<!-- wp:group {\"className\":\"jim-container jim-footer__cols\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-container jim-footer__cols\">\n<!-- wp:group {\"className\":\"jim-footer__col jim-footer__col\\u002d\\u002dabout\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__col jim-footer__col--about\">\n<!-- wp:site-logo {\"width\":210,\"shouldSyncIcon\":false,\"className\":\"jim-footer__logo tracy-logo-dark\"} /-->\n<!-- wp:paragraph {\"className\":\"jim-footer__about\"} -->\n<p class=\"jim-footer__about\">As the city’s largest and longest-running shelter, Philly House provides a safe, clean refuge off the streets along</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__col\">\n<!-- wp:heading {\"level\":3,\"className\":\"jim-footer__title\"} -->\n<h3 class=\"wp-block-heading jim-footer__title\">Get to know us</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":185,\"overlayMenu\":\"never\",\"className\":\"jim-footnav\",\"metadata\":{\"name\":\"nav.get-to-know-us\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__col\">\n<!-- wp:heading {\"level\":3,\"className\":\"jim-footer__title\"} -->\n<h3 class=\"wp-block-heading jim-footer__title\">Guide</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":184,\"overlayMenu\":\"never\",\"className\":\"jim-footnav\",\"metadata\":{\"name\":\"nav.guide\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__col\">\n<!-- wp:heading {\"level\":3,\"className\":\"jim-footer__title\"} -->\n<h3 class=\"wp-block-heading jim-footer__title\">Need help</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":183,\"overlayMenu\":\"never\",\"className\":\"jim-footnav\",\"metadata\":{\"name\":\"nav.need-help\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__col\">\n<!-- wp:heading {\"level\":3,\"className\":\"jim-footer__title\"} -->\n<h3 class=\"wp-block-heading jim-footer__title\">Follow us</h3>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"ref\":186,\"overlayMenu\":\"never\",\"className\":\"jim-footnav\",\"metadata\":{\"name\":\"nav.follow-us\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-footer__bar jim-band jim-band\\u002d\\u002dprimary\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__bar jim-band jim-band--primary\">\n<!-- wp:group {\"className\":\"jim-container jim-footer__row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-container jim-footer__row\">\n<!-- wp:group {\"className\":\"jim-footer__copy\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-footer__copy\">\n<!-- wp:paragraph {\"className\":\"jim-footer__copy