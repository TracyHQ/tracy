      "content": "<!-- wp:group {\"className\":\"jim-header__top\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-header__top\">\n<!-- wp:group {\"className\":\"jim-container jim-header__row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-container jim-header__row\">\n<!-- wp:site-logo {\"width\":210,\"shouldSyncIcon\":false,\"className\":\"jim-logo tracy-logo-dark\"} /-->\n<!-- wp:group {\"className\":\"jim-contact\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-contact\">\n<!-- wp:group {\"className\":\"jim-contact__item jim-contact__item\\u002d\\u002daddress\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-contact__item jim-contact__item--address\">\n<!-- wp:paragraph {\"className\":\"jim-contact__sub\"} -->\n<p class=\"jim-contact__sub\">Our address:</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-contact__title\"} -->\n<p class=\"jim-contact__title\">Melbourne, Australia</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-contact__item jim-contact__item\\u002d\\u002dmail\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-contact__item jim-contact__item--mail\">\n<!-- wp:paragraph {\"className\":\"jim-contact__sub\"} -->\n<p class=\"jim-contact__sub\">You may send an email</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-contact__title\"} -->\n<p class=\"jim-contact__title\"><a href=\"mailto:helpus24@gmail.com\">helpus24@gmail.com</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-contact__item jim-contact__item\\u002d\\u002dphone\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-contact__item jim-contact__item--phone\">\n<!-- wp:paragraph {\"className\":\"jim-contact__sub\"} -->\n<p class=\"jim-contact__sub\">Helpline and support</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"jim-contact__title\"} -->\n<p class=\"jim-contact__title\">1 800 458 56 97</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:html -->\n<span class=\"jim-header__tools\"><button type=\"button\" class=\"jim-theme-toggle jim-theme-toggle--phone\" data-tracy-theme-toggle aria-pressed=\"false\" aria-label=\"Theme: light. Switch to dark\"><svg class=\"jim-theme-toggle__moon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"/></svg><svg class=\"jim-theme-toggle__sun\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42\"/></svg></button><button type=\"button\" class=\"jim-drawer-toggle\" aria-controls=\"jim-header-menu\" aria-expanded=\"false\" aria-label=\"Open the menu\"><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span></button></span>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-header__bar\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-header__bar\">\n<!-- wp:group {\"className\":\"jim-container jim-header__row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-container jim-header__row\">\n<!-- wp:group {\"anchor\":\"jim-header-menu\",\"className\":\"jim-header__menu\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-header__menu\" id=\"jim-header-menu\">\n<!-- wp:group {\"className\":\"jim-drawer__head\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-drawer__head\">\n<!-- wp:site-logo {\"width\":111,\"shouldSyncIcon\":false,\"className\":\"jim-drawer__logo tracy-logo-dark\"} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:navigation {\"ref\":182,\"overlayMenu\":\"never\",\"className\":\"jim-nav\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} /-->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"jim-header__actions\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group jim-header__actions\">\n<!-- wp:html -->\n<button type=\"button\" class=\"jim-theme-toggle\" data-tracy-theme-toggle aria-pressed=\"false\" aria-label=\"Theme: light. Switch to dark\"><svg class=\"jim-theme-toggle__moon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"/></svg><svg class=\"jim-theme-toggle__sun\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42\"/></svg></button>\n<!-- /wp:html -->\n<!-- wp:buttons {\"className\":\"jim-donate\"} -->\n<div class=\"wp-block-buttons jim-donate\">\n<!-- wp:button {\"className\":\"jim-btn jim-btn\\u002d\\u002dsuccess\"} -->\n<div class=\"wp-block-button jim-btn jim-btn--success\"><a class=\"wp-block-button__link wp-element-button\" href=\"/donations/\">Donate now</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n"
