    {
      "id": 136,
      "slug": "footer",
      "theme": "wp-ja-restaurant",
      "area": "footer",
      "sha256": "6f1430ef040f7ba49d8079e6003cf3d3c581dd231c3219d75a735c989bc2bf95",
      "content": "<!-- wp:group {\"className\":\"t3-footer\",\"anchor\":\"t3-footer\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-footer\" id=\"t3-footer\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:group {\"className\":\"t3-spotlight t3-footnav row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-spotlight t3-footnav row\">\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-12 col-xs-12\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-12 col-xs-12\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.location\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Location</h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:paragraph -->\n<p>4 5th Avenue at St. Marks Place, Cathedral District Brooklyn, NY 11217</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><a href=\"https://www.google.com/maps/search/?api=1&amp;query=4+5th+Avenue%2C+Brooklyn%2C+NY+11217\" target=\"_blank\" rel=\"noopener\">Get Direction</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-12 col-xs-12\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-12 col-xs-12\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.hours\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Hours</h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Mon - Thu:</span> 9 AM - 5 PM</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Fri - Sat:</span> 10 AM - 3 PM</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Sun:</span> 10AM - 1PM</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"col-lg-4 col-md-4 col-sm-12 col-xs-12\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group col-lg-4 col-md-4 col-sm-12 col-xs-12\">\n<!-- wp:group {\"className\":\"t3-module module\",\"metadata\":{\"name\":\"footer.contact\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-module module\">\n<!-- wp:group {\"className\":\"module-inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-inner\">\n<!-- wp:heading {\"level\":3,\"className\":\"module-title\"} -->\n<h3 class=\"wp-block-heading module-title\">Contact</h3>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"module-ct\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group module-ct\">\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Phone:</span> (084) 555-0110</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Fax:</span> (084) 555-0111</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><span class=\"highlight\">Email:</span> <a href=\"mailto:hello@res-restaurant.example\">hello@res-restaurant.example</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"section\",\"className\":\"t3-copyright\",\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group t3-copyright\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:group {\"className\":\"row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group row\">\n<!-- wp:paragraph {\"className\":\"col-md-12 copyright text-center\",\"metadata\":{\"name\":\"footer.copyright\"}} -->\n<p class=\"col-md-12 copyright text-center\">Copyright © {year} {site.title}. All Rights Reserved.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
    }
