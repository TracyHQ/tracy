      "content": "<!-- wp:group {\"className\":\"t3-topbar\",\"metadata\":{\"name\":\"header.topbar\"},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-topbar\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:paragraph {\"className\":\"open-time\",\"metadata\":{\"name\":\"header.open-time\"}} -->\n<p class=\"open-time\">7.00am - 6.30pm Monday to Sunday</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"header\",\"anchor\":\"t3-header\",\"className\":\"container t3-header\",\"layout\":{\"type\":\"default\"}} -->\n<header class=\"wp-block-group container t3-header\" id=\"t3-header\">\n<!-- wp:group {\"className\":\"logo\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group logo\">\n<!-- wp:site-logo {\"width\":180,\"shouldSyncIcon\":false,\"className\":\"jr-logo jr-logo--light\"} /-->\n<!-- wp:site-logo {\"width\":180,\"shouldSyncIcon\":false,\"className\":\"jr-logo jr-logo--dark\"} /-->\n</div>\n<!-- /wp:group -->\n</header>\n<!-- /wp:group -->\n<!-- wp:group {\"tagName\":\"nav\",\"className\":\"t3-mainnav\",\"anchor\":\"t3-mainnav\",\"layout\":{\"type\":\"default\"}} -->\n<nav class=\"wp-block-group t3-mainnav\" id=\"t3-mainnav\">\n<!-- wp:group {\"className\":\"container\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group container\">\n<!-- wp:html -->\n<button type=\"button\" class=\"off-canvas-toggle\" aria-controls=\"jm-off-canvas\" aria-expanded=\"false\" aria-label=\"Open the menu\"><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span><span aria-hidden=\"true\"></span></button>\n<!-- /wp:html -->\n<!-- wp:navigation {\"ref\":133,\"overlayMenu\":\"never\",\"className\":\"jr-mainmenu\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\"}} /-->\n<!-- wp:html -->\n<button type=\"button\" class=\"theme-toggle\" data-tracy-theme-toggle aria-pressed=\"false\" aria-label=\"Theme: light. Switch to dark\"><svg class=\"theme-toggle__moon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"theme-toggle__sun\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</nav>\n<!-- /wp:group -->\n<!-- wp:group {\"anchor\":\"jm-off-canvas\",\"className\":\"t3-off-canvas\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas\" id=\"jm-off-canvas\">\n<!-- wp:group {\"className\":\"t3-off-canvas-header\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas-header\">\n<!-- wp:heading {\"level\":2,\"className\":\"t3-off-canvas-header-title\"} -->\n<h2 class=\"wp-block-heading t3-off-canvas-header-title\">Menu</h2>\n<!-- /wp:heading -->\n<!-- wp:html -->\n<button type=\"button\" class=\"close\" aria-label=\"Close the menu\">×</button>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"t3-off-canvas-body\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group t3-off-canvas-body\">\n<!-- wp:navigation {\"ref\":133,\"overlayMenu\":\"never\",\"className\":\"jm-off-canvas-nav\",\"metadata\":{\"name\":\"nav.mainmenu\"},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
