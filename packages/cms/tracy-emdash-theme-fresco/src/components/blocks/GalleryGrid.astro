---
/**
 * acm gallery style-2: a lightbox grid; an Instagram-style glyph shows on hover / focus. `type_gallery` 1 = 2 / 3 / 4 per row
 * (`col`; 2 below 992, 1 below 576); 2 = a 4-column grid where items 1, 8, 11, 18 ... span 2 x 2. The lightbox is a <dialog>
 * with previous / next and Escape.
 */
import type { Chrome } from '@/lib/chrome'
import SectionHead from '@/components/blocks/SectionHead.astro'
import { spacing } from '@/lib/layout'
import { stampFor } from '@/lib/stamps'
import { mediaUrl } from '@/lib/media'
import { ui } from '@/lib/ui'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
}
const { entry, chrome } = Astro.props
const w = ui(chrome.locale).w
const $g = stampFor(Astro.request, 'gallery', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const type = String(entry.type_gallery) === '2' ? 2 : 1
const col = [2, 3, 4].includes(Number(entry.col)) ? Number(entry.col) : 3
---

<section class:list={['fr-section', spacing(entry.slug)]}>
	<SectionHead entry={entry} collection="gallery" />
	<div class="fr-container fr-gallery-grid" data-fr-gallery-grid>
		<ul class:list={['fr-gallery-grid-box', `type-${type}`, `cols-${col}`]}>
			{items.map((it, i) => {
				const src = mediaUrl(it.gallery_image)
				return src && (
					<li class="fr-gallery-grid-item">
						<button type="button" class="fr-gallery-grid-open" data-i={i} aria-haspopup="dialog" aria-label={it.gallery_alt || undefined}>
							<img src={src} alt={it.gallery_alt ?? ''} width="408" height="408" loading="lazy" decoding="async" {...$g(`items[${i}].gallery_image`)} />
							<span class="fr-gallery-grid-hover" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
							</span>
						</button>
					</li>
				)
			})}
		</ul>
		<dialog class="fr-lightbox">
			<form method="dialog"><button class="fr-lightbox-close" aria-label={w.close}>×</button></form>
			<button type="button" class="fr-lightbox-nav is-prev" aria-label={w.previous}>‹</button>
			<img class="fr-lightbox-img" alt="" />
			<button type="button" class="fr-lightbox-nav is-next" aria-label={w.next}>›</button>
		</dialog>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-fr-gallery-grid]').forEach((root) => {
		const dlg = root.querySelector('dialog') as HTMLDialogElement
		const big = dlg.querySelector('.fr-lightbox-img') as HTMLImageElement
		const pics = [...root.querySelectorAll<HTMLImageElement>('.fr-gallery-grid-open img')]
		const btns = [...root.querySelectorAll<HTMLButtonElement>('.fr-gallery-grid-open')]
		let cur = 0
		let opener: HTMLElement | null = null
		const show = (i: number) => {
			cur = (i + pics.length) % pics.length
			big.src = pics[cur].currentSrc || pics[cur].src
			big.alt = pics[cur].alt
		}
		btns.forEach((b, i) =>
			b.addEventListener('click', () => {
				opener = b
				show(i)
				dlg.showModal()
			})
		)
		dlg.querySelector('.is-prev')!.addEventListener('click', () => show(cur - 1))
		dlg.querySelector('.is-next')!.addEventListener('click', () => show(cur + 1))
		dlg.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(cur - 1)
			else if (e.key === 'ArrowRight') show(cur + 1)
		})
		dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close() })
		dlg.addEventListener('close', () => opener?.focus())
	})
</script>
