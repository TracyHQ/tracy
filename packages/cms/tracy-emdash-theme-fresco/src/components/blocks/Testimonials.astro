---
/** acm testimonials style-1: one large quote per slide with the author line in the accent, previous / next arrows, no autoplay. */
import type { Chrome } from '@/lib/chrome'
import { spacing } from '@/lib/layout'
import { stampFor } from '@/lib/stamps'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
}
const { entry, chrome } = Astro.props
const $t = stampFor(Astro.request, 'testimonials', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const id = `testimonials-${entry.slug}`
---

{items.length > 0 && (
	<section class:list={['fr-section', 'fr-t-section', spacing(entry.slug)]} aria-roledescription="carousel" aria-label={entry.title} data-fr-testimonials id={id}>
		<div class="fr-container fr-testimonial">
			{items.length > 1 && <button type="button" class="fr-t-nav is-prev" data-t-prev aria-label={chrome.site.prev_label}><svg viewBox="0 0 448 512" aria-hidden="true"><path d="M9 233 233 9a31 31 0 0 1 44 44L141 189h275a32 32 0 0 1 0 64H141l136 136a31 31 0 0 1-44 44L9 277a31 31 0 0 1 0-44z" /></svg></button>}
			<div class="fr-t-slides" aria-live="polite">
				{items.map((it, i) => (
					<figure class:list={['fr-t-slide', i === 0 && 'is-active']} data-t-slide aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`} hidden={i !== 0}>
						<blockquote class="fr-t-desc" {...$t(`items[${i}].desc`)}>{it.desc}</blockquote>
						<figcaption class="fr-t-author" {...$t(`items[${i}].author`)}>{it.author}</figcaption>
					</figure>
				))}
			</div>
			{items.length > 1 && <button type="button" class="fr-t-nav is-next" data-t-next aria-label={chrome.site.next_label}><svg viewBox="0 0 448 512" aria-hidden="true"><path d="m439 277-224 224a31 31 0 0 1-44-44l136-136H32a32 32 0 0 1 0-64h275L171 53a31 31 0 0 1 44-44l224 224a31 31 0 0 1 0 44z" /></svg></button>}
		</div>
	</section>
)}
<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-fr-testimonials]')) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-t-slide]')]
		let at = 0
		const show = (n: number) => {
			at = (n + slides.length) % slides.length
			slides.forEach((s, i) => { s.hidden = i !== at; s.classList.toggle('is-active', i === at) })
		}
		root.querySelector('[data-t-prev]')?.addEventListener('click', () => show(at - 1))
		root.querySelector('[data-t-next]')?.addEventListener('click', () => show(at + 1))
	}
</script>
