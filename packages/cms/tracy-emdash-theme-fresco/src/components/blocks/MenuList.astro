---
/**
 * acm menu style-1: a dish list in 1, 2 or 3 columns (3 only from 992 px): name, description and a large price, with an optional
 * centred heading (`title`) and short accent line above. `heading` = which text is drawn above the list: the section's own
 * `section_title` block (SectionHead) or, as on the home's Sea / Land / Sky lists, the entry's `title` in the big menu-type style.
 */
import type { Chrome } from '@/lib/chrome'
import SectionHead from '@/components/blocks/SectionHead.astro'
import { spacing } from '@/lib/layout'
import { stampFor } from '@/lib/stamps'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
  /** Print the entry's title as the menu-type heading (the Sea / Land / Sky lists). */
  typeHeading?: boolean
  /** The source's lighter band (`--color-ink`) behind the Multi Column and Menu List sections. */
  band?: boolean
}
const { entry, typeHeading = false, band = false } = Astro.props
const $m = stampFor(Astro.request, 'menu', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const cols = Math.min(3, Math.max(1, Number(entry.columns) || 2))
---

<section class:list={['fr-section', spacing(entry.slug), band && 'is-band']}>
	<SectionHead entry={entry} collection="menu" />
	<div class="fr-container">
		{typeHeading && entry.title && <div class="fr-menu-type" {...$m('title')}>{entry.title}</div>}
		<ul class={`fr-menu-list cols-${cols}`}>
			{items.map((it, i) => (
				<li class="fr-dish">
					<div class="fr-dish-text">
						<h3 class="fr-dish-name" {...$m(`items[${i}].dish_name`)}>{it.dish_name}</h3>
						{it.dish_description && <p class="fr-dish-desc" {...$m(`items[${i}].dish_description`)}>{it.dish_description}</p>}
					</div>
					{it.dish_price && <span class="fr-dish-price" {...$m(`items[${i}].dish_price`)}>{it.dish_price}</span>}
				</li>
			))}
		</ul>
	</div>
</section>
