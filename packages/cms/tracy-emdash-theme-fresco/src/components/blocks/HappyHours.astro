---
/**
 * acm happyhours style-1/2/3: a full-width background picture with a 420 px black panel at 80 percent placed left, centre or right
 * (`align_box`): logo, title, description, a green discount badge (style 1: a circle on a double border, 2: a circle on the panel's
 * corner, 3: a ribbon on the left edge), the offer lines and one button. `style` picks the badge.
 */
import type { Chrome } from '@/lib/chrome'
import SectionHead from '@/components/blocks/SectionHead.astro'
import { href } from '@/lib/i18n'
import { spacing } from '@/lib/layout'
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { liveLinks } from '@/lib/link-gate'
import { dataHref } from '@/lib/data-links'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
  style?: 'style-1' | 'style-2' | 'style-3'
}
const { entry, chrome, style = 'style-1' } = Astro.props
const $h = stampFor(Astro.request, 'happyhours', { id: entry.id, slug: entry.slug })
const live = await liveLinks(Astro.request, chrome.locale, [entry.hp_link])
const bg = mediaUrl(entry.hp_img)
const logo = mediaUrl(entry.logo_img)
const align = ['left', 'center', 'right'].includes(entry.align_box) ? entry.align_box : 'left'
const badge = String(entry.hp_badge ?? '').trim()
// "35% OFF": the badge breaks after the first word, as the source's narrow circle does.
---

<section class:list={['fr-section', spacing(entry.slug)]}>
	<SectionHead entry={entry} collection="happyhours" />
	<div class={`fr-hh hh-${style.slice(-1)}`} style={bg ? `background-image:url('${bg}')` : undefined}>
		<div class={`fr-hh-inner is-${align}`}>
			<div class="fr-hh-panel">
				{logo && <div class="fr-hh-logo"><img src={logo} alt="" width="150" height="77" loading="lazy" {...$h('logo_img')} /></div>}
				{entry.hp_title && <h3 class="fr-hh-title" {...$h('hp_title')}>{entry.hp_title}</h3>}
				{entry.hp_desc && <p class="fr-hh-desc" {...$h('hp_desc')}>{entry.hp_desc}</p>}
				<div class="fr-hh-info">
					<div class="fr-hh-info-inner">
						{badge && <span class="fr-hh-badge" {...$h('hp_badge')}><span class="fr-hh-badge-text">{badge}</span></span>}
						{entry.hp_info && <span class="fr-hh-txt" {...$h('hp_info')}>{entry.hp_info}</span>}
					</div>
				</div>
				{entry.hp_link_text && live(entry.hp_link) && (
					<div class="fr-hh-link"><a class="fr-btn" href={dataHref(entry.hp_link, (p) => href(chrome.locale, p))!} {...$h('hp_link_text')}>{String(entry.hp_link_text).trim()}</a></div>
				)}
			</div>
		</div>
	</div>
</section>
