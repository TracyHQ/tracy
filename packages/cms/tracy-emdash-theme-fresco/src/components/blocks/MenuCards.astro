---
/**
 * acm menu style-3: dish cards (picture with the price tag on it, title, description), 2 to 4 per row. The picture opens a
 * keyboard-operable <dialog> lightbox with the title and the price. `align` = left / center.
 */
import type { Chrome } from '@/lib/chrome'
import SectionHead from '@/components/blocks/SectionHead.astro'
import { spacing } from '@/lib/layout'
import { stampFor } from '@/lib/stamps'
import { mediaUrl } from '@/lib/media'
import { ui } from '@/lib/ui'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
}
const { entry, chrome } = Astro.props
const w = ui(chrome.locale).w
const $m = stampFor(Astro.request, 'menu', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const cols = Math.min(4, Math.max(2, Number(entry.columns) || 3))
const center = String(entry.align).toLowerCase() === 'center'
---

<section class:list={['fr-section', spacing(entry.slug)]}>
	<SectionHead entry={entry} collection="menu" />
	<div class:list={['fr-container fr-menu-cards', `cols-${cols}`, center && 'is-center']} data-fr-menu-cards>
		<ul class="fr-menu-cards-grid">
			{items.map((it, i) => {
				const src = mediaUrl(it.img_icon)
				return (
					<li class="fr-menu-card">
						{src && (
							<div class="fr-menu-card-media">
								<button type="button" class="fr-menu-card-open" data-src={src} data-title={it.title ?? ''} data-price={it.price ?? ''} aria-haspopup="dialog" aria-labelledby={it.title ? `${entry.slug}-dish-${i}` : undefined}>
									<img src={src} alt="" width="408" height="408" loading="lazy" decoding="async" {...$m(`items[${i}].img_icon`)} />
								</button>
								{it.price && <span class="fr-menu-card-price" {...$m(`items[${i}].price`)}>{it.price}</span>}
							</div>
						)}
						{it.title && <h4 class="fr-menu-card-title" id={`${entry.slug}-dish-${i}`} {...$m(`items[${i}].title`)}>{it.title}</h4>}
						{it.description && <p class="fr-menu-card-desc" {...$m(`items[${i}].description`)}>{it.description}</p>}
					</li>
				)
			})}
		</ul>
		<dialog class="fr-lightbox" aria-label={entry.section_title || entry.title || undefined}>
			<form method="dialog"><button class="fr-lightbox-close" aria-label={w.close}>×</button></form>
			<img class="fr-lightbox-img" alt="" />
			<p class="fr-lightbox-cap"><b class="fr-lightbox-title"></b><span class="fr-lightbox-price"></span></p>
		</dialog>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-fr-menu-cards]').forEach((root) => {
		const dlg = root.querySelector('dialog') as HTMLDialogElement
		let opener: HTMLElement | null = null
		root.querySelectorAll<HTMLButtonElement>('.fr-menu-card-open').forEach((b) =>
			b.addEventListener('click', () => {
				opener = b
				;(dlg.querySelector('.fr-lightbox-img') as HTMLImageElement).src = b.dataset.src ?? ''
				;(dlg.querySelector('.fr-lightbox-title') as HTMLElement).textContent = b.dataset.title ?? ''
				;(dlg.querySelector('.fr-lightbox-price') as HTMLElement).textContent = b.dataset.price ?? ''
				dlg.showModal()
			})
		)
		dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close() })
		dlg.addEventListener('close', () => opener?.focus())
	})
</script>
