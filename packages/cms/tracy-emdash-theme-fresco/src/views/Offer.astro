---
/** Offer: three happy-hours panels (styles 1, 2, 3), each under its own section heading. No masthead in the source. */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import HappyHours from '@/components/blocks/HappyHours.astro'
import type { Chrome } from '@/lib/chrome'
import type { Locale } from '@/lib/i18n'
import { section } from '@/lib/content'
import { stampFor } from '@/lib/stamps'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const [{ entry: pageEntry }, h1, h2, h3] = await Promise.all([
  getEmDashEntry('pages', 'offer', { locale }),
  section('happyhours', 'offer-hour-1', locale),
  section('happyhours', 'offer-hour-2', locale),
  section('happyhours', 'offer-hour-3', locale)
])
const page = (pageEntry?.data ?? {}) as Record<string, any>
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: page.id, slug: 'offer' } : null)
---

<Base chrome={chrome} title={page.title ?? chrome.site.brand_name} currentPath="/offer" content={pageEntry ? { collection: 'pages', id: page.id, slug: 'offer', toPath: () => '/offer' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		<h1 class="sr-only" {...$page("title")}>{page.title}</h1>
		{h1 && <HappyHours entry={h1} chrome={chrome} style="style-1" />}
		{h2 && <HappyHours entry={h2} chrome={chrome} style="style-2" />}
		{h3 && <HappyHours entry={h3} chrome={chrome} style="style-3" />}
	</main>
</Base>
