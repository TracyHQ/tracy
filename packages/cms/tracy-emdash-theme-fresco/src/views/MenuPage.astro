---
/** Menu page: menu-columns (list) · menu-grid (cards) · menu-list-1 / menu-list-2 (picture + list, alternating sides). No masthead in the source. */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import MenuList from '@/components/blocks/MenuList.astro'
import MenuCards from '@/components/blocks/MenuCards.astro'
import MenuImageList from '@/components/blocks/MenuImageList.astro'
import type { Chrome } from '@/lib/chrome'
import type { Locale } from '@/lib/i18n'
import { section } from '@/lib/content'
import { stampFor } from '@/lib/stamps'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
  path?: string
  slug?: string
}
const { chrome, locale } = Astro.props
const [{ entry: pageEntry }, columns, grid, list1, list2] = await Promise.all([
  getEmDashEntry('pages', 'menu', { locale }),
  section('menu', 'menu-columns', locale),
  section('menu', 'menu-grid', locale),
  section('menu', 'menu-list-1', locale),
  section('menu', 'menu-list-2', locale)
])
const page = (pageEntry?.data ?? {}) as Record<string, any>
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: page.id, slug: 'menu' } : null)
---

<Base chrome={chrome} title={page.title ?? chrome.site.brand_name} currentPath="/menu" content={pageEntry ? { collection: 'pages', id: page.id, slug: 'menu', toPath: () => '/menu' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		<h1 class="sr-only" {...$page("title")}>{page.title}</h1>
		{columns && <MenuList entry={columns} chrome={chrome} band />}
		{grid && <MenuCards entry={grid} chrome={chrome} />}
		{list1 && <MenuImageList entry={list1} chrome={chrome} band />}
		{list2 && <MenuImageList entry={list2} chrome={chrome} band />}
	</main>
</Base>
