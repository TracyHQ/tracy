{
  "id": "tracy-fresco",
  "label": "JA Fresco",
  "version": "0.1.0",
  "vendor": {
    "name": "JoomlArt",
    "domains": ["joomlart.com"]
  },
  "locales": ["en"],
  "defaultLocale": "en",
  "site": {
    "title": "JA Fresco",
    "tagline": ""
  },
  "contentOrder": [
    "posts",
    "pages",
    "hero",
    "features_intro",
    "menu",
    "gallery",
    "testimonials",
    "teams",
    "happyhours",
    "book_table",
    "masthead",
    "contact",
    "chrome"
  ],
  "forms": {
    "file": "tools/forms.json",
    "bindings": [
      {
        "form": "contact-{locale}",
        "collection": "contact",
        "slug": "contact-info",
        "field": "form_id"
      }
    ]
  },
  "mail": {
    "fromEmail": "no-reply@ja-fresco.example",
    "fromName": "JA Fresco"
  },
  "audit": {
    "indexable": ["^/(?!search)(?!404$).*"],
    "noindex": ["^/search"],
    "notFound": ["^/404$"],
    "canonicalQuery": ["page"],
    "unknownProbes": ["/blog/nope"],
    "alternates": "all-locales"
  },
  "qa": {
    "theme": {
      "selector": "html",
      "attribute": "data-theme",
      "values": {
        "light": null,
        "dark": "dark"
      },
      "storageKey": "tracy-fresco-theme"
    },
    "expectedStatus": {
      "/404": 404
    }
  },
  "$comment": "Template identity and site-specific wiring read by the generic tools. Demo content: the JA Fresco sample site (Fresco restaurant)."
}
