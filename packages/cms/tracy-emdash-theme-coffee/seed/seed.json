	"content": {
		"posts": [
			{
				"id": "posts:where-our-beans-come-from:en",
				"slug": "where-our-beans-come-from",
				"status": "published",
				"locale": "en",
				"data": {
					"title": "Where our beans come from",
					"excerpt": "Six single-origin coffees sit on our bar. Here is how we choose them and who grows them.",
					"image": null,
					"image_alt": "Green coffee beans in a roasting drum beside a burlap sack",
					"image_caption": "",
					"author": "The Ember team",
					"date": "2026-10-12T00:00:00.000Z",
					"content": [
						{
							"_type": "block",
							"_key": "e1",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e2",
									"text": "Six farms, one roastery",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e3",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e4",
									"text": "Every coffee on our bar comes from a single farm or co-operative. We taste dozens of samples each season and keep only the ones we would happily drink all morning.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e5",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e6",
									"text": "We pay above the market price and buy the same lots year after year, so the farms can plan and we can follow how each crop changes. The bag always names the farm and the harvest.",
									"marks": []
								}
							]
						}
					],
					"featured": true,
					"sort": 0
				},
				"taxonomies": {
					"category": [
						"coffee-stories"
					]
				}
			},
			{
				"id": "posts:a-morning-at-the-roastery:en",
				"slug": "a-morning-at-the-roastery",
				"status": "published",
				"locale": "en",
				"data": {
					"title": "A morning at the roastery",
					"excerpt": "Roasting day starts before the doors open. Here is what happens between the green bag and the cup.",
					"image": null,
					"image_alt": "Freshly roasted beans pouring into the cooling tray",
					"image_caption": "",
					"author": "The Ember team",
					"date": "2026-10-05T00:00:00.000Z",
					"content": [
						{
							"_type": "block",
							"_key": "e7",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e8",
									"text": "Before the doors open",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e9",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ea",
									"text": "Roasting days begin at six. The drum is warmed, the first batch is weighed and Maya listens for the first crack, the sound that tells her the beans are close.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "eb",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ec",
									"text": "Each batch is cooled, tasted and logged before it is bagged. Anything that is not right goes back into the notes for next time, never onto the shelf.",
									"marks": []
								}
							]
						}
					],
					"featured": false,
					"sort": 0
				},
				"taxonomies": {
					"category": [
						"coffee-stories"
					]
				}
			},
			{
				"id": "posts:brewing-a-better-pour-over:en",
				"slug": "brewing-a-better-pour-over",
				"status": "published",
				"locale": "en",
				"data": {
					"title": "Brewing a better pour-over at home",
					"excerpt": "Four small habits that make a pour-over taste cleaner and sweeter.",
					"image": null,
					"image_alt": "Hot water poured from a gooseneck kettle over a pour-over dripper",
					"image_caption": "",
					"author": "The Ember team",
					"date": "2026-09-28T00:00:00.000Z",
					"content": [
						{
							"_type": "block",
							"_key": "ed",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ee",
									"text": "Four habits that matter",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "ef",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e10",
									"text": "Weigh the coffee and the water instead of guessing: sixty grams of coffee to a litre of water is a good place to start. Grind just before you brew, and rinse the paper filter so it does not leave a taste.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e11",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e12",
									"text": "Pour in slow circles, and let the bed of coffee drain a little between pours. If the cup tastes sour, grind finer; if it tastes bitter, grind coarser.",
									"marks": []
								}
							]
						}
					],
					"featured": false,
					"sort": 0
				},
				"taxonomies": {
					"category": [
						"brew-guides"
					]
				}
			},
			{
				"id": "posts:cold-brew-in-five-steps:en",
				"slug": "cold-brew-in-five-steps",
				"status": "published",
				"locale": "en",
				"data": {
					"title": "Cold brew in five easy steps",
					"excerpt": "You need coarse coffee, cold water, a jar and a night in the fridge.",
					"image": null,
					"image_alt": "Jars of cold brew steeping on a wooden shelf",
					"image_caption": "",
					"author": "The Ember team",
					"date": "2026-09-15T00:00:00.000Z",
					"content": [
						{
							"_type": "block",
							"_key": "e13",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e14",
									"text": "Start tonight, drink tomorrow",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e15",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e16",
									"text": "Stir coarsely ground coffee into cold water in a clean jar, using one part coffee to five parts water. Cover it and leave it in the fridge for twelve to sixteen hours.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "e17",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "e18",
									"text": "Strain through a paper filter, then dilute to taste with water or milk over ice. The concentrate keeps for a week in the fridge.",
									"marks": []
								}
							]
						}
					],
					"featured": false,
					"sort": 0
				},
				"taxonomies": {
					"category": [
						"brew-guides"
					]
				}
			},
			{
