---
/**
 * `/sitemap`: every menu the chrome carries, grouped under the site entry's panel titles, then
 * every published entry of the routable collection (posts) under its list page's title.
 * The source has no sitemap page; the lists use the footer's column idiom.
 */
import { getEmDashEntry } from 'emdash'
import Base from '@/layouts/Base.astro'
import Breadcrumb from '@/components/site/Breadcrumb.astro'
import type { Chrome } from '@/lib/chrome'
import { href, type Locale } from '@/lib/i18n'
import { type Attrs, stampFor, stampsFor } from '@/lib/stamps'
import { liveLinks } from '@/lib/link-gate'
import { loadPosts } from '@/lib/posts'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const { site } = chrome
// Provenance stamps (`src/lib/stamps.ts`): empty on an ordinary request. Menu links carry none: the
// menus are not Content API records, only the site fields titling them are.
const $site = stampFor(Astro.request, 'site', site)
const $ = stampsFor(Astro.request)
const [posts, blogPage] = await Promise.all([loadPosts(locale), getEmDashEntry('blog', 'blog', { locale })])
type Link = { label: string; url: string; stamp?: Attrs }
// A link into an unticked page or one of its children is not listed, and a group left empty goes (TCH #1013).
const live = await liveLinks(
  Astro.request,
  locale,
  [chrome.primary, chrome.resourcesRead, chrome.resourcesHelp]
    .flat()
    .map((l) => l.url)
    .concat([href(locale, '/blog')])
)
const menus: Array<{ title: string; stamp: Attrs; items: Link[] }> = [
  { title: site.menu_label, stamp: $site('menu_label'), items: chrome.primary },
  { title: site.mega_read_title, stamp: $site('mega_read_title'), items: chrome.resourcesRead },
  { title: site.mega_help_title, stamp: $site('mega_help_title'), items: chrome.resourcesHelp }
]
  .map((g) => ({ ...g, items: g.items.filter((i) => live(i.url)) }))
  .filter((g) => g.items.length > 0)
const collections: Array<{ title: string | undefined; stamp: Attrs; url: string; items: Link[] }> = [
  {
    title: blogPage.entry?.data.title,
    stamp: $('blog', blogPage.entry)('title'),
    url: href(locale, '/blog'),
    items: posts.map((p) => ({
      label: p.data.title,
      url: href(locale, `/blog/${p.slug}`),
      stamp: $('posts', p)('title')
    }))
  }
].filter((g) => g.items.length > 0 && live(g.url))
---

<Base chrome={chrome} title={site.sitemap_title} currentPath="/sitemap">
	<Breadcrumb items={[{ label: site.breadcrumb_home, url: href(locale, "/"), stamp: $site("breadcrumb_home") }, { label: site.sitemap_title, stamp: $site("sitemap_title") }]} />
	<main id="main" class="wrap pb-[var(--band-y)] pt-6">
		<h1 class="h-page mb-10" {...$site("sitemap_title")}>{site.sitemap_title}</h1>
		<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{menus.map((g) => (
				<section>
					<h2 class="footer-title" {...g.stamp}>{g.title}</h2>
					<ul>{g.items.map((l) => <li><a href={l.url} class="footer-link">{l.label}</a></li>)}</ul>
				</section>
			))}
		</div>
		{collections.map((g) => (
			<section class="mt-14 border-t border-line-soft pt-10">
				<h2 class="h-card mb-6"><a href={g.url} class="text-fg hover:text-accent" {...g.stamp}>{g.title}</a></h2>
				<ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">{g.items.map((l) => <li><a href={l.url} class="footer-link" {...l.stamp}>{l.label}</a></li>)}</ul>
			</section>
		))}
	</main>
</Base>
