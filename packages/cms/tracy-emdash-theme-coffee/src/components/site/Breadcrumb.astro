---
/** Home / Section / Current, above inner pages (module 176 on the source). Absent on landings, search, 404. */
import type { Attrs } from '@/lib/stamps'
import { DEFAULT_LOCALE } from '@/lib/i18n'
import { ui } from '@/lib/ui'

interface Props {
  /** `stamp`: the provenance stamp of the field the label comes from (`src/lib/stamps.ts`). */
  items: Array<{ label: string; url?: string; stamp?: Attrs }>
}
const { items } = Astro.props
// One stored locale (`LOCALES`), so the page's words are the default locale's display language (`src/lib/ui.ts`).
const { w } = ui(DEFAULT_LOCALE)
---

<nav class="wrap" aria-label={w.breadcrumb}>
	<ol class="flex flex-wrap items-center gap-2 py-4 text-[13px] text-fg-meta">
		{items.map((it, i) => (
			<li class="flex items-center gap-2">
				{i > 0 && <span aria-hidden="true">/</span>}
				{it.url ? <a href={it.url} class="text-fg-muted hover:text-accent" {...it.stamp}>{it.label}</a> : <span class="text-fg" aria-current="page" {...it.stamp}>{it.label}</span>}
			</li>
		))}
	</ol>
</nav>
