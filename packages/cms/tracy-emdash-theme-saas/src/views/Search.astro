---
/**
 * Site search over published posts (`?q=`), noindex and never cached. The query box sits in the head;
 * results list below with the engine's sanitised snippet (or the excerpt when the snippet only
 * repeats the title).
 */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import { stampFor } from '@/lib/stamps'
import NotFound from '@/views/NotFound.astro'
import Icon from '@/components/Icon.astro'
import Masthead from '@/components/blog/Masthead.astro'
import Pagination from '@/components/blog/Pagination.astro'
import type { Chrome } from '@/lib/chrome'
import { href, type Locale } from '@/lib/i18n'
import type { ComposedPage } from '@/lib/sections'
import { dateMedium, pageHref, postPath, resolveSearch } from '@/lib/posts'
import { ui } from '@/lib/ui'
import { fillWords, uiCount } from '@/lib/ui-words'

interface Props {
  chrome: Chrome
  locale: Locale
  path: string
  page: ComposedPage
}
const { chrome, locale, path, page } = Astro.props
// The template's own words, in the site's language (`src/lib/ui.ts`).
const { tag, w } = ui(locale)
Astro.response.headers.set('cache-control', 'no-store')
// The router gets the 404 status from viewFound() (same resolver); a miss renders the 404 view here.
const { q, results, pg } = await resolveSearch(locale, Astro.url)

// Provenance stamps (`src/lib/stamps.ts`): the page entry owns the page and stamps its head. Empty on
// an ordinary request.
const $page = stampFor(Astro.request, 'pages', { slug: page.slug, data: { id: page.id } })
const headMarks = { title: $page(page.heading ? 'heading' : 'title'), sub: $page('sub') }
---

{
	!pg ? (
		<NotFound chrome={chrome} locale={locale} path={path} />
	) : (
		<Base chrome={chrome} title={page.title} currentPath={path} style={page.style} robots="noindex, follow">
			<PageOwner stamp={$page} />
			<Masthead marks={headMarks} title={page.heading || page.title} sub={page.sub} eyebrow={w.search} band grid={false} size="search" last={!q}>
				<form class="sform" action={href(locale, path)} method="get" role="search">
					<span class="sicon" aria-hidden="true">
						<Icon name="search" size={18} />
					</span>
					<input type="search" name="q" value={q} placeholder={w.searchTerms} aria-label={w.searchTerms} />
					<button type="submit" class="k-btn k-btn-primary k-btn-sm">
						{w.search}
					</button>
				</form>
			</Masthead>
			{q && (
				<section class="body">
					<div class="k-container results">
						<p class="count">
							// {uiCount(tag, w.results, results.length, { query: q })}
						</p>
						{pg.slice.map(({ post, title, snippet }) => (
							<a class="hit" href={href(locale, postPath(post.slug))}>
								{post.category && <span class="tag">{post.category.label}</span>}
								<span class="title">{title}</span>
								{snippet ? <p class="snippet" set:html={snippet} /> : post.excerpt && <p class="snippet">{post.excerpt}</p>}
								<span class="meta">{[post.author, dateMedium(post.date, tag)].filter(Boolean).join(' · ')}</span>
							</a>
						))}
						<Pagination page={pg.page} pages={pg.pages} url={(n) => pageHref(Astro.url, n)} counter={fillWords(w.pageOf, { page: pg.page, pages: pg.pages })} locale={locale} />
					</div>
				</section>
			)}
		</Base>
	)
}

<style>
	.sform {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		max-width: 820px;
		margin-top: 18px;
		padding: 6px 6px 6px 18px;
		background: var(--k-surface);
		border: 1px solid var(--k-border);
		border-radius: 12px;
		box-shadow: var(--k-shadow);
		text-align: left;
	}
	.sform:focus-within {
		border-color: var(--k-primary);
	}
	.sicon {
		display: inline-flex;
		color: var(--k-muted);
	}
	input {
		flex: 1;
		min-width: 0;
		height: 38px;
		border: 0;
		outline: none;
		background: transparent;
		font-family: var(--font-sans);
		font-size: 17px;
		color: var(--k-heading);
	}
	input::placeholder {
		color: var(--k-muted);
	}
	.body {
		padding: 48px 0 72px;
	}
	.results {
		max-width: 820px;
	}
	.count {
		margin: 0 0 12px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--k-muted);
	}
	.hit {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 22px 0;
		border-top: 1px solid var(--k-border);
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--k-primary);
	}
	.title {
		font-family: var(--font-heading);
		font-size: 20px;
		line-height: 1.3;
		font-weight: 600;
		color: var(--k-heading);
	}
	.hit:hover .title {
		color: var(--k-primary);
	}
	.snippet {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--k-text);
	}
	.meta {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--k-muted);
	}
	@media (max-width: 620px) {
		.sform {
			padding-left: 14px;
		}
		input {
			font-size: 16px;
		}
	}
</style>
