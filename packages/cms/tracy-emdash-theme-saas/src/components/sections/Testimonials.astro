---
/**
 * testimonials — ruled heading, then the first quote as a large card beside a stack of the others
 * (source home: one large + two small). Without an avatar the author shows initials.
 */
import type { Style } from '@/lib/sections'
import { mediaUrl } from '@/lib/media'
import { stampFor, type Stamp } from '@/lib/stamps'

interface Props {
  /** Provenance stamps of this section's entry (`src/lib/stamps.ts`); none when not given. */
  stamp?: Stamp
  data: Record<string, any>
  index: number
  style: Style
  /** True inside the 760px article column of inner pages (DECISIONS D18). */
  narrow?: boolean
}
const { data, index, narrow = false } = Astro.props
const items: Record<string, any>[] = Array.isArray(data.items) ? data.items : []
// No rows (the demo's emptied by seed/personalize.json `facts`), no section: never a heading over nothing.
const [lead, ...rest] = items
// The source tints sections at even positions with the elevated band.
const band = index % 2 === 0

// A bare file name is an un-imported seed value, not a URL the browser can load; show initials then.
const avatarOf = (item: Record<string, any>) => {
  const src = mediaUrl(item.avatar)
  return src && /^(\/|https?:)/.test(src) ? src : null
}
const metaOf = (item: Record<string, any>) => [item.role, item.company].filter(Boolean).join(', ')
const s: Stamp = Astro.props.stamp ?? stampFor(Astro.request, 'testimonials', null)
---

{items.length > 0 && (
<section class:list={['t', band && 'k-band t--band', narrow && 'is-narrow']} {...s()}>
	<div class="k-container t-inner">
		<hr class="k-rule t-rule" />
		{
			(data.eyebrow || data.title || data.sub) && (
				<header class="t-head">
					{data.eyebrow && <p class="k-eyebrow" {...s('eyebrow')}>{data.eyebrow}</p>}
					{data.title && <h2 class="t-title" {...s('title')}>{data.title}</h2>}
					{data.sub && <p class="k-sub" {...s('sub')}>{data.sub}</p>}
				</header>
			)
		}
		{
			lead && (
				<div class:list={['t-row', rest.length > 0 && 't-row--split']} style={`--t-rest: ${Math.max(rest.length, 1)}`}>
					{[lead, ...rest].map((item, i) => {
						const avatar = avatarOf(item)
						const meta = metaOf(item)
						const size = i === 0 ? 'lg' : 'sm'
						const card = (
							<figure class:list={['k-card', 't-card', `t-card--${size}`]} {...s.block('items')}>
								{item.quote && (
									<blockquote class="t-quote">
										<p {...s('items.quote')}>{item.quote}</p>
									</blockquote>
								)}
								{(item.name || meta || avatar || item.initials) && (
									<figcaption class="t-author">
										{avatar ? (
											<img class="t-avatar" src={avatar} alt="" loading="lazy" decoding="async" {...s('items.avatar')} />
										) : (
											item.initials && (
												<span class="t-avatar t-initials" aria-hidden="true" {...s('items.initials')}>
													{item.initials}
												</span>
											)
										)}
										<span class="t-id">
											{item.name && <span class="t-name" {...s('items.name')}>{item.name}</span>}
											{meta && <span class="t-meta">{meta}</span>}
										</span>
									</figcaption>
								)}
							</figure>
						)
						return card
					})}
				</div>
			)
		}
	</div>
</section>
)}

<style>
	.t {
		padding-block: 80px;
	}
	.t--band {
		border-block: 1px solid var(--k-border);
	}
	.t-inner {
		display: flex;
		flex-direction: column;
		gap: 44px;
	}
	.t-rule {
		margin: 0;
	}
	/* The testimonials eyebrow is a half point smaller than the shared eyebrow on the source. */
	.t-head .k-eyebrow {
		font-size: 12px;
	}
	.t-head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 560px;
	}
	.t-title {
		font-size: var(--ds-size-heading, 34px);
		line-height: 1.1;
		letter-spacing: -0.8px;
		font-weight: 700;
	}
	/* Large card on the left spans the height of the stacked small cards on the right. */
	.t-row {
		display: grid;
		gap: 18px;
	}
	.t-row--split {
		grid-template-columns: minmax(0, 1.63fr) minmax(0, 1fr);
		grid-template-rows: repeat(var(--t-rest, 2), auto);
	}
	.t-row--split .t-card--lg {
		grid-row: 1 / -1;
	}
	.t-card {
		display: flex;
		flex-direction: column;
		margin: 0;
		color: var(--k-heading);
	}
	.t-card--lg {
		gap: 26px;
		padding: 36px 34px;
	}
	.t-card--sm {
		gap: 18px;
		padding: 24px;
	}
	.t-quote {
		margin: 0;
	}
	.t-card--lg .t-quote {
		font-family: var(--font-heading);
		font-size: 24px;
		line-height: 34px;
		letter-spacing: -0.4px;
		font-weight: 600;
	}
	.t-card--sm .t-quote {
		font-size: 15px;
		line-height: 23px;
	}
	.t-card--lg .t-author {
		margin-top: auto;
	}
	.t-author {
		display: flex;
		align-items: center;
		gap: 11px;
	}
	.t-card--lg .t-author {
		gap: 13px;
	}
	.t-avatar {
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		object-fit: cover;
		background: color-mix(in srgb, var(--k-primary) 15%, transparent);
	}
	.t-card--lg .t-avatar {
		width: 46px;
		height: 46px;
	}
	.t-initials {
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--k-primary);
	}
	.t-id {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}
	.t-name {
		font-size: 15px;
		line-height: 1.5;
		font-weight: 600;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: var(--k-heading);
	}
	.t-meta {
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.55;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: var(--k-muted);
	}

	@media (max-width: 767px) {
		.t {
			padding-block: 56px;
		}
		.t-inner {
			gap: 32px;
		}
		.t-title {
			font-size: var(--ds-size-heading-phone, var(--ds-size-heading, 28px));
		}
		.t-row--split {
			grid-template-columns: minmax(0, 1fr);
		}
		.t-row--split .t-card--lg {
			grid-row: auto;
		}
		.t-card--lg {
			padding: 28px 24px;
		}
	}

	/* No source page puts testimonials in the article column; in one, the pair stacks instead of
	   squeezing the small cards to a third of 696px. */
	.is-narrow .t-row--split {
		grid-template-columns: minmax(0, 1fr);
	}
	.is-narrow .t-row--split .t-card--lg {
		grid-row: auto;
	}
	@media (max-width: 767px) {
		.t.is-narrow {
			margin-inline: 20px;
		}
	}
</style>
