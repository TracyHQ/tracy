          "repeat": "slide"
        }
      },
      "item": "carousel.item.<n>",
      "dropped": {
        "slide-image": "empty on the only instance; when present insert a core/image.tracy-card__media before the kicker",
        "slide-link": "empty on the only instance; when present with slide-link-text append a core/paragraph with the link",
        "slide-link-text": "see slide-link"
      }
    },
