{
  "$comment": "ACM block type (+ style) of the Tracy Base Joomla site -> the tracy-base WordPress pattern that renders it, field by field. Locate blocks by their metadata.name, never by position. Convention: every editable block in a pattern carries metadata {\"role\":\"content\",\"name\":\"<type>.<field>[.<n>]\"} where <type> is the ACM type, <field> the ACM field name (verbatim, inner name for nested groups: slide-title, not slide.slide-title), and <n> the 1-based index inside a repeated group. A repeated item's wrapper carries metadata {\"name\":\"<type>.item.<n>\"} with no role: clone or delete the wrapper to change the item count, its children keep the same names with the new index. One block that renders two ACM fields lists both, e.g. a button carries btn-1-text (its text) and btn-1-link (its href); an image carries the media field (src) and its alt field (alt). \"attr\" says which block attribute or HTML attribute the field lands in; \"repeat\" names the ACM group when the field is repeated, null otherwise. \"dropped\" lists ACM fields with no block, and why.",
  "schemaVersion": "tracy-base-patterns-map/v1",
  "types": {
    "accordion:style-1": {
      "pattern": "tracy-base/section-accordion",
      "root": ".acm-accordion",
      "fields": {
        "eyebrow": {
          "block": "core/paragraph",
          "path": "accordion.eyebrow",
          "attr": "content",
          "repeat": null
        },
        "heading": {
          "block": "core/heading",
          "path": "accordion.heading",
          "attr": "content",
          "repeat": null
        },
        "intro": {
          "block": null,
          "path": null,
          "repeat": null,
          "note": "empty on all 4 instances; add a core/paragraph.tracy-lead after the heading when present"
        },
        "surface": {
          "block": "core/group",
          "path": "root",
          "attr": "className",
          "repeat": null,
          "note": "canvas -> bg-bg (drop the band classes), warm -> bg-surface-warm, gray -> bg-surface"
        },
        "first-open": {
          "block": "core/details",
          "path": "accordion.item.1",
          "attr": "showContent",
          "repeat": null
        },
        "one-at-a-time": {
          "block": "core/details",
          "path": "accordion.item.*",
          "attr": "name",
          "repeat": null,
          "note": "any value but \"0\" means on: keep name=\"acm-accordion\" on every item; \"0\" removes it"
        },
        "entry-question": {
          "block": "core/details",
          "path": "accordion.item.<n>",
          "attr": "summary",
          "repeat": "entries"
        },
        "entry-answer": {
          "block": "core/paragraph",
          "path": "accordion.entry-answer.<n>",
          "attr": "content",
          "repeat": "entries"
        }
      },
      "item": "accordion.item.<n>"
    },
