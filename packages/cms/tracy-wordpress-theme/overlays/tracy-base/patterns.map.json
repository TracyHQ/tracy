        "tab-body": {
          "block": "core/paragraph",
          "path": "tabs.tab-body.<n>",
          "attr": "content",
          "repeat": "tab",
          "note": "the source stores HTML; one <p> becomes this paragraph, richer HTML becomes sibling blocks inside tabs.item.<n>"
        }
      },
      "item": "tabs.item.<n>",
      "dropped": {
        "tab-image": "empty on the only instance; when present insert a core/image after the body and give the panel a two-column grid"
      }
    },
    "team:style-1": {
      "pattern": "tracy-base/section-team-grid",
      "root": ".acm-team--grid",
      "fields": {
        "eyebrow": { "block": "core/paragraph", "path": "team.eyebrow", "attr": "content", "repeat": null },
        "heading": { "block": "core/heading", "path": "team.heading", "attr": "content", "repeat": null },
        "columns": {
          "block": "core/group",
          "path": "root",
          "attr": "className",
          "repeat": null,
          "note": "acm-team--cols-<N>; on the grid group lg:grid-cols-4 or lg:grid-cols-3"
        },
        "member-portrait": {
          "block": "core/image",
          "path": "team.member-portrait.<n>",
          "attr": "src",
          "repeat": "members",
          "note": "alt is the member name; when the portrait is empty remove the image (the source draws initials, core cannot)"
        },
        "member-name": {
          "block": "core/heading",
          "path": "team.member-name.<n>",
          "attr": "content",
          "repeat": "members"
        },
        "member-role": {
          "block": "core/paragraph",
          "path": "team.member-role.<n>",
          "attr": "content",
          "repeat": "members"
        },
        "member-bio": {
          "block": "core/paragraph",
          "path": "team.member-bio.<n>",
          "attr": "content",
          "repeat": "members"
        }
      },
      "item": "team.item.<n>",
      "dropped": {
        "link-label": "empty on both instances; with member-link, append a core/paragraph link to the member",
        "member-link": "see link-label"
      }
    },
    "team:style-2": {
      "pattern": "tracy-base/section-team-query",
      "root": ".acm-team--query",
      "fields": {
        "heading": { "block": "core/paragraph", "path": "team.heading", "attr": "content", "repeat": null },
        "source-category": {
          "block": "core/query",
          "path": "team.source-category",
          "attr": "query.taxQuery.category",
          "repeat": null,
          "note": "the WordPress term id of the category the members are posted in; the block has no category set until the seeder writes one"
        },
        "selected-members": {
          "block": "core/query",
          "path": "team.source-category",
          "attr": "query.include",
          "repeat": null,
          "note": "WordPress post ids; leave empty to take the first four of the category by menu_order, as the source does"
        }
      },
      "item": null,
      "note": "the 'all' link (team.all-link) has no ACM field: the source builds it from the category route; set its href to the category archive. The source splits 'Name — Role' out of the article title; here the post title is the name and the excerpt the role."
    },
    "testimonials:style-1": {
      "pattern": "tracy-base/section-testimonials",
      "root": ".acm-testimonials",
      "fields": {
        "eyebrow": {
          "block": "core/paragraph",
          "path": "testimonials.eyebrow",
          "attr": "content",
          "repeat": null
        },
        "heading": {
          "block": "core/heading",
          "path": "testimonials.heading",
          "attr": "content",
          "repeat": null
        },
        "columns": {
          "block": "core/group",
          "path": "root",
          "attr": "className",
          "repeat": null,
          "note": "acm-testimonials--cols-<N>; on the grid group lg:grid-cols-3 or lg:grid-cols-2"
        },
        "quote": {
          "block": "core/paragraph",
          "path": "testimonials.quote.<n>",
          "attr": "content",
          "repeat": "quotes"
        },
        "quote-name": {
          "block": "core/paragraph",
          "path": "testimonials.quote-name.<n>",
          "attr": "content",
          "repeat": "quotes"
        },
        "quote-role": {
          "block": "core/paragraph",
          "path": "testimonials.quote-role.<n>",
          "attr": "content",
          "repeat": "quotes"
        }
      },
      "item": "testimonials.item.<n>",
      "dropped": {
        "quote-avatar": "empty on both instances; when present insert a core/image before the name"
      }
    },
    "timeline:style-1": {
      "pattern": "tracy-base/section-timeline",
      "root": ".acm-timeline",
      "fields": {
        "heading-level": {
          "block": "core/heading",
          "path": "timeline.heading",
          "attr": "level",
          "repeat": null
        },
        "eyebrow": {
          "block": "core/paragraph",
          "path": "timeline.eyebrow",
          "attr": "content",
          "repeat": null
        },
        "heading": { "block": "core/heading", "path": "timeline.heading", "attr": "content", "repeat": null },
        "intro": { "block": "core/paragraph", "path": "timeline.intro", "attr": "content", "repeat": null },
        "ground": {
          "block": "core/group",
          "path": "root",
          "attr": "className",
          "repeat": null,
          "note": "canvas -> (none), warm -> bg-surface-warm, gray -> bg-surface; also acm-timeline--<ground>"
        },
        "entry-marker": {
          "block": "core/paragraph",
          "path": "timeline.entry-marker.<n>",
          "attr": "content",
          "repeat": "entry"
        },
        "entry-title": {
          "block": "core/heading",
          "path": "timeline.entry-title.<n>",
          "attr": "content",
          "repeat": "entry"
        },
        "entry-text": {
          "block": "core/paragraph",
          "path": "timeline.entry-text.<n>",
          "attr": "content",
          "repeat": "entry"
        }
      },
      "item": "timeline.item.<n>"
    }
  }
}
