{
  "slug": "tracy-base",
  "themeName": "Tracy Base",
  "textDomain": "tracy-base",
  "description": "Tracy Base: the reviewed Tracy company site as a WordPress block theme — light and dark, editable sections, and the Airbnb look as a second style.",
  "variations": ["apple", "airbnb"],
  "rootVariation": "apple",
  "updateSlug": "tracy-base",
  "version": "1.1.9",
  "roleReads": {
    "--bg": "--ds-c-bg",
    "--surface": "--ds-c-surface",
    "--surface-warm": "--ds-c-surface-warm",
    "--fg": "--ds-c-fg",
    "--fg-2": "--ds-c-fg-2",
    "--muted": "--ds-c-muted",
    "--meta": "--ds-c-meta",
    "--border": "--ds-c-border",
    "--border-soft": "--ds-c-border-soft",
    "--accent": "--ds-c-accent",
    "--accent-on": "--ds-c-accent-on",
    "--accent-hover": "--ds-c-accent-hover",
    "--accent-active": "--ds-c-accent-active",
    "--success": "--ds-c-success",
    "--warn": "--ds-c-warn",
    "--danger": "--ds-c-danger",
    "--font-display": "--ds-font-display",
    "--font-body": "--ds-font-body",
    "--radius-sm": "--ds-input-radius",
    "--radius-md": "--ds-btn-radius",
    "--radius-lg": "--ds-card-radius",
    "--radius-pill": "--ds-pill-radius",
    "--focus-ring": {
      "colour": "--ds-c-focus-ring"
    },
    "--elev-raised": {
      "keep": "shadow depth, not a colour role"
    }
  }
}
