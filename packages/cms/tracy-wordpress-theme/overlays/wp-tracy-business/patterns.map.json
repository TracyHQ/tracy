{
  "$comment": "Spec sectionType → the wp-tracy-business pattern that renders it, field by field, for the seeder's renderTypedSection (skills/tracy-wordpress-theme/scripts/seed.mjs). UNIFORM SCHEMA, the same for every type: metadata.name = <type>.eyebrow · <type>.heading (level from fields.headingLevel) · <type>.intro · <type>.cta.<n> (a core/button: text + href) · <type>.img · items in a wrapper <type>.item.<n> (no role; cloned or removed to the item count) whose children are <type>.item.<n>.title|text|meta|img|href. A block is located by name, never by position. A field the spec leaves empty removes its block; a field the pattern has no block for is listed in the report, not dropped silently. \"dropped\" names spec fields a pattern deliberately does not carry, and why. \"styles\" adds root classes when a page matches (\"when\"). The CSS is assets/css/sections.css, which replaces the source theme's sheet of the same path and is enqueued by functions.php as tracy-sections — no extra enqueue needed.",
  "schemaVersion": "wp-tracy-business-patterns-map/v1",
  "namespace": "wp-tracy-business",
  "noise": {
    "introRepeatsItem": "an intro equal to an item's text is the extractor reading the first card; it is dropped",
    "ctaRepeatsItem": "a cta whose text equals an item's title is that item's own link; it leaves the ctas and gives the item its href when the item has none"
  },
  "types": {
    "hero": {
      "pattern": "wp-tracy-business/section-hero",
      "root": ".wtb-hero",
      "item": "hero.item.<n>",
      "fields": {
        "eyebrow": {
          "block": "core/paragraph",
          "path": "hero.eyebrow",
          "attr": "content",
          "repeat": null
        },
        "heading": {
          "block": "core/heading",
          "path": "hero.heading",
          "attr": "content",
          "repeat": null
        },
        "headingLevel": {
          "block": "core/heading",
          "path": "hero.heading",
          "attr": "level",
          "repeat": null
        },
        "intro": {
          "block": "core/paragraph",
          "path": "hero.intro",
          "attr": "content",
          "repeat": null
        },
        "ctas": {
          "block": "core/button",
          "path": "hero.cta.<n>",
          "attr": "text+href",
          "repeat": "ctas",
          "note": "text → the button label, href → its link; the buttons row is cloned to the count, removed when empty"
        },
        "img": {
          "block": "core/image",
          "path": "hero.img",
          "attr": "src+alt",
          "repeat": null
        },
        "items.title": {
          "block": "core/paragraph",
          "path": "hero.item.<n>.title",
          "attr": "content",
          "repeat": "items"
        },
        "items.text": {
          "block": "core/paragraph",
          "path": "hero.item.<n>.text",
          "attr": "content",
          "repeat": "items"
        },
        "items.meta": {
          "block": "core/paragraph",
          "path": "hero.item.<n>.meta",
          "attr": "content",
          "repeat": "items"
        }
      },
      "styles": {
        "404": {
          "when": {
            "view": "404"
          },
          "add": ["wtb-hero--404"],
          "note": "the 404 page: the eyebrow is the giant orange \"404\"; the pattern's image and figure band are hidden by CSS and the seeder drops them"
        }
      },
      "dropped": {}
    },
