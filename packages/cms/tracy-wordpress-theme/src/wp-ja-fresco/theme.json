{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "var(--ds-c-bg, #0a0b0a)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "var(--ds-c-surface, #1b1a1c)"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--ds-c-ink, #1a191b)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "var(--ds-c-fg, #ffffffcc)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--ds-c-heading, #ffffff)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--ds-c-muted, #ffffffcc)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--ds-c-meta, #ffffffcc)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "var(--ds-c-border, #ffffff12)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--ds-c-border-soft, #ffffff12)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "var(--ds-c-accent, #e6c9a2)"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "var(--ds-c-accent-on, #0a0b0a)"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "var(--ds-c-accent-hover, #e6c9a2)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "var(--ds-c-accent-active, #e6c9a2)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "var(--ds-c-success, #16a34a)"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "var(--ds-c-warn, #eab308)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "var(--ds-c-danger, #dc2626)"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "var(--ds-font-display, \"Playfair Display\")"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "var(--ds-font-body, Roboto)"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "20px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "32px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "46px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "2px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "4px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "6px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "8px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "10px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "12px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "16px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "24px"
        }
      ]
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.3"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "128px",
        "tablet": "64px",
        "phone": "24px"
      },
      "radius": {
        "sm": "var(--ds-input-radius, 0px)",
        "md": "var(--ds-btn-radius, 0px)",
        "lg": "var(--ds-card-radius, 0px)",
        "pill": "var(--ds-pill-radius, 980px)"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(0, 0, 0, 0.08) /* ds-keep: shadow depth, not a colour role */"
      },
      "focusRing": "0 0 0 4px var(--ds-c-focus-ring, color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%))",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.28, 0, 0.22, 1)"
      },
      "container": {
        "max": "1320px",
        "gutterDesktop": "16px",
        "gutterTablet": "18px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "wp-ja-fresco"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": {
          "text": "var:preset|color|fg"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxxl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xxl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|fg"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-on"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "typography": {
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent-hover",
            "text": "var:preset|color|accent-on"
          }
        }
      }
    },
    "css": "/* wp-ja-fresco: one look in both schemes (D-01). The source (JA Fresco, Joomla 6 T4) has a single dark look: no data-theme, no dark sheet, no switch; measured in all four variants, dark = light on every rule. The light-dark() wiring of the base theme is kept (invariant 4) with both halves equal, so the tracy_theme cookie and data-theme still work and change nothing visible. Values: tokens.css (measured 21/10 on :8401). */ :root{color-scheme:light dark;--jf-accent:var(--ds-c-accent, #e6c9a2);--wp--preset--color--bg:light-dark(var(--ds-c-bg, #0a0b0a),var(--ds-c-bg, #0a0b0a));--wp--preset--color--surface:light-dark(var(--ds-c-surface, #1b1a1c),var(--ds-c-surface, #1b1a1c));--wp--preset--color--surface-warm:light-dark(var(--ds-c-ink, #1a191b),var(--ds-c-ink, #1a191b));--wp--preset--color--fg:light-dark(var(--ds-c-fg, #ffffffcc),var(--ds-c-fg, #ffffffcc));--wp--preset--color--fg-2:light-dark(var(--ds-c-heading, #ffffff),var(--ds-c-heading, #ffffff));--wp--preset--color--muted:light-dark(var(--ds-c-muted, #ffffffcc),var(--ds-c-muted, #ffffffcc));--wp--preset--color--border:light-dark(var(--ds-c-border, #ffffff12),var(--ds-c-border, #ffffff12));--wp--preset--color--border-soft:light-dark(var(--ds-c-border-soft, #ffffff12),var(--ds-c-border-soft, #ffffff12));--wp--preset--color--accent:light-dark(var(--ds-c-accent, #e6c9a2),var(--ds-c-accent, #e6c9a2));--wp--preset--color--accent-on:light-dark(var(--ds-c-accent-on, #0a0b0a),var(--ds-c-accent-on, #0a0b0a));--wp--preset--color--accent-hover:light-dark(var(--ds-c-accent-hover, #e6c9a2),var(--ds-c-accent-hover, #e6c9a2));--wp--preset--color--accent-active:light-dark(var(--ds-c-accent-active, #e6c9a2),var(--ds-c-accent-active, #e6c9a2));}:root[data-theme=\"light\"]{color-scheme:light}:root[data-theme=\"dark\"]{color-scheme:dark}"
  },
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "fixture",
      "title": "Design system page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "artifact",
      "title": "Design page (engine)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "pricing",
      "title": "Pricing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "Landing (sections only)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-masthead",
      "title": "Page with masthead",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-masthead-article",
      "title": "Page with article heading",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-login",
      "title": "Sign-in page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-register",
      "title": "Registration page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-account",
      "title": "Account page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "topbar",
      "title": "Top bar",
      "area": "uncategorized"
    },
    {
      "name": "related",
      "title": "Related Posts",
      "area": "uncategorized"
    }
  ]
}
