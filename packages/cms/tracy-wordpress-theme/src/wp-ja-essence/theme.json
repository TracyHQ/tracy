{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1164px",
      "wideSize": "1164px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "var(--ds-c-bg, #f8f8ff)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "var(--ds-c-surface, #ffffff)"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--ds-c-surface-warm, #ffffff)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "var(--ds-c-fg, #252424b3)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--ds-c-heading, #212529)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--ds-c-muted, #6c757d)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--ds-c-meta, #86868b)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "var(--ds-c-border, #00000020)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--ds-c-border-soft, #e8e8ed)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "var(--ds-c-accent, #4d6bff)"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "var(--ds-c-accent-on, #ffffff)"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "var(--ds-c-accent-hover, #1a3eed)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "var(--ds-c-accent-active, #1a3eed)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "var(--ds-c-success, #16a34a)"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "var(--ds-c-warn, #eab308)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "var(--ds-c-danger, #dc2626)"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "var(--ds-font-display, Jost)"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "var(--ds-font-body, \"Noto Serif\")"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "16px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "18px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "24px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "32px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "40px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "9px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "18px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "27px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "36px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "45px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "54px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "72px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "108px"
        }
      ]
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.3"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "100px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "var(--ds-input-radius, 4px)",
        "md": "var(--ds-btn-radius, 8px)",
        "lg": "var(--ds-card-radius, 16px)",
        "pill": "var(--ds-pill-radius, 800px)"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(0, 0, 0, 0.08) /* ds-keep: shadow depth, not a colour role */"
      },
      "focusRing": "0 0 0 4px var(--ds-c-focus-ring, color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%))",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.28, 0, 0.22, 1)"
      },
      "container": {
        "max": "1164px",
        "gutterDesktop": "18px",
        "gutterTablet": "18px",
        "gutterPhone": "18px"
      },
      "tracy": {
        "inspiration": "wp-ja-essence"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": {
          "text": "var:preset|color|fg"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxxl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xxl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|fg"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-on"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "typography": {
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent-hover",
            "text": "var:preset|color|accent-on"
          }
        }
      }
    },
    "css": "/* wp-ja-essence: dark mode. The source (JA Essence, Joomla 6 T4) follows the OS until the visitor picks: its head script sets html[data-theme] from prefers-color-scheme, the .ja-theme-toggle button switches it (css/darkmode.css). Here every colour preset carries both halves through light-dark(): light = tokens.css (measured 01/10 on the source stand), dark = the source's --dm-* block (css/darkmode.css: bg #11151f, band #161b27, surface #1a2130, border #2b3548, text #c2c9d6, heading #eef1f6, muted #8c97a8, accent #4d6bff, accent hover #7d93ff), each read back as computed style in the design contract (desktop-dark). No attribute = auto, the OS decides; assets/js/wp-ja-essence-dark.js writes data-theme light|dark from the tracy_theme cookie before the first paint. */ :root{color-scheme:light dark;--wp--preset--color--bg:light-dark(var(--ds-c-bg, #f8f8ff),var(--ds-c-bg, #11151f));--wp--preset--color--surface:light-dark(var(--ds-c-surface, #ffffff),var(--ds-c-surface, #1a2130));--wp--preset--color--surface-warm:light-dark(var(--ds-c-surface-warm, #ffffff),var(--ds-c-surface-warm, #161b27));--wp--preset--color--fg:light-dark(var(--ds-c-fg, rgba(37,36,36,0.7)),var(--ds-c-fg, #c2c9d6));--wp--preset--color--fg-2:light-dark(var(--ds-c-heading, #212529),var(--ds-c-heading, #eef1f6));--wp--preset--color--muted:light-dark(var(--ds-c-muted, #6c757d),var(--ds-c-muted, #8c97a8));--wp--preset--color--meta:light-dark(var(--ds-c-meta, #86868b),var(--ds-c-meta, #8c97a8));--wp--preset--color--border:light-dark(var(--ds-c-border, rgba(0,0,0,0.125)),var(--ds-c-border, #2b3548));--wp--preset--color--border-soft:light-dark(var(--ds-c-border-soft, #e8e8ed),var(--ds-c-border-soft, #2b3548));--wp--preset--color--accent:light-dark(var(--ds-c-accent, #4d6bff),var(--ds-c-accent, #4d6bff));--wp--preset--color--accent-on:light-dark(var(--ds-c-accent-on, #ffffff),var(--ds-c-accent-on, #ffffff));--wp--preset--color--accent-hover:light-dark(var(--ds-c-accent-hover, #1a3eed),var(--ds-c-accent-hover, #7d93ff));--wp--preset--color--accent-active:light-dark(var(--ds-c-accent-active, #1a3eed),var(--ds-c-accent-active, #7d93ff));}:root[data-theme=\"light\"]{color-scheme:light}:root[data-theme=\"dark\"]{color-scheme:dark}"
  },
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "fixture",
      "title": "Design system page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "artifact",
      "title": "Design page (engine)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "pricing",
      "title": "Pricing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "Landing (lead slider, choice and list)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-login",
      "title": "Sign-in form",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-register",
      "title": "Registration form",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-account",
      "title": "Account (visitors are sent to the sign-in page)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-article",
      "title": "Article (card with picture, badge, heading and byline)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
