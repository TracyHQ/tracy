{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "bg", "name": "Background", "color": "#fafafa" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "surface-warm", "name": "Surface warm", "color": "var(--wp--preset--color--surface)" },
        { "slug": "fg", "name": "Foreground", "color": "#111111" },
        { "slug": "fg-2", "name": "Foreground 2", "color": "var(--wp--preset--color--fg)" },
        { "slug": "muted", "name": "Muted", "color": "#6b6b6b" },
        { "slug": "meta", "name": "Meta", "color": "var(--wp--preset--color--muted)" },
        { "slug": "border", "name": "Border", "color": "#e5e5e5" },
        { "slug": "border-soft", "name": "Border soft", "color": "var(--wp--preset--color--border)" },
        { "slug": "accent", "name": "Accent", "color": "#2f6feb" },
        { "slug": "accent-on", "name": "On accent", "color": "#ffffff" },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        { "slug": "success", "name": "Success", "color": "#17a34a" },
        { "slug": "warn", "name": "Warn", "color": "#eab308" },
        { "slug": "danger", "name": "Danger", "color": "#dc2626" }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Inter\", -apple-system, system-ui, sans-serif"
        },
        { "slug": "body", "name": "Body", "fontFamily": "\"Inter\", -apple-system, system-ui, sans-serif" },
        { "slug": "mono", "name": "Mono", "fontFamily": "ui-monospace, \"JetBrains Mono\", monospace" }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "12px" },
        { "slug": "sm", "name": "SM", "size": "14px" },
        { "slug": "base", "name": "Base", "size": "16px" },
        { "slug": "lg", "name": "LG", "size": "20px" },
        { "slug": "xl", "name": "XL", "size": "24px" },
        { "slug": "xxl", "name": "2XL", "size": "32px" },
        { "slug": "xxxl", "name": "3XL", "size": "48px" },
        { "slug": "xxxxl", "name": "4XL", "size": "64px" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "1", "name": "1", "size": "4px" },
        { "slug": "2", "name": "2", "size": "8px" },
        { "slug": "3", "name": "3", "size": "12px" },
        { "slug": "4", "name": "4", "size": "16px" },
        { "slug": "5", "name": "5", "size": "20px" },
        { "slug": "6", "name": "6", "size": "24px" },
        { "slug": "8", "name": "8", "size": "32px" },
        { "slug": "12", "name": "12", "size": "48px" }
      ]
    },
    "custom": {
      "leading": { "body": "1.5", "tight": "1.2" },
      "tracking": { "display": "-0.01em" },
      "sectionY": { "desktop": "80px", "tablet": "48px", "phone": "32px" },
      "radius": { "sm": "8px", "md": "12px", "lg": "16px", "pill": "9999px" },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 2px 8px color-mix(in oklab, var(--wp--preset--color--fg), transparent 92%)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": { "fast": "150ms", "base": "200ms" },
      "ease": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
      "container": { "max": "1200px", "gutterDesktop": "24px", "gutterTablet": "16px", "gutterPhone": "12px" }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": { "text": "var:preset|color|fg" }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xxxl" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xxl" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|xl" } },
      "link": {
        "color": { "text": "var:preset|color|fg" },
        ":hover": { "color": { "text": "var:preset|color|accent" } }
      },
      "button": {
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|accent-on" },
        "border": { "radius": "var(--wp--custom--radius--md)" },
        "typography": { "fontWeight": "600" },
        ":hover": {
          "color": { "background": "var:preset|color|accent-hover", "text": "var:preset|color|accent-on" }
        }
      }
    }
  },
  "customTemplates": [
    { "name": "landing", "title": "Landing", "postTypes": ["page"] },
    { "name": "fixture", "title": "Design system page", "postTypes": ["page"] },
    { "name": "artifact", "title": "Design page (engine)", "postTypes": ["page"] },
    { "name": "pricing", "title": "Pricing", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
