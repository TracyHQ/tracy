    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"SST\", \"Playstation SST\", Arial, Helvetica, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"SST\", \"Playstation SST\", Arial, Helvetica, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
