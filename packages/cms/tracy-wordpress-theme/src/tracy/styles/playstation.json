          "color": "#f5f7fa"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#ffffff"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--wp--preset--color--fg)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#cccccc"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#cccccc"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#f3f3f3"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0070cc"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#1eaedb"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#0068bd"
        },
        {
          "slug": "success",
          "name": "Success",
