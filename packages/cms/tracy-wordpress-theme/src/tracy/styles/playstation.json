          "name": "2XL",
          "size": "35px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "44px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "54px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1600px",
      "wideSize": "1600px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.25"
      },
      "tracking": {
        "display": "-0.1px"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "6px",
        "md": "12px",
        "lg": "24px",
        "pill": "999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(0, 0, 0, 0.08) 0 5px 9px 0"
      },
      "focusRing": "0 0 0 2px #0070cc",
      "motion": {
        "fast": "180ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1600px",
        "gutterDesktop": "64px",
        "gutterTablet": "32px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "playstation"
      }
    }
  }
}
