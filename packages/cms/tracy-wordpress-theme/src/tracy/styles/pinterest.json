        "body": "1.4",
        "tight": "1.15"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "12px",
        "md": "16px",
        "lg": "28px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 4px 16px rgba(33, 25, 34, 0.06)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, #435ee5, transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
