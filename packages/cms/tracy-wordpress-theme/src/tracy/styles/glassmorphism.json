      "leading": {
        "body": "1.55",
        "tight": "1.04"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "104px",
        "tablet": "72px",
        "phone": "52px"
      },
      "radius": {
        "sm": "16px",
        "md": "24px",
        "lg": "36px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 24px 80px rgba(79, 140, 255, 0.18)"
      },
      "focusRing": "0 0 0 4px rgba(79, 140, 255, 0.28)",
      "motion": {
        "fast": "180ms",
        "base": "280ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "container": {
        "max": "1180px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "glassmorphism"
      }
