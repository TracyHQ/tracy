        "body": "1.5",
        "tight": "1.17"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "72px",
        "phone": "48px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 2px 6px rgba(0, 0, 0, 0.12)"
      },
      "focusRing": "0 0 0 2px #ffffff, 0 0 0 4px #0f62fe",
      "motion": {
        "fast": "110ms",
        "base": "180ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0.38, 0.9)"
      },
      "container": {
        "max": "1312px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "ibm"
      }
