        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.25"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "64px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 4px 12px rgba(0, 0, 0, 0.08)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "xiaohongshu"
      }
    }
  }
}
