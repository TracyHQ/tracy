    "layout": {
      "contentSize": "1160px",
      "wideSize": "1160px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.02"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "68px",
        "phone": "48px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "20px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 18px 44px rgba(45, 42, 38, 0.12)"
      },
      "focusRing": "0 0 0 4px rgba(255, 79, 0, 0.24)",
      "motion": {
        "fast": "140ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1160px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "zapier"
      }
    }
  }
