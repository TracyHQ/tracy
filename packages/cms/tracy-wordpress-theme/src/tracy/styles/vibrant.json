      "sectionY": {
        "desktop": "96px",
        "tablet": "68px",
        "phone": "48px"
      },
      "radius": {
        "sm": "10px",
        "md": "16px",
        "lg": "24px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 18px 44px rgba(29, 24, 54, 0.14)"
      },
      "focusRing": "0 0 0 4px rgba(255, 107, 0, 0.26)",
      "motion": {
        "fast": "150ms",
        "base": "240ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1180px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
