    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"NVIDIA-EMEA\", Arial, Helvetica, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"NVIDIA-EMEA\", Arial, Helvetica, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "10px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "12px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
