        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#ffffff"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#a7a7a7"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#757575"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#898989"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#5e5e5e"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#2a2a2a"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#76b900"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#000000"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#1eaedb"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#007fff"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#3f8500"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#ef9100"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#e52020"
        }
