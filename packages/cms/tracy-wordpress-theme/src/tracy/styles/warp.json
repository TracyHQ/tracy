          "name": "Surface",
          "color": "#1f1d1b"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#faf9f6"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#afaeac"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#868584"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#666469"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(226, 226, 226, 0.35)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#353534"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#afaeac"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#454545"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Matter Regular\", \"Matter\", \"Inter\", ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Matter Regular\", \"Matter\", \"Inter\", ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Geist Mono\", \"Matter Mono Regular\", ui-monospace, \"SF Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
