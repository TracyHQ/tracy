{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Duolingo",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f7f7f7"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#3c3c3c"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--wp--preset--color--fg)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#777777"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#afafaf"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#e5e5e5"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#58cc02"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#89e219"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#58a700"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#58cc02"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#ffc800"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#ff4b4b"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Feather Bold\", \"DIN Round Pro\", \"Helvetica Neue\", sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Mona Sans\", \"Helvetica Neue\", system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "13px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "15px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "32px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "56px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1080px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.15"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "56px",
        "phone": "40px"
      },
      "radius": {
        "sm": "12px",
        "md": "16px",
        "lg": "20px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 2px var(--wp--preset--color--border)",
        "raised": "0 4px 0 #d7d7d7"
      },
      "focusRing": "0 0 0 3px rgba(28, 176, 246, 0.2)",
      "motion": {
        "fast": "180ms",
        "base": "320ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "container": {
        "max": "1080px",
        "gutterDesktop": "24px",
        "gutterTablet": "20px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "duolingo"
      }
    }
  }
}
