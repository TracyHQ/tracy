{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Notion",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f6f5f4"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "rgba(0, 0, 0, 0.95)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#31302e"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#615d59"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#a39e98"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(0, 0, 0, 0.06)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0075de"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#005bab"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#1aae39"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#dd5b00"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"NotionInter\", \"Inter\", -apple-system, system-ui, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"NotionInter\", \"Inter\", -apple-system, system-ui, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
