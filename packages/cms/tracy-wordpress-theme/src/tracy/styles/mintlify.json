{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Mintlify",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "#fafafa"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#0d0d0d"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#333333"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#666666"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#888888"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(0, 0, 0, 0.05)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#18E299"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#0d0d0d"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#0fa76e"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent-hover), black 12%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#c37d0d"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#d45656"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Geist Mono\", \"Geist Mono Fallback\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "20px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "24px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "64px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.15"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 2px 4px rgba(0, 0, 0, 0.03)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "24px"
      },
      "tracy": {
        "inspiration": "mintlify"
      }
    }
  }
}
