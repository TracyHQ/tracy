          "color": "#d0d6e0"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#8a8f98"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#62666d"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(255, 255, 255, 0.08)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(255, 255, 255, 0.05)"
        },
        {
          "slug": "accent",
          "name": "Accent",
