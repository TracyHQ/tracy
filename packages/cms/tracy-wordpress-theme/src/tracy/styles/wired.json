    "layout": {
      "contentSize": "1180px",
      "wideSize": "1180px"
    },
    "custom": {
      "leading": {
        "body": "1.55",
        "tight": "0.92"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "88px",
        "tablet": "64px",
        "phone": "44px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 16px 40px rgba(0, 0, 0, 0.14)"
      },
      "focusRing": "0 0 0 4px rgba(225, 6, 0, 0.24)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1180px",
        "gutterDesktop": "34px",
        "gutterTablet": "26px",
        "gutterPhone": "18px"
      },
      "tracy": {
        "inspiration": "wired"
      }
    }
