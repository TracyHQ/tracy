    "layout": {
      "contentSize": "1240px",
      "wideSize": "1240px"
    },
    "custom": {
      "leading": {
        "body": "1.48",
        "tight": "0.95"
      },
      "tracking": {
        "display": "-0.035em"
      },
      "sectionY": {
        "desktop": "88px",
        "tablet": "64px",
        "phone": "44px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 24px 70px rgba(255, 0, 168, 0.12)"
      },
      "focusRing": "0 0 0 4px rgba(255, 0, 168, 0.30)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1240px",
        "gutterDesktop": "36px",
        "gutterTablet": "28px",
        "gutterPhone": "18px"
      },
      "tracy": {
        "inspiration": "theverge"
      }
    }
