          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.12"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "68px",
        "phone": "48px"
      },
      "radius": {
        "sm": "4px",
        "md": "12px",
        "lg": "24px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 3px 8px rgba(60, 64, 67, 0.18)"
      },
      "focusRing": "0 0 0 4px rgba(26, 115, 232, 0.24)",
      "motion": {
        "fast": "150ms",
        "base": "250ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "material"
      }
    }
  }
