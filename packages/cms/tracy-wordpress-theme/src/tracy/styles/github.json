{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "GitHub",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f6f8fa"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#1f2328"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#1f2328"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#656d76"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#656d76"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#d0d7de"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#d8dee4"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0969da"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#0550ae"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#1a7f37"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#9a6700"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#cf222e"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "14px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "16px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "20px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "24px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "28px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "32px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.25"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "64px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "6px",
        "md": "6px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 1px 3px rgba(31, 35, 40, 0.12), 0 8px 24px rgba(66, 74, 83, 0.12)"
      },
      "focusRing": "0 0 0 3px rgba(9, 105, 218, 0.3)",
      "motion": {
        "fast": "80ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "ease-out"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "github"
      }
    }
  }
}
