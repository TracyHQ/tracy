      "sectionY": {
        "desktop": "112px",
        "tablet": "80px",
        "phone": "56px"
      },
      "radius": {
        "sm": "2px",
        "md": "6px",
        "lg": "10px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 28px 84px rgba(0, 0, 0, 0.54)"
      },
      "focusRing": "0 0 0 4px rgba(212, 175, 55, 0.32)",
      "motion": {
        "fast": "120ms",
        "base": "210ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "container": {
        "max": "1240px",
        "gutterDesktop": "40px",
        "gutterTablet": "28px",
        "gutterPhone": "18px"
      },
