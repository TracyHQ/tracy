          "name": "Foreground 2",
          "color": "#33433d"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "rgba(0, 0, 0, 0.58)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#d6dbde"
        },
        {
          "slug": "border-soft",
