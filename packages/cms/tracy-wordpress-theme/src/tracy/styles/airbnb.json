    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Airbnb Cereal VF\", \"Airbnb Cereal App\", Circular,\n    -apple-system, system-ui, \"Helvetica Neue\", Roboto, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Airbnb Cereal VF\", \"Airbnb Cereal App\", Circular,\n    -apple-system, system-ui, \"Helvetica Neue\", Roboto, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco,\n    Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
