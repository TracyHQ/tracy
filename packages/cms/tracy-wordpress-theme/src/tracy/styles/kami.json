        "body": "1.55",
        "tight": "1.25"
      },
      "tracking": {
        "display": "-1.2px"
      },
      "sectionY": {
        "desktop": "72px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 4px 24px rgba(0, 0, 0, 0.05)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent-active)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1120px",
        "gutterDesktop": "64px",
        "gutterTablet": "32px",
        "gutterPhone": "16px"
      },
