{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Together AI",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#000000"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "rgba(0, 0, 0, 0.6)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#666666"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#ebebeb"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#010120"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), white 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), white 16%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"The Future\", Arial, ui-sans-serif, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"The Future\", Arial, ui-sans-serif, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"PP Neue Montreal Mono\", Georgia, ui-monospace, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "10px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "22px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "64px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.3",
        "tight": "1.0"
      },
      "tracking": {
        "display": "-0.03em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(1, 1, 32, 0.1) 0px 4px 10px"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "together-ai"
      }
    }
  }
}
