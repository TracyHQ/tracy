    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.6",
        "tight": "1.1"
      },
      "tracking": {
        "display": "0em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(0, 0, 0, 0.05) 0px 4px 24px"
      },
      "focusRing": "0 0 0 3px rgba(56, 152, 236, 0.3)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "claude"
      }
    }
