    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.1"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "8px",
        "md": "13px",
        "lg": "20px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 4px 6px rgba(0, 0, 0, 0.08)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "minimax"
      }
    }
  }
}
