    },
    "custom": {
      "leading": {
        "body": "1.6",
        "tight": "1.1"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "60px",
        "phone": "44px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "4px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 18px 0 rgba(0, 0, 0, 0.32)"
      },
      "focusRing": "0 0 0 4px rgba(0, 240, 240, 0.32)",
      "motion": {
        "fast": "80ms",
        "base": "140ms"
      },
      "ease": {
        "standard": "steps(2, end)"
      },
      "container": {
        "max": "1100px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "tetris"
      }
    }
