{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Cohere",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#fafafa"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#000000"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#212121"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#93939f"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#d9d9dd"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#f2f2f2"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#1863dc"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 16%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#ef4444"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"CohereText\", \"Space Grotesk\", Inter, ui-sans-serif, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Unica77 Cohere Web\", Inter, Arial, ui-sans-serif, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"CohereMono\", \"JetBrains Mono\", ui-monospace, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "32px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "60px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "72px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1440px",
      "wideSize": "1440px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.0"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "60px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "8px",
        "md": "22px",
        "lg": "22px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border-soft)",
        "raised": "0 4px 16px rgba(0, 0, 0, 0.06)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1440px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "cohere"
      }
    }
  }
}
