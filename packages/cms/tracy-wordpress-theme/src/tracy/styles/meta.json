    "layout": {
      "contentSize": "1440px",
      "wideSize": "1440px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.16"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "8px",
        "md": "20px",
        "lg": "24px",
        "pill": "100px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 28px 0 rgba(0, 0, 0, 0.2),\n    0 2px 4px 0 rgba(0, 0, 0, 0.1)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1440px",
        "gutterDesktop": "40px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "meta"
      }
    }
