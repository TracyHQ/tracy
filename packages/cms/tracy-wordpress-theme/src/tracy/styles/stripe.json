          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1080px"
    },
    "custom": {
      "leading": {
        "body": "1.40",
        "tight": "1.10"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(50, 50, 93, 0.25)  0px 30px 45px -30px,\n    rgba(0,   0,  0, 0.10)  0px 18px 36px -18px"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent),\n    0 0 0 5px color-mix(in oklab, var(--wp--preset--color--accent), transparent 75%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1080px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "stripe"
      }
    }
  }
}
