    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"sohne-var\", \"Söhne\", \"Sohne\",\n    \"SF Pro Display\", -apple-system, BlinkMacSystemFont,\n    system-ui, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"sohne-var\", \"Söhne\", \"Sohne\",\n    \"SF Pro Display\", -apple-system, BlinkMacSystemFont,\n    system-ui, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"SourceCodePro\", \"Source Code Pro\",\n    ui-monospace, \"SF Mono\", \"JetBrains Mono\",\n    Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
