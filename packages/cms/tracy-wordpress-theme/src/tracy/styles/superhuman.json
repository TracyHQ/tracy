          "name": "XL",
          "size": "22px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "48px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "64px"
        }
