    "custom": {
      "leading": {
        "body": "1.35",
        "tight": "0.98"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "88px",
        "tablet": "64px",
        "phone": "44px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "8px 8px 0 #000000"
      },
      "focusRing": "0 0 0 4px #000000, 0 0 0 8px #ffef5a",
      "motion": {
        "fast": "90ms",
        "base": "140ms"
      },
      "ease": {
        "standard": "steps(2, end)"
      },
      "container": {
        "max": "1160px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "brutalism"
      }
    }
