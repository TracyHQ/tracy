        "raised": "0 0 0 2px #2338ff, 0 22px 60px rgba(0, 0, 0, 0.46)"
      },
      "focusRing": "0 0 0 4px rgba(255, 204, 0, 0.34)",
      "motion": {
        "fast": "90ms",
        "base": "160ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1080px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
