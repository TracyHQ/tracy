        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.0"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "9999px",
        "md": "9999px",
        "lg": "9999px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px var(--wp--preset--color--accent)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "replicate"
      }
    }
  }
}
