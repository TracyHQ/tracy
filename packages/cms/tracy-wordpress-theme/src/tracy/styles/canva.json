    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Canva Sans\", \"YS Text\", system-ui, -apple-system, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Canva Sans\", \"YS Text\", system-ui, -apple-system, sans-serif"
        },
        {
