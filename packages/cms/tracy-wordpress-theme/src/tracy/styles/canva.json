          "color": "#0e1318"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#3c4043"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5f6368"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#9aa0a6"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#e1e3e6"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#7d2ae8"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#6815d4"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#00b894"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#ffb020"
        },
        {
          "slug": "danger",
