{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Framer",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#000000"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#090909"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#ffffff"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#a6a6a6"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "rgba(255, 255, 255, 0.6)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "rgba(255, 255, 255, 0.4)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(0, 153, 255, 0.15)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(255, 255, 255, 0.06)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0099ff"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"GT Walsheim Framer Medium\", \"GT Walsheim Medium\", \"GT Walsheim\", -apple-system, \"Segoe UI\", Inter, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter Variable\", \"Inter\", -apple-system, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Azeret Mono\", ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "15px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "22px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "32px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "62px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "110px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.3",
        "tight": "0.95"
      },
      "tracking": {
        "display": "-0.05em"
      },
      "sectionY": {
        "desktop": "120px",
        "tablet": "80px",
        "phone": "60px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "20px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0.5px 0 0.5px rgba(255, 255, 255, 0.1),\n    0 10px 30px rgba(0, 0, 0, 0.25)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "framer"
      }
    }
  }
}
