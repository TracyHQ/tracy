{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Vercel",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#171717"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#4d4d4d"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#666666"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#808080"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(0, 0, 0, 0.04)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0070f3"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Geist\", \"Geist Sans\", -apple-system, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Geist\", \"Geist Sans\", -apple-system, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Geist Mono\", ui-monospace, \"SF Mono\", \"Roboto Mono\", Menlo, Monaco, \"Liberation Mono\", \"DejaVu Sans Mono\", \"Courier New\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "20px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "32px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "48px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.1"
      },
      "tracking": {
        "display": "-0.05em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "6px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px rgba(0, 0, 0, 0.08),\n    0 2px 2px rgba(0, 0, 0, 0.04),\n    0 8px 8px -8px rgba(0, 0, 0, 0.04),\n    0 0 0 1px #fafafa"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "vercel"
      }
    }
  }
}
