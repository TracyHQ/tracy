    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.45",
        "tight": "1.06"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "60px",
        "phone": "42px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 16px 40px rgba(0, 0, 0, 0.10)"
      },
      "focusRing": "0 0 0 3px rgba(17, 17, 17, 0.18)",
      "motion": {
        "fast": "100ms",
        "base": "180ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "mono"
      }
    }
