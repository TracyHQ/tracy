          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.50",
        "tight": "1.00"
      },
      "tracking": {
        "display": "normal"
      },
      "sectionY": {
        "desktop": "64px",
        "tablet": "40px",
        "phone": "24px"
      },
      "radius": {
        "sm": "9999px",
        "md": "6px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(0, 0, 0, 0.3) 0px 8px 8px"
      },
      "focusRing": "0 0 0 3px rgba(30, 215, 96, 0.4)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "ease"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "spotify"
      }
    }
  }
