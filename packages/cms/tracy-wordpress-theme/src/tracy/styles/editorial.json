        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 20px 50px rgba(31, 26, 22, 0.12)"
      },
      "focusRing": "0 0 0 4px rgba(154, 90, 47, 0.24)",
      "motion": {
        "fast": "180ms",
        "base": "280ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "container": {
        "max": "1120px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
