          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1100px",
      "wideSize": "1100px"
    },
    "custom": {
      "leading": {
        "body": "1.65",
        "tight": "1.2"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "64px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px var(--wp--preset--color--border)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1100px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "perplexity"
      }
    }
  }
