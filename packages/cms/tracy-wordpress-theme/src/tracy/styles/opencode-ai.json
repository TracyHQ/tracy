        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "880px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.0"
      },
      "tracking": {
        "display": "0em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 2px var(--wp--preset--color--border)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "100ms",
        "base": "150ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "880px",
        "gutterDesktop": "24px",
        "gutterTablet": "20px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "opencode-ai"
      }
    }
  }
}
