        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#9c9c9d"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#6a6b6c"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(255, 255, 255, 0.06)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(255, 255, 255, 0.04)"
        },
        {
          "slug": "accent",
