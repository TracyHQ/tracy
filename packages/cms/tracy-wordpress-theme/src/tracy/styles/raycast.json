        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "64px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.6",
        "tight": "1.1"
      },
      "tracking": {
        "display": "0px"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "6px",
        "md": "12px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "rgb(27, 28, 30) 0px 0px 0px 1px, rgb(7, 8, 10) 0px 0px 0px 1px inset",
        "raised": "rgba(255, 255, 255, 0.05) 0px 1px 0px 0px inset,\n    rgba(0, 0, 0, 0.28) 0px 1.189px 2.377px,\n    0 0 0 1px rgba(255, 255, 255, 0.06)"
      },
      "focusRing": "0 0 0 3px hsla(202, 100%, 67%, 0.35)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "raycast"
      }
    }
  }
}
