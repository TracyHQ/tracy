{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "SpaceX",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#000000"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#000000"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#f0f0fa"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--wp--preset--color--fg)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "rgba(240, 240, 250, 0.7)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(240, 240, 250, 0.35)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(240, 240, 250, 0.1)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#f0f0fa"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#000000"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#ffffff"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "#d8d8e6"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"D-DIN-Bold\", \"D-DIN\", \"DIN Alternate\", \"Helvetica Neue\", Arial, Verdana, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"D-DIN\", \"DIN Alternate\", \"Helvetica Neue\", Arial, Verdana, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "10px"
