      "sectionY": {
        "desktop": "104px",
        "tablet": "72px",
        "phone": "52px"
      },
      "radius": {
        "sm": "10px",
        "md": "18px",
        "lg": "28px",
        "pill": "9999px"
      },
      "elev": {
