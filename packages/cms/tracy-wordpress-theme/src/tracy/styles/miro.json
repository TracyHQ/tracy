        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 16px 40px rgba(5, 0, 56, 0.14)"
      },
      "focusRing": "0 0 0 4px rgba(255, 208, 47, 0.38)",
      "motion": {
        "fast": "150ms",
        "base": "230ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "container": {
        "max": "1220px",
        "gutterDesktop": "36px",
        "gutterTablet": "28px",
        "gutterPhone": "18px"
