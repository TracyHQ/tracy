          "name": "LG",
          "size": "20px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "36px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "56px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "96px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.0"
      },
      "tracking": {
        "display": "-0.05em"
      },
      "sectionY": {
        "desktop": "120px",
        "tablet": "80px",
        "phone": "48px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px rgba(176, 199, 217, 0.145),\n    0 1px 3px rgba(0, 0, 0, 0.4),\n    0 1px 2px -1px rgba(0, 0, 0, 0.4)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "32px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "resend"
      }
    }
  }
}
