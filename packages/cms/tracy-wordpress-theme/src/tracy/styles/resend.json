{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Resend",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#000000"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#000000"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#f0f0f0"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#a1a4a5"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5c5c5c"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#464a4d"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(214, 235, 253, 0.19)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(217, 237, 254, 0.145)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#ff801f"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#000000"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), white 10%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 12%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#11ff99"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#ffc53d"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#ff2047"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"ABC Favorit\", \"Inter\", -apple-system, system-ui, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", -apple-system, system-ui, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Commit Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
