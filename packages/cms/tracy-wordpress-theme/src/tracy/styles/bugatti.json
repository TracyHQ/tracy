      "leading": {
        "body": "1.58",
        "tight": "1"
      },
      "tracking": {
        "display": "-0.015em"
      },
      "sectionY": {
        "desktop": "120px",
        "tablet": "84px",
        "phone": "60px"
      },
      "radius": {
        "sm": "8px",
        "md": "14px",
        "lg": "22px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 28px 86px rgba(0, 0, 0, 0.46)"
      },
      "focusRing": "0 0 0 4px rgba(183, 199, 217, 0.28)",
      "motion": {
        "fast": "170ms",
        "base": "280ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "42px",
        "gutterTablet": "30px",
        "gutterPhone": "20px"
      },
      "tracy": {
        "inspiration": "bugatti"
      }
    }
