{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Cloudflare Kumo UI",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "oklch(98.75% 0 0)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "oklch(96% 0 0)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "oklch(21% 0.006 285.885)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--wp--preset--color--fg)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "oklch(55.6% 0 0)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "oklch(14.5% 0 0 / 0.1)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "oklch(93.5% 0 0)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "oklch(0.5772 0.2324 260)"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "oklch(48.8% 0.243 264.376)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "var(--wp--preset--color--accent-hover)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "oklch(59.6% 0.145 163.225)"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "oklch(73.9% 0.177 58.2)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "oklch(63.7% 0.237 25.331)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "13px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "14px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "16px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "20px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "24px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "30px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "36px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.2"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "64px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 1px 2px 0 oklch(0% 0 0 / 0.08)"
      },
      "focusRing": "0 0 0 2px oklch(15% 0 0)",
      "motion": {
        "fast": "150ms",
        "base": "250ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.77, 0, 0.175, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "cloudflare-kumo"
      }
    }
  }
}
