          "color": "#000000"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#000000"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "rgba(0, 0, 0, 0.55)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "rgba(0, 0, 0, 0.40)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(0, 0, 0, 0.12)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(0, 0, 0, 0.06)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#000000"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "rgba(0, 0, 0, 0.85)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"figmaSans\", \"figmaSans Fallback\", \"SF Pro Display\", system-ui, Helvetica, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"figmaSans\", \"figmaSans Fallback\", \"SF Pro Display\", system-ui, Helvetica, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"figmaMono\", \"figmaMono Fallback\", \"SF Mono\", Menlo, ui-monospace, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "16px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "20px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "26px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "26px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "64px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "86px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1920px",
      "wideSize": "1920px"
    },
    "custom": {
      "leading": {
        "body": "1.40",
        "tight": "1.00"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "50px",
        "md": "8px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 4px 16px rgba(0, 0, 0, 0.08)"
      },
      "focusRing": "0 0 0 2px rgba(0, 0, 0, 0.8)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1920px",
        "gutterDesktop": "40px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "figma"
      }
    }
  }
}
