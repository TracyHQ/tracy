        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 26px 80px rgba(0, 0, 0, 0.48)"
      },
      "focusRing": "0 0 0 4px rgba(220, 0, 0, 0.30)",
      "motion": {
        "fast": "130ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "container": {
        "max": "1240px",
        "gutterDesktop": "40px",
        "gutterTablet": "28px",
