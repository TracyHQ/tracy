    "layout": {
      "contentSize": "1440px",
      "wideSize": "1440px"
    },
    "custom": {
      "leading": {
        "body": "1.75",
        "tight": "0.9"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "8px",
        "md": "20px",
        "lg": "24px",
        "pill": "30px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px var(--wp--preset--color--border)"
      },
      "focusRing": "0 0 0 2px rgba(39, 93, 197, 1)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1440px",
        "gutterDesktop": "48px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "nike"
      }
    }
