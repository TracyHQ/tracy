          "name": "XL",
          "size": "20px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "56px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1320px"
    },
    "custom": {
      "leading": {
        "body": "1.45",
        "tight": "1.08"
      },
      "tracking": {
        "display": "-0.01em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "60px",
        "phone": "42px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 24px 80px rgba(0, 0, 0, 0.42)"
      },
      "focusRing": "0 0 0 4px rgba(56, 189, 248, 0.28)",
      "motion": {
        "fast": "90ms",
        "base": "160ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1320px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "trading-terminal"
      }
    }
  }
}
