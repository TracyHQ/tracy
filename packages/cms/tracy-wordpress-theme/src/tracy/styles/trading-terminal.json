          "name": "Surface warm",
          "color": "#162238"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#f8fafc"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#cbd5e1"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#8492a6"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#38bdf8"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#263246"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#1c2638"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#38bdf8"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#03111a"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#22c55e"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#f59e0b"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#ef4444"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "Inter, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "Inter, system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Roboto Mono\", \"SF Mono\", ui-monospace, Menlo, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "11px"
        },
        {
          "slug": "sm",
