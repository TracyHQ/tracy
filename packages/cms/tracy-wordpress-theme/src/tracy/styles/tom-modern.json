{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Tom Modern Design",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#fafafa"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#27272a"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#52525b"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#71717a"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#969696"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#d4d4d8"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#ff5a00"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#eab308"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "'Geist Sans', 'Geist', system-ui, -apple-system, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "'Geist Sans', 'Geist', system-ui, -apple-system, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "11px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "13px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "15px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "22px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "38px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "48px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1240px"
    },
    "custom": {
      "leading": {
        "body": "1.65",
        "tight": "0.96"
      },
      "tracking": {
        "display": "-0.04em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "pill": "0px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "4px 4px 0 rgba(150, 150, 150, 0.1)"
      },
      "focusRing": "0 0 0 2px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1240px",
        "gutterDesktop": "20px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "tom-modern"
      }
    }
  }
}
