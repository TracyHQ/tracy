          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1600px",
      "wideSize": "1600px"
    },
    "custom": {
      "leading": {
        "body": "1.4",
        "tight": "1.0"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "78px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "none"
      },
      "focusRing": "0 0 0 2px color-mix(in oklab, var(--wp--preset--color--accent), transparent 60%)",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1600px",
        "gutterDesktop": "48px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "runwayml"
      }
    }
  }
}
