    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.48",
        "tight": "1.08"
      },
      "tracking": {
        "display": "-0.015em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "68px",
        "phone": "48px"
      },
      "radius": {
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 18px 44px rgba(0, 0, 0, 0.12)"
      },
      "focusRing": "0 0 0 4px rgba(230, 0, 0, 0.22)",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "vodafone"
      }
    }
