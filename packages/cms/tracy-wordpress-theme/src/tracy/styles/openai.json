          "name": "Foreground 2",
          "color": "#1a1a1a"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#6e6e6e"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#9b9b9b"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#e5e5e5"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#ededed"
