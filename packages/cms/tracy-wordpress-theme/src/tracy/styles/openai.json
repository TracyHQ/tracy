          "color": "#10a37f"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#0a7a5e"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#10a37f"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#f5a623"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#ef4146"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Signifier\", \"Source Serif Pro\", Georgia, ui-serif, serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Söhne\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Söhne Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "13px"
        },
        {
          "slug": "base",
