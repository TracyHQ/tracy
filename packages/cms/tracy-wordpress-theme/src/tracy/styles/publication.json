      "sectionY": {
        "desktop": "88px",
        "tablet": "64px",
        "phone": "44px"
      },
      "radius": {
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 16px 42px rgba(0, 0, 0, 0.12)"
      },
      "focusRing": "0 0 0 4px rgba(193, 18, 31, 0.24)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1180px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
