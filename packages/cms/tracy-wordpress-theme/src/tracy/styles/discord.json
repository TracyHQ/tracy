        "tight": "1.10"
      },
      "tracking": {
        "display": "-0.02em"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(0, 0, 0, 0.4) 0px 2px 4px, 0 0 0 1px rgba(255, 255, 255, 0.06)"
      },
      "focusRing": "0 0 0 3px rgba(88, 101, 242, 0.3)",
      "motion": {
        "fast": "80ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
