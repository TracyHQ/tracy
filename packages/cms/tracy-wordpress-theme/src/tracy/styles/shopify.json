    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.56",
        "tight": "1.00"
      },
      "tracking": {
        "display": "0em"
      },
      "sectionY": {
        "desktop": "96px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "9999px",
        "md": "8px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(0, 0, 0, 0.1) 0px 0px 0px 1px,\n    rgba(0, 0, 0, 0.1) 0px 2px 2px,\n    rgba(0, 0, 0, 0.1) 0px 4px 4px,\n    rgba(0, 0, 0, 0.1) 0px 8px 8px,\n    rgba(255, 255, 255, 0.03) 0px 1px 0px inset"
      },
      "focusRing": "0 0 0 2px #36f4a4",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "ease"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "64px",
        "gutterTablet": "32px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "shopify"
      }
    }
