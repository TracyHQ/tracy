{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Wise",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#e8ebe6"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#0e0f0c"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--wp--preset--color--fg)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#868685"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(14, 15, 12, 0.12)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--wp--preset--color--border)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#9fe870"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#163300"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#cdffad"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 12%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#054d28"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#ffd11a"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#d03238"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Wise Sans\", Inter, ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "Inter, Helvetica, Arial, ui-sans-serif, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "18px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "22px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "26px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "40px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "64px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "96px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.44",
        "tight": "0.85"
      },
      "tracking": {
        "display": "normal"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "48px",
        "phone": "32px"
      },
      "radius": {
        "sm": "16px",
        "md": "30px",
        "lg": "40px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px var(--wp--preset--color--border), 0 2px 8px rgba(14, 15, 12, 0.04)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 60%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "wise"
      }
    }
  }
}
