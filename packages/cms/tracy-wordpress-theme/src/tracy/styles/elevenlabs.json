        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#4e4e4e"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#777169"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--wp--preset--color--muted)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#e5e5e5"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(0, 0, 0, 0.05)"
        },
        {
