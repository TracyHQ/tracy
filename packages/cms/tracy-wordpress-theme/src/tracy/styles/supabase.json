    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Circular\", \"custom-font\", \"Helvetica Neue\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Circular\", \"custom-font\", \"Helvetica Neue\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Source Code Pro\", \"Office Code Pro\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
