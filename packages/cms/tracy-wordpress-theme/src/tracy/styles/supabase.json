          "size": "36px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "72px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.00"
      },
      "tracking": {
        "display": "normal"
      },
      "sectionY": {
        "desktop": "128px",
        "tablet": "80px",
        "phone": "48px"
      },
      "radius": {
        "sm": "6px",
        "md": "8px",
        "lg": "16px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 0 0 1px var(--wp--preset--color--border), 0 4px 12px rgba(0, 0, 0, 0.4)"
      },
      "focusRing": "0 0 0 2px color-mix(in oklab, var(--wp--preset--color--accent), transparent 50%)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "supabase"
      }
    }
  }
}
