        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#b4b4b4"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#898989"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#4d4d4d"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#2e2e2e"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "#242424"
        },
        {
          "slug": "accent",
          "name": "Accent",
