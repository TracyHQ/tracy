    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.48",
        "tight": "1.1"
      },
      "tracking": {
        "display": "-0.015em"
      },
      "sectionY": {
        "desktop": "84px",
        "tablet": "60px",
        "phone": "42px"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "18px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 18px 46px rgba(15, 23, 42, 0.10)"
      },
      "focusRing": "0 0 0 4px rgba(14, 165, 233, 0.22)",
      "motion": {
        "fast": "120ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
        "gutterPhone": "16px"
      },
      "tracy": {
        "inspiration": "dashboard"
      }
    }
