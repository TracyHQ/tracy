{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "HashiCorp",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#15181e"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#0d0e12"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--wp--preset--color--surface)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "#efeff1"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "#d5d7db"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#b2b6bd"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "#656a76"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "rgba(178, 182, 189, 0.4)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "rgba(178, 182, 189, 0.15)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#1060ff"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "#2b89ff"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#bb5a00"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"HashiCorp Sans\", \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "13px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "20px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "26px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "42px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "52px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "82px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1150px",
      "wideSize": "1150px"
    },
    "custom": {
      "leading": {
        "body": "1.63",
        "tight": "1.17"
      },
      "tracking": {
        "display": "normal"
      },
      "sectionY": {
        "desktop": "80px",
        "tablet": "56px",
        "phone": "40px"
      },
      "radius": {
        "sm": "5px",
        "md": "8px",
        "lg": "8px",
        "pill": "5px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "rgba(97, 104, 117, 0.05) 0px 1px 1px,\n    rgba(97, 104, 117, 0.05) 0px 2px 2px"
      },
      "focusRing": "0 0 0 3px var(--wp--preset--color--accent)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1150px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "hashicorp"
      }
    }
  }
}
