        "body": "1.43",
        "tight": "1.20"
      },
      "tracking": {
        "display": "normal"
      },
      "sectionY": {
        "desktop": "120px",
        "tablet": "72px",
        "phone": "48px"
      },
      "radius": {
        "sm": "4px",
        "md": "12px",
        "lg": "12px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 2px 8px rgba(0, 0, 0, 0.05)"
      },
      "focusRing": "0 0 0 3px color-mix(in oklab, var(--wp--preset--color--accent), transparent 70%)",
      "motion": {
        "fast": "250ms",
        "base": "330ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.5, 0, 0, 0.75)"
      },
      "container": {
        "max": "1383px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "tesla"
      }
