{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "PostHog",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "#fdfdf8"
        },
