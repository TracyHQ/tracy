        {
          "slug": "border",
          "name": "Border",
          "color": "#bfc1b7"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "color-mix(in oklab, var(--wp--preset--color--border), var(--wp--preset--color--bg) 50%)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#F54E00"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "#ffffff"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 8%)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "color-mix(in oklab, var(--wp--preset--color--accent), black 14%)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "#F7A501"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"IBM Plex Sans Variable\", \"IBM Plex Sans\", -apple-system, system-ui, \"Avenir Next\", Avenir, \"Segoe UI\", \"Helvetica Neue\", Helvetica, Ubuntu, Roboto, Noto, Arial, sans-serif"
        },
        {
