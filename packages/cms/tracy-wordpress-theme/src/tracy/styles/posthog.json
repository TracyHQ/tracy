        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "custom": {
      "leading": {
        "body": "1.5",
        "tight": "1.2"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "48px",
        "tablet": "32px",
        "phone": "24px"
      },
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "9999px"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0px 25px 50px -12px rgba(0, 0, 0, 0.25)"
      },
      "focusRing": "0 0 0 3px rgba(59, 130, 246, 0.5)",
      "motion": {
        "fast": "150ms",
        "base": "200ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1280px",
        "gutterDesktop": "24px",
        "gutterTablet": "16px",
        "gutterPhone": "12px"
      },
      "tracy": {
        "inspiration": "posthog"
      }
    }
  }
