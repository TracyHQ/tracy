      },
      "focusRing": "0 0 0 4px rgba(96, 165, 250, 0.28)",
      "motion": {
        "fast": "130ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "container": {
        "max": "1200px",
        "gutterDesktop": "36px",
        "gutterTablet": "24px",
