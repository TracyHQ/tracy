{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Tracy Business",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "var(--ds-c-bg, #f5f3ee)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "var(--ds-c-surface, #ffffff)"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--ds-c-surface-warm, #eceae4)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "var(--ds-c-fg, #14171a)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--ds-c-fg-2, #3a3f43)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--ds-c-muted, #5a5952)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--ds-c-meta, #6b6a64)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "var(--ds-c-border, #dcd7cc)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--ds-c-border-soft, #eceae4)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "var(--ds-c-accent-text, #14483a)"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "var(--ds-c-accent-on, #ffffff)"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "var(--ds-c-accent-hover, #0f3a2e)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "var(--ds-c-accent-active, #0b2c23)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "var(--ds-c-success, #14483a)"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "var(--ds-c-warn, #da5a2a)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "var(--ds-c-danger, #b23a1c)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "var(--ds-font-display, Newsreader, serif)"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "var(--ds-font-body, Archivo, system-ui, sans-serif)"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"SF Mono\", Menlo, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "18px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "22px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "28px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "40px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "64px"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "1176px",
      "wideSize": "1176px"
    },
    "custom": {
      "leading": {
        "body": "1.6",
        "tight": "1.02"
      },
      "tracking": {
        "display": "-0.025em"
      },
      "sectionY": {
        "desktop": "88px",
        "tablet": "64px",
        "phone": "48px"
      },
      "radius": {
        "sm": "var(--ds-input-radius, 0px)",
        "md": "var(--ds-btn-radius, 0px)",
        "lg": "var(--ds-card-radius, 0px)",
        "pill": "var(--ds-pill-radius, 0px)"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(20, 23, 26, 0.10) /* ds-keep: shadow depth, not a colour role */"
      },
      "focusRing": "0 0 0 4px color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%)",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.28, 0, 0.22, 1)"
      },
      "container": {
        "max": "1176px",
        "gutterDesktop": "32px",
        "gutterTablet": "32px",
        "gutterPhone": "32px"
      },
      "tracy": {
        "inspiration": "wp-tracy-business"
      }
    }
  }
}
