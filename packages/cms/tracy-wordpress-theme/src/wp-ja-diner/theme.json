{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1260px",
      "wideSize": "1260px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "bg",
          "name": "Background",
          "color": "var(--ds-c-bg, #fcfaf6)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "var(--ds-c-surface, #ffffff)"
        },
        {
          "slug": "surface-warm",
          "name": "Surface warm",
          "color": "var(--ds-c-ink, #222222)"
        },
        {
          "slug": "fg",
          "name": "Foreground",
          "color": "var(--ds-c-fg, #555555)"
        },
        {
          "slug": "fg-2",
          "name": "Foreground 2",
          "color": "var(--ds-c-heading, #222222)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--ds-c-muted, #555555)"
        },
        {
          "slug": "meta",
          "name": "Meta",
          "color": "var(--ds-c-meta, #999999)"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "var(--ds-c-border, #e8e6e3)"
        },
        {
          "slug": "border-soft",
          "name": "Border soft",
          "color": "var(--ds-c-border-soft, #c2c0be)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "var(--ds-c-accent, #c36349)"
        },
        {
          "slug": "accent-on",
          "name": "On accent",
          "color": "var(--ds-c-accent-on, #ffffff)"
        },
        {
          "slug": "accent-hover",
          "name": "Accent hover",
          "color": "var(--ds-c-accent-hover, #a34d36)"
        },
        {
          "slug": "accent-active",
          "name": "Accent active",
          "color": "var(--ds-c-accent-active, #a34d36)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "var(--ds-c-success, #16a34a)"
        },
        {
          "slug": "warn",
          "name": "Warn",
          "color": "var(--ds-c-warn, #eab308)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "var(--ds-c-danger, #dc2626)"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "var(--ds-font-display, Eczar, Georgia, serif)"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "var(--ds-font-body, \"Work Sans\", Helvetica, Arial, sans-serif)"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Work Sans\", Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "13px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "15px"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "22px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "28px"
        },
        {
          "slug": "xxl",
          "name": "2XL",
          "size": "36px"
        },
        {
          "slug": "xxxl",
          "name": "3XL",
          "size": "36px"
        },
        {
          "slug": "xxxxl",
          "name": "4XL",
          "size": "60px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "4px"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "8px"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "12px"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "16px"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "20px"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "24px"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "32px"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "48px"
        }
      ]
    },
    "custom": {
      "leading": {
        "body": "1.6",
        "tight": "1.2"
      },
      "tracking": {
        "display": "0"
      },
      "sectionY": {
        "desktop": "100px",
        "tablet": "64px",
        "phone": "40px"
      },
      "radius": {
        "sm": "var(--ds-input-radius, 0px)",
        "md": "var(--ds-btn-radius, 0px)",
        "lg": "var(--ds-card-radius, 0px)",
        "pill": "var(--ds-pill-radius, 980px)"
      },
      "elev": {
        "flat": "none",
        "ring": "0 0 0 1px var(--wp--preset--color--border)",
        "raised": "0 12px 32px rgba(0, 0, 0, 0.08) /* ds-keep: shadow depth, not a colour role */"
      },
      "focusRing": "0 0 0 4px var(--ds-c-focus-ring, color-mix(in oklab, var(--wp--preset--color--accent), transparent 65%))",
      "motion": {
        "fast": "150ms",
        "base": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.28, 0, 0.22, 1)"
      },
      "container": {
        "max": "1260px",
        "gutterDesktop": "18px",
        "gutterTablet": "18px",
        "gutterPhone": "18px"
      },
      "tracy": {
        "inspiration": "wp-ja-diner"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|bg",
      "text": "var:preset|color|fg"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "var(--wp--custom--leading--body)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "blockGap": "var:preset|spacing|4"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "var(--wp--custom--leading--tight)",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        },
        "color": {
          "text": "var:preset|color|fg"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxxl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xxl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|fg"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-on"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "typography": {
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent-hover",
            "text": "var:preset|color|accent-on"
          }
        }
      }
    },
    "css": "/* wp-ja-diner: colours in both modes. The source (JA Diner 1.0.4, Joomla 6 T3) has no dark mode; light = tokens.css, measured on the running source (21/10/2026), and every value reads the worn design system first (var(--ds-c-<role>, <the template colour>)) as the 1.0.4 sheets do. Dark is DERIVED (DECISIONS D-03): page #1a1816, white boxes #24211e, text #c9c3ba, headings #f2eee8, borders #3d3833; the accent #c36349 and the highlight yellow #ffcc00 stay. No attribute = auto, the OS decides; assets/js/wp-ja-diner-dark.js writes data-theme light|dark from the tracy_theme cookie before the first paint. */ :root{color-scheme:light dark;--jd-yellow:var(--ds-c-accent-text, #ffcc00);--wp--preset--color--bg:light-dark(var(--ds-c-bg, #fcfaf6),var(--ds-c-bg, #1a1816));--wp--preset--color--surface:light-dark(var(--ds-c-surface, #ffffff),var(--ds-c-surface, #24211e));--wp--preset--color--surface-warm:light-dark(var(--ds-c-ink, #222222),var(--ds-c-ink, #0f0e0d));--wp--preset--color--fg:light-dark(var(--ds-c-fg, #555555),var(--ds-c-fg, #c9c3ba));--wp--preset--color--fg-2:light-dark(var(--ds-c-heading, #222222),var(--ds-c-heading, #f2eee8));--wp--preset--color--muted:light-dark(var(--ds-c-muted, #555555),var(--ds-c-muted, #b3aca2));--wp--preset--color--meta:light-dark(var(--ds-c-meta, #999999),var(--ds-c-meta, #8f887e));--wp--preset--color--border:light-dark(var(--ds-c-border, #e8e6e3),var(--ds-c-border, #3d3833));--wp--preset--color--border-soft:light-dark(var(--ds-c-border-soft, #c2c0be),var(--ds-c-border-soft, #5a544d));--wp--preset--color--accent:light-dark(var(--ds-c-accent, #c36349),var(--ds-c-accent, #c36349));--wp--preset--color--accent-on:light-dark(var(--ds-c-accent-on, #ffffff),var(--ds-c-accent-on, #ffffff));--wp--preset--color--accent-hover:light-dark(var(--ds-c-accent-hover, #a34d36),var(--ds-c-accent-hover, #e08a70));--wp--preset--color--accent-active:light-dark(var(--ds-c-accent-active, #a34d36),var(--ds-c-accent-active, #e08a70));}:root[data-theme=\"light\"]{color-scheme:light}:root[data-theme=\"dark\"]{color-scheme:dark}"
  },
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "fixture",
      "title": "Design system page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "artifact",
      "title": "Design page (engine)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "pricing",
      "title": "Pricing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "Landing (sections only)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-account",
      "title": "Account page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-login",
      "title": "Sign-in page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-register",
      "title": "Registration page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-password",
      "title": "Password page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "uncategorized"
    },
    {
      "name": "search-description",
      "title": "Search page description",
      "area": "uncategorized"
    },
    {
      "name": "search-form",
      "title": "Search page form and tips",
      "area": "uncategorized"
    }
  ]
}
