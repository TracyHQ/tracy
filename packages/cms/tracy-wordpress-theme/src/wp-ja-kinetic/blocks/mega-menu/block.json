{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-ja-kinetic/mega-menu",
  "version": "0.1.0",
  "title": "Mega menu",
  "category": "design",
  "icon": "menu-alt",
  "description": "A header trigger that opens a panel of columns — link lists and a short feature line. Opens on hover, focus or click; the columns are edited in place.",
  "keywords": ["menu", "navigation", "mega", "header"],
  "textdomain": "wp-ja-kinetic",
  "attributes": {
    "label": { "type": "string", "default": "Menu" }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
