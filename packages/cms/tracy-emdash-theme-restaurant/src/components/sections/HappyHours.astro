---
/** A Happy Hours banner. Three looks (style 1 = photo behind, 2 = photo beside a card, 3 = card with the photo across it); the words are fields. */
import { href, type Locale } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { lines } from '@/lib/html'
import type { Row } from '@/lib/content'
import { liveLinks } from '@/lib/link-gate'
import { dataHref } from '@/lib/data-links'

interface Props {
  entry: Row
  style: 1 | 2 | 3
  locale: Locale
}
const { entry, style, locale } = Astro.props
const $h = stampFor(Astro.request, 'happyhours', { id: entry.id, slug: entry.slug })
const bg = mediaUrl(entry.hp_bg)
const brand = mediaUrl(entry.hp_brand)
const info = lines(entry.hp_info)
// a telephone number stays on one line: the spaces between its digit groups are non-breaking
const other = lines(entry.hp_other_info).map((l) => l.replace(/(\d\)?) (?=[\d(])/g, '$1\u00a0'))
const desc = lines(entry.hp_desc)
const badge = String(entry.hp_badge ?? '').trim()
const live = await liveLinks(Astro.request, locale, [entry.hp_link])
---

<section class:list={['rs-hh', `is-style-${style}`]}>
	<div class="rs-hh-inner" style={style === 1 && bg ? `background-image:url('${bg}')` : undefined}>
		{style === 2 && bg && <img class="rs-hh-photo" src={bg} alt="" width="840" height="1200" loading="lazy" decoding="async" {...$h('hp_bg')} />}
		<div class="rs-hh-card">
			{brand && <div class="rs-hh-brand"><img src={brand} alt="" width="178" height="110" loading="lazy" decoding="async" {...$h('hp_brand')} /></div>}
			<div class="rs-hh-heading"><h2 class="rs-hh-title" {...$h('hp_title')}>{entry.hp_title}</h2></div>
			{style === 3 && bg && <img class="rs-hh-img" src={bg} alt="" width="838" height="399" loading="lazy" decoding="async" {...$h('hp_bg')} />}
			{desc.length > 0 && <p class="rs-hh-desc" {...$h('hp_desc')}>{desc.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>}
			{badge && style === 2 && <span class="rs-hh-badge" {...$h('hp_badge')}>{badge}</span>}
			{info.length > 0 && <div class="rs-hh-info" {...$h('hp_info')}><div>{info.map((l, i) => <>{i > 0 && <br />}{l}</>)}</div>{badge && style === 1 && <span class="rs-hh-badge">{badge}</span>}</div>}
			{entry.hp_link_text && live(entry.hp_link) && <div class="rs-hh-link"><a class="rs-btn" href={dataHref(entry.hp_link || '/', (p) => href(locale, p))} {...$h('hp_link_text')}>{entry.hp_link_text}</a></div>}
		</div>
		{other.length > 0 && <div class="rs-hh-other" {...$h('hp_other_info')}>{other.map((l, i) => <>{i > 0 && <br />}{l}</>)}</div>}
	</div>
</section>
