---
// Inline icons for the few symbols the text fonts lack (arrows, the appearance switch): drawn, not typed, so no
// system fallback font supplies them and the same shape shows on every machine.
interface Props {
  name: 'prev' | 'next' | 'appearance'
}
const { name } = Astro.props
---
<svg class="rs-glyph" viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
	{name === 'prev' && <path d="M14 8H2M7 3L2 8l5 5" />}
	{name === 'next' && <path d="M2 8h12M9 3l5 5-5 5" />}
	{name === 'appearance' && (<><circle cx="8" cy="8" r="6.25" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" stroke="none" /></>)}
</svg>
