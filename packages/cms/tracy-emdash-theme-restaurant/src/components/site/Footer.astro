---
import type { Chrome } from '@/lib/chrome'
import { stampFor } from '@/lib/stamps'
import { fill } from '@/lib/i18n'
import { liveLinks } from '@/lib/link-gate'

interface Props {
  chrome: Chrome
}
const { chrome } = Astro.props
const { site } = chrome
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const hours: Array<{ days: string; time: string }> = site.footer_hours ?? []
const contact: Array<{ label: string; value: string; href?: string }> = site.footer_contact ?? []
// the map link and the contact links are free text: a same-site path to an unticked page is dropped, the words stay
const live = await liveLinks(Astro.request, chrome.locale, [
  site.footer_map_url,
  ...contact.map((c) => c.href)
])
const copyright = fill(site.copyright, { year: new Date().getUTCFullYear(), name: site.brand_name })
---

<footer class="rs-footer">
	<div class="rs-wrap">
		<div class="rs-footer-cols">
			<div>
				<h3 class="rs-footer-title" {...$c('footer_location_title')}>{site.footer_location_title}</h3>
				<p {...$c('footer_address')}>{site.footer_address}</p>
				{site.footer_map_url && live(site.footer_map_url) && <a href={site.footer_map_url} target="_blank" rel="noopener" {...$c('footer_map_label')}>{site.footer_map_label}</a>}
			</div>
			<div>
				<h3 class="rs-footer-title" {...$c('footer_hours_title')}>{site.footer_hours_title}</h3>
				{hours.map((h, i) => <p><span class="rs-hl" {...$c(`footer_hours[${i}].days`)}>{h.days}:</span> <span {...$c(`footer_hours[${i}].time`)}>{h.time}</span></p>)}
			</div>
			<div>
				<h3 class="rs-footer-title" {...$c('footer_contact_title')}>{site.footer_contact_title}</h3>
				{contact.map((c, i) => (
					<p>
						<span class="rs-hl" {...$c(`footer_contact[${i}].label`)}>{c.label}:</span>{' '}
						{c.href && live(c.href) ? <a href={c.href} {...$c(`footer_contact[${i}].value`)}>{c.value}</a> : <span {...$c(`footer_contact[${i}].value`)}>{c.value}</span>}
					</p>
				))}
			</div>
		</div>
	</div>
	<div class="rs-copyright">
		<div class="rs-wrap">
			<p {...$c('copyright')}>{copyright}</p>
		</div>
	</div>
</footer>
