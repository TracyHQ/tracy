---
/** One article in a list: picture with its category badge, title, date, intro and tags. */
import { formatDate, href, type Locale } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { postPath, type PostRow } from '@/lib/posts'
import { liveLinks } from '@/lib/link-gate'

interface Props {
  post: PostRow
  locale: Locale
  tag: string
  /** The source prints tags on the home and Featured lists, not on the blog and category lists. */
  tags?: boolean
}
const { post: p, locale, tag, tags = false } = Astro.props
const cover = mediaUrl(p.cover)
// the card is drawn for any list, so it asks too: its article is a child of Blog (or Gallery)
const live = (await liveLinks(Astro.request, locale, [postPath(p)]))(postPath(p))
---

<article class="rs-post-card">
	<div class="rs-post-thumb">
		{cover && live && <a href={href(locale, postPath(p))} tabindex="-1" aria-hidden="true"><img src={cover} alt="" width="245" height="250" loading="lazy" decoding="async" /></a>}
		{p.category && <span class="rs-cat-badge">{p.category.label}</span>}
	</div>
	<div>
		<h2>{live ? <a href={href(locale, postPath(p))}>{p.title}</a> : p.title}</h2>
		<div class="rs-meta-row">{p.category && <><span class="rs-cat-meta">{p.category.label}</span><span class="rs-cat-sep" aria-hidden="true">/</span></>}<div class="rs-meta"><time datetime={p.date}>{formatDate(p.date, tag)}</time></div></div>
		{p.excerpt && <p>{p.excerpt}</p>}
		{tags && p.tags.length > 0 && <div class="rs-tags">{p.tags.map((t) => <span class="rs-tag">{t.label}</span>)}</div>}
	</div>
</article>
