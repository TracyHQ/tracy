---
/**
 * The blog family: the blog list, one category's list, Featured Articles and Tagged Items. Joomla pages by 5 and prints the
 * next 3 articles as plain links under "More Articles ..."; the same here (`?page=n`).
 */
import { getEmDashEntry } from 'emdash'
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import PostCard from '@/components/site/PostCard.astro'
import Pager from '@/components/site/Pager.astro'
import Masthead from '@/components/sections/Masthead.astro'
import Sidebar from '@/components/sections/Sidebar.astro'
import type { Chrome } from '@/lib/chrome'
import { href, type Locale } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { ui } from '@/lib/ui'
import { section } from '@/lib/content'
import { stampFor } from '@/lib/stamps'
import { BLOG_SIDEBAR, blogPosts, loadPosts, postPath } from '@/lib/posts'
import { cutAtWord } from '@/lib/excerpt'
import { livePosts } from '@/lib/link-gate'

interface Props {
  chrome: Chrome
  locale: Locale
  mode: 'blog' | 'category' | 'featured' | 'tagged'
  /** Category slug (mode `category`). */
  category?: string
  path: string
}
const { chrome, locale, mode, category, path } = Astro.props
const { site } = chrome
const { tag } = ui(locale)
const PER_PAGE = Astro.props.mode === 'tagged' ? 50 : 5
const MORE = 3

const [all, banner, mastheadSlug] = await Promise.all([
  loadPosts(locale),
  section('banner', 'banner', locale),
  Promise.resolve(mode === 'featured' ? 'featured-articles' : mode === 'tagged' ? 'tagged-items' : 'blog')
])
const masthead = await section('masthead', mastheadSlug, locale)
const blog = await livePosts(Astro.request, locale, blogPosts(all))
let list = blog
if (mode === 'category') list = blog.filter((p) => p.category?.slug === category)
if (mode === 'featured')
  list = blog.filter((p) => p.featured).sort((a, b) => a.featuredOrder - b.featuredOrder)
if (mode === 'tagged')
  list = blog
    .filter((p) => p.tags.length > 0)
    .sort((a, b) => String(a.title).localeCompare(String(b.title), 'en', { sensitivity: 'base' }))
const pages = Math.max(1, Math.ceil(list.length / PER_PAGE))
const requested = Number(Astro.url.searchParams.get('page') ?? '1')
const page = Number.isInteger(requested) && requested >= 1 && requested <= pages ? requested : 1
const cards = list.slice((page - 1) * PER_PAGE, page * PER_PAGE)
const more = mode === 'blog' || mode === 'category' ? list.slice(page * PER_PAGE, page * PER_PAGE + MORE) : []
const categories = (
  await Promise.all(
    BLOG_SIDEBAR.map(async (slug) => ({
      slug,
      label: blog.find((p) => p.category?.slug === slug)?.category?.label ?? slug
    }))
  )
).filter((c) => blog.some((p) => p.category?.slug === c.slug))
const wide = mode === 'featured'
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const heading = mode === 'tagged' ? masthead?.title : null
const title =
  mode === 'category' ? (list[0]?.category?.label ?? masthead?.title ?? '') : (masthead?.title ?? '')
---

<Base chrome={chrome} title={title} description={masthead?.description || undefined} currentPath={mode === 'category' ? '/blog' : path}>
	<Masthead masthead={masthead} fallbackTitle={title} heading={!heading} />
	<main id="main" class:list={['rs-wrap', 'rs-main', 'rs-main-list', mode === 'blog' && 'is-blog', mode === 'tagged' && 'is-tagged', mode === 'featured' && 'is-featured']}>
		<div class:list={['rs-main-grid', wide && 'is-wide']}>
			<div>
				{heading && <h1 class="rs-display rs-list-title is-plain">{heading}</h1>}
				{mode === 'tagged' ? (
					<ul class="rs-tagged-list">
						{cards.map((p) => (
							<li class="rs-media">
								{mediaUrl(p.cover) && <a href={href(locale, postPath(p))} tabindex="-1" aria-hidden="true"><img src={mediaUrl(p.cover)!} alt="" width="120" height="120" loading="lazy" decoding="async" /></a>}
								<div>
									<h3 class="rs-tag-title"><a href={href(locale, postPath(p))}>{p.title}</a></h3>
									{p.excerpt && <span class="rs-tag-body">{cutAtWord(p.excerpt, 95)}</span>}
								</div>
							</li>
						))}
					</ul>
				) : (
					cards.map((p) => <PostCard post={p} locale={locale} tag={tag} tags={mode === 'featured'} />)
				)}
				{more.length > 0 && (
					<div class="rs-more">
						<h3 class="rs-more-title" {...$c('more_label')}>{site.more_label}</h3>
						<ul>{more.map((p) => <li><a href={href(locale, postPath(p))}>{p.title}</a></li>)}</ul>
					</div>
				)}
				<Pager locale={locale} base={href(locale, path)} page={page} pages={pages} prev={site.prev_label} next={site.next_label} />
			</div>
			{!wide && <Sidebar locale={locale} categories={categories} banner={mode === 'tagged' ? null : banner} title={site.categories_title} prevLabel={site.prev_label} nextLabel={site.next_label} chromeEntry={chrome.entry} />}
		</div>
	</main>
</Base>
