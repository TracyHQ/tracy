{
  "schemaVersion": "tracy-personalize/v1",
  "note": "What tools/personalize.mjs changes on a customer's copy of THIS template from their questionnaire answers (seed/questions.json: name, languages, address and hotline, e-mail). `identity` is the customer's own words, written exactly (an answer they did not give keeps the template's value, named in the report under `unanswered`); `replace` rewrites the demo brand everywhere it appears; `copy` and `rewrite` are prose a model writes for a charity with the demo text as the length-and-register reference; `facts` are claims about the demo charity (counts, amounts, hours, history), emptied and never invented; `labels` are the words of the interface the tool writes in the site's language. Values use {name} {phone} {address} {email} {year}.",
  "settings": {
    "title": "{name}"
  },
  "brand": {
    "note": "The logo for dark backgrounds: the header and the footer draw it on the navy band.",
    "logoDark": {
      "collection": "chrome",
      "slug": "chrome",
      "field": "logo_dark",
      "label": "Logo for dark backgrounds"
    }
  },
  "identity": [
    {
      "collection": "chrome",
      "slug": "chrome",
      "field": "brand_name",
      "value": "{name}"
    },
    {
      "collection": "chrome",
      "slug": "chrome",
      "field": "copyright",
      "value": {
        "en": "Copyright © {year} {name}. All Rights Reserved.",
        "vi": "Bản quyền © {year} {name}. Bảo lưu mọi quyền.",
        "de": "Copyright © {year} {name}. Alle Rechte vorbehalten.",
        "fr": "Copyright © {year} {name}. Tous droits réservés.",
        "it": "Copyright © {year} {name}. Tutti i diritti riservati.",
        "nl": "Copyright © {year} {name}. Alle rechten voorbehouden.",
        "es": "Copyright © {year} {name}. Todos los derechos reservados.",
        "zh": "版权所有 © {year} {name}。保留所有权利。由 JoomlArt.com 设计。"
      }
    },
    {
      "collection": "contact_info",
      "slug": "topbar-contact",
      "field": "items",
      "rowKey": "sub_title",
      "rows": {
        "Our address:": {
          "fields": {
            "title": "{address}"
          }
        },
        "You may send an email": {
          "fields": {
            "title": "{email}",
            "link": "mailto:{email}"
          }
        },
        "  Helpline and support": {
          "fields": {
            "title": "{phone}"
          }
        }
      },
      "unanswered": "keep-demo"
    },
    {
      "collection": "contact_info",
      "slug": "footer-contact",
      "field": "items",
      "rowKey": "sub_title",
      "rows": {
        "Email us": {
          "fields": {
            "title": "{email}",
            "link": "mailto:{email}"
          }
        },
        "Our address": {
          "fields": {
            "title": "{address}"
          }
        },
        "Support 24/7": {
          "fields": {
            "title": "{phone}"
          }
        }
      },
      "unanswered": "keep-demo"
    },
    {
      "collection": "contact",
      "slug": "contact",
      "field": "address",
      "value": "{address}",
      "unanswered": "keep-demo"
    },
    {
      "collection": "contact",
      "slug": "contact",
      "field": "phone",
      "value": "{phone}",
      "unanswered": "keep-demo"
    },
    {
      "collection": "contact",
      "slug": "contact",
      "field": "email",
      "value": "{email}",
      "unanswered": "keep-demo"
    },
    {
      "collection": "cta",
      "slug": "home-helpline",
      "field": "cta_highlight",
      "value": "{phone}",
      "unanswered": "keep-demo"
    }
  ],
  "replace": [
    {
      "find": "JA Impact",
      "with": "{name}"
    },
    {
      "find": "Impact",
      "with": "{name}"
    }
  ],
