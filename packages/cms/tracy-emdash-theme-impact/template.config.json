{
	"id": "tracy-impact",
	"label": "JA Impact",
	"version": "0.1.0",
	"locales": [
		"en"
	],
	"defaultLocale": "en",
	"site": {
		"title": "JA Impact",
		"tagline": ""
	},
	"contentOrder": [
		"posts",
		"donations",
		"events",
		"pages",
		"hero",
		"features",
		"cta",
		"contact_info",
		"social",
		"accordion",
		"masthead",
		"contact",
		"chrome"
	],
	"forms": {
		"file": "tools/forms.json",
		"bindings": [
			{
				"form": "contact-{locale}",
				"collection": "contact",
				"slug": "contact",
				"field": "form_id"
			},
			{
				"form": "subscribe-{locale}",
				"collection": "chrome",
				"slug": "chrome",
				"field": "form_id"
			}
		]
	},
	"mail": {
		"fromEmail": "no-reply@ja-impact.example",
		"fromName": "JA Impact"
	},
	"audit": {
		"indexable": [
			"^/(?!search)(?!404$).*"
		],
		"noindex": [
			"^/search"
		],
		"notFound": [
			"^/404$"
		],
		"canonicalQuery": [
			"page"
		],
		"unknownProbes": [
			"/blog/nope",
			"/donations/nope",
			"/events/nope"
		],
		"alternates": "all-locales"
	},
	"vendor": {
		"name": "JoomlArt",
		"domains": [
			"joomlart.com"
		]
	},
	"qa": {
		"theme": {
			"selector": "html",
			"attribute": "data-theme",
			"values": {
				"light": "light",
				"dark": "dark"
			},
			"storageKey": "tracy-impact-theme"
		},
		"expectedStatus": {
			"/404": 404
		}
	},
	"$comment": "Template identity and site-specific wiring read by the generic tools. Demo content: the JA Impact sample site (a charity and fundraising site)."
}
