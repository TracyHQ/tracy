---
/** The Home blog masonry (the source's latest articles of the Blog category): date and author over the title; a picture on top where the article has one, a green card where it has none. */
import type { Chrome } from '@/lib/chrome'
import { href, formatDate } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { articlePath, type Article } from '@/lib/articles'
import { uiTag } from '@/lib/ui'
import { uiDate } from '@/lib/ui-words'

interface Props {
  entries: Article[]
  chrome: Chrome
  /** The blog list prints the short publish date (`Aug 27, 2023`, field `date`); the Home prints the creation date in full. */
  short?: boolean
}
const { entries, chrome, short = false } = Astro.props
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const tag = uiTag(chrome.locale)
const when = (e: Record<string, any>) => {
  if (!short) return formatDate(e.created || e.date, tag)
  const d = new Date(`${String(e.date ?? '').replace(' ', 'T')}${/[zZ]|[+-]\d\d:?\d\d$/.test(String(e.date)) ? '' : 'Z'}`)
  return uiDate(tag, d, { month: 'short', day: '2-digit', year: 'numeric' })
}
---

{(short ? [1, 2, 3] : [3]).map((n) => (
	<div class:list={['im-blog', short && `im-blog-${n}`]}>
		{Array.from({ length: n }, (_, col) => entries.filter((_e, i) => i % n === col)).map((col) => (
			<div class="im-blog-col">
	{col.map((e) => {
		const i = entries.indexOf(e)
		const $p = stampFor(Astro.request, 'posts', { id: e.id, slug: e.slug })
		const img = mediaUrl(e.cover)
		return (
			<article class:list={['im-post', !img && i === 0 && 'is-plain']}>
				{img && <a class="im-post-image" href={href(chrome.locale, articlePath('posts', e.slug))} tabindex="-1" aria-hidden="true"><img src={img} alt="" loading="lazy" decoding="async" /></a>}
				<div class="im-post-body">
					<p class="im-post-meta"><span {...$p('date')}>{when(e)}</span>{e.author && <> <span class="im-dash">—</span> <span {...$c('by_label')}>{chrome.site.by_label}</span> <span class="im-post-author" {...$p('author')}>{e.author}</span></>}</p>
					<h3><a href={href(chrome.locale, articlePath('posts', e.slug))} {...$p('title')}>{e.title}</a></h3>
				</div>
			</article>
		)
	})}
			</div>
		))}
	</div>
))}
