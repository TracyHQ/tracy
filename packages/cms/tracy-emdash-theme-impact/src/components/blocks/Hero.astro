---
/** acm hero style-1: a full-width picture per slide under a dark wash, the eyebrow, the 72 px title, a line of text and a button; the slides turn by their dots. */
import type { Chrome } from '@/lib/chrome'
import { href } from '@/lib/i18n'
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { liveLinks } from '@/lib/link-gate'
import { dataHref } from '@/lib/data-links'
import Icon from '@/components/site/Icon.astro'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
}
const { entry, chrome } = Astro.props
const $h = stampFor(Astro.request, 'hero', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const live = await liveLinks(Astro.request, chrome.locale, items.flatMap((i) => [i.btn_link, i.btn_link_2]))
const link = (u: string) => dataHref(u, (p) => href(chrome.locale, p))
const bg = (v: unknown) => {
  const u = mediaUrl(v as any)
  return u ? `background-image:url('${u}')` : undefined
}
const lines = (v: unknown) => String(v ?? '').split('\n')
---

{items[0] && (
	<section class="im-hero" aria-label={entry.title} data-carousel>
		<div class="im-hero-track" data-track>
			{items.map((it, i) => (
				<div class="im-hero-slide" style={bg(it.image_hero)} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
					<div class="im-container">
						<div class="im-hero-content">
							{it.sub_title && <div class="im-hero-sub" {...$h(`items[${i}].sub_title`)}>{it.sub_title}</div>}
							<h1 class="im-hero-title" {...$h(`items[${i}].title`)}>{it.title}</h1>
							<p class="im-hero-desc" {...$h(`items[${i}].desc`)}>{it.desc}</p>
							<div class="im-hero-actions">
								{it.button && live(it.btn_link) && <a class="im-btn" href={link(it.btn_link)!} {...$h(`items[${i}].button`)}>{it.button}<Icon name={it.btn_icon} /></a>}
								{it.button_2 && live(it.btn_link_2) && <a class="im-btn is-white" href={link(it.btn_link_2)!} {...$h(`items[${i}].button_2`)}>{it.button_2}<Icon name={it.btn_icon_2} /></a>}
							</div>
						</div>
					</div>
				</div>
			))}
		</div>
		{items.length > 1 && (
			<div class="im-dots" role="group" aria-label={chrome.site.slides_label}>
				{items.map((_, i) => <button type="button" class:list={['im-dot', i === 0 && 'is-active']} data-dot={i} aria-label={`${chrome.site.slide_label} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
			</div>
		)}
	</section>
)}
