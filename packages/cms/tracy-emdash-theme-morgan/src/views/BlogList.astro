---
/**
 * The blog list (Joomla category blog): masthead · a two-column grid of cards (six per page) beside the sidebar (the newest
 * posts, the categories with their counts, the tags) · pagination. `?start=N` is the offset of the first card of a page, as the
 * source's address names it.
 */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import PostCard from '@/components/site/PostCard.astro'
import PostGlyph from '@/components/site/PostGlyph.astro'
import BlogSidebar from '@/components/site/BlogSidebar.astro'
import Masthead from '@/components/blocks/Masthead.astro'
import type { Chrome } from '@/lib/chrome'
import { href, type Locale } from '@/lib/i18n'
import { ui } from '@/lib/ui'
import { fillWords } from '@/lib/ui-words'
import { section } from '@/lib/content'
import { stampFor } from '@/lib/stamps'
import { loadPosts } from '@/lib/posts'
import { livePosts } from '@/lib/link-gate'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const { tag, w } = ui(locale)
const CARDS = 6

const [{ entry: pageEntry }, masthead, all] = await Promise.all([
  getEmDashEntry('pages', 'blog', { locale }),
  section('masthead', 'blog', locale),
  loadPosts(locale)
])
const list = await livePosts(Astro.request, locale, all)

// ?start=N: a whole multiple of the page size inside the list; anything else is a page that does not exist.
const pages = Math.max(1, Math.ceil(list.length / CARDS))
const raw = Astro.url.searchParams.get('start')
const start = raw === null ? 0 : /^[0-9]+$/.test(raw) ? Number(raw) : -1
if (start < 0 || start % CARDS !== 0 || start / CARDS >= pages) {
  Astro.response.status = 404
  return Astro.rewrite(href(locale, '/404'))
}
const page = start / CARDS + 1
const cards = list.slice(start, start + CARDS)

const p = pageEntry?.data as Record<string, any> | undefined
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: p?.id, slug: 'blog' } : null)
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const url = (n: number) => href(locale, n === 1 ? '/blog' : `/blog?start=${(n - 1) * CARDS}`)
const numbers = Array.from({ length: pages }, (_, k) => k + 1)
---

<Base chrome={chrome} title={masthead?.title ?? p?.title ?? ''} currentPath="/blog" content={pageEntry ? { collection: 'pages', id: p?.id, slug: 'blog', toPath: () => '/blog' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		<Masthead entry={masthead} left />
		<div class="mg-main-body">
			<div class="mg-container">
				<div class="mg-blog">
					<div class="mg-blog-main">
						<div class="mg-blog-grid">
							{cards.map((post, i) => (
								<div class="mg-blog-cell"><PostCard post={post} locale={locale} tag={tag} by={chrome.site.by_label} byStamp={$c('by_label')} eager={i < 2} /></div>
							))}
						</div>
						{pages > 1 && (
							<div class="mg-pagination">
								<nav aria-label={w.pagination}>
									<ul>
										{numbers.map((n) => <li class:list={[{ 'is-active': n === page }]}>{n === page ? <span aria-current="page">{n}</span> : <a href={url(n)}>{n}</a>}</li>)}
										{page < pages && <li><a href={url(page + 1)} rel="next">{w.next}</a></li>}
									</ul>
								</nav>
								<p class="mg-pagination-count">{fillWords(w.pageOf, { page, pages })}</p>
							</div>
						)}
					</div>
					<BlogSidebar chrome={chrome} locale={locale} posts={list} tag={tag} />
				</div>
			</div>
		</div>
	</main>
</Base>
