---
/**
 * Home (DECISIONS D6, the source's "Home Style 1"): slideshow · intro cards · services boxes · missions (accordion) · case studies ·
 * philosophy · the team · the free-consultation form · client logos. The quote band is part of the footer.
 */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import FormWords from '@/components/site/FormWords.astro'
import Slideshow from '@/components/blocks/Slideshow.astro'
import FeaturesCards from '@/components/blocks/FeaturesCards.astro'
import FeaturesBox from '@/components/blocks/FeaturesBox.astro'
import FeaturesSplit from '@/components/blocks/FeaturesSplit.astro'
import Accordion from '@/components/blocks/Accordion.astro'
import Cases from '@/components/blocks/Cases.astro'
import Teams from '@/components/blocks/Teams.astro'
import Clients from '@/components/blocks/Clients.astro'
import FooterQuote from '@/components/blocks/FooterQuote.astro'
import { blockComponents } from '@emdash-cms/plugin-forms/astro'
import type { Chrome } from '@/lib/chrome'
import { uiTag } from '@/lib/ui'
import type { Locale } from '@/lib/i18n'
import { linkUrls, section } from '@/lib/content'
import { liveLinks } from '@/lib/link-gate'
import { stampFor } from '@/lib/stamps'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const [{ entry: pageEntry }, slideshow, intro, services, missions, missionsList, cases, philosophy, team, consult, clients, contact, quote] =
  await Promise.all([
    getEmDashEntry('pages', 'home', { locale }),
    section('slideshow', 'home-slideshow', locale),
    section('features_intro', 'home-intro', locale),
    section('features_intro', 'home-services', locale),
    section('features_intro', 'home-missions', locale),
    section('accordion', 'home-missions-list', locale),
    section('testimonials', 'home-cases', locale),
    section('features_intro', 'home-philosophy', locale),
    section('teams', 'home-team', locale),
    section('features_intro', 'home-consult', locale),
    section('clients', 'clients', locale),
    section('contact', 'contact-info', locale),
    section('testimonials', 'footer-quote', locale)
  ])
const page = (pageEntry?.data ?? {}) as Record<string, any>
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: page.id, slug: 'home' } : null)
const live = await liveLinks(Astro.request, locale, linkUrls([slideshow, intro, services, missions, cases, philosophy, team, consult]))
const FormEmbed = (blockComponents as any)['emdash-form']
const formId = String(contact?.form_id ?? '').trim()
---

<Base chrome={chrome} title={page.title ?? chrome.site.brand_name} currentPath="/" content={pageEntry ? { collection: 'pages', id: page.id, slug: 'home', toPath: () => '/' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		{slideshow && <Slideshow entry={slideshow} locale={locale} live={live} />}
		{intro && <FeaturesCards entry={intro} name="intro" locale={locale} live={live} />}
		{services && <FeaturesBox entry={services} name="services" locale={locale} live={live} />}
		{missions && (
			<FeaturesSplit entry={missions} name="missions" locale={locale} live={live}>
				{missionsList && <Accordion entry={missionsList} />}
			</FeaturesSplit>
		)}
		{cases && <Cases entry={cases} name="cases" locale={locale} live={live} />}
		{philosophy && <FeaturesSplit entry={philosophy} name="philosophy" locale={locale} live={live} />}
		{team && <Teams entry={team} name="team" locale={locale} live={live} />}
		{consult && (
			<FeaturesSplit entry={consult} name="consult" locale={locale} live={live}>
				{formId && <FormWords tag={uiTag(locale)}><FormEmbed node={{ formId }} /></FormWords>}
			</FeaturesSplit>
		)}
		{clients && <Clients entry={clients} name="clients" />}
	</main>
	{quote && <FooterQuote slot="after-subscribe" entry={quote} />}
</Base>
{formId && <script>import '@emdash-cms/plugin-forms/client'</script>}
