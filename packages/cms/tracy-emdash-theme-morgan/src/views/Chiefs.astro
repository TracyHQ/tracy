---
/** Chiefs: masthead · team (teams 1, six members, no button). */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import Masthead from '@/components/blocks/Masthead.astro'
import Teams from '@/components/blocks/Teams.astro'
import type { Chrome } from '@/lib/chrome'
import type { Locale } from '@/lib/i18n'
import { section } from '@/lib/content'
import { stampFor } from '@/lib/stamps'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const [{ entry: pageEntry }, masthead, team] = await Promise.all([
  getEmDashEntry('pages', 'chiefs', { locale }),
  section('masthead', 'chiefs', locale),
  section('teams', 'chiefs-team', locale)
])
const page = (pageEntry?.data ?? {}) as Record<string, any>
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: page.id, slug: 'chiefs' } : null)
---

<Base chrome={chrome} title={page.title ?? masthead?.title ?? chrome.site.brand_name} currentPath="/chiefs" content={pageEntry ? { collection: 'pages', id: page.id, slug: 'chiefs', toPath: () => '/chiefs' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		<Masthead entry={masthead} />
		{team && <Teams entry={team} chrome={chrome} />}
	</main>
</Base>
