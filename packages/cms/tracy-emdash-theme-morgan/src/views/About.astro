---
/** About Us (the source's "page-landing"): masthead · about cards · careers split · people split · the team · client logos. */
import Base from '@/layouts/Base.astro'
import PageOwner from '@/components/site/PageOwner.astro'
import Masthead from '@/components/blocks/Masthead.astro'
import FeaturesCards from '@/components/blocks/FeaturesCards.astro'
import FeaturesSplit from '@/components/blocks/FeaturesSplit.astro'
import Teams from '@/components/blocks/Teams.astro'
import Clients from '@/components/blocks/Clients.astro'
import type { Chrome } from '@/lib/chrome'
import type { Locale } from '@/lib/i18n'
import { linkUrls, section } from '@/lib/content'
import { liveLinks } from '@/lib/link-gate'
import { stampFor } from '@/lib/stamps'
import { getEmDashEntry } from 'emdash'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const [{ entry: pageEntry }, masthead, intro, careers, people, team, clients] = await Promise.all([
  getEmDashEntry('pages', 'about-us', { locale }),
  section('masthead', 'about-us', locale),
  section('features_intro', 'about-intro', locale),
  section('features_intro', 'about-careers', locale),
  section('features_intro', 'about-people', locale),
  section('teams', 'about-team', locale),
  section('clients', 'clients', locale)
])
const page = (pageEntry?.data ?? {}) as Record<string, any>
const $page = stampFor(Astro.request, 'pages', pageEntry ? { id: page.id, slug: 'about-us' } : null)
const live = await liveLinks(Astro.request, locale, linkUrls([intro, careers, people, team]))
---

<Base chrome={chrome} title={page.title ?? masthead?.title ?? ''} currentPath="/about-us" content={pageEntry ? { collection: 'pages', id: page.id, slug: 'about-us', toPath: () => '/about-us' } : null}>
	<main id="main">
		<PageOwner stamp={$page} />
		<Masthead entry={masthead} />
		{intro && <FeaturesCards entry={intro} name="about-intro" locale={locale} live={live} />}
		{careers && <FeaturesSplit entry={careers} name="careers" locale={locale} live={live} />}
		{people && <FeaturesSplit entry={people} name="people" locale={locale} live={live} />}
		{team && <Teams entry={team} name="about-team" locale={locale} live={live} />}
		{clients && <Clients entry={clients} name="about-clients" />}
	</main>
</Base>
