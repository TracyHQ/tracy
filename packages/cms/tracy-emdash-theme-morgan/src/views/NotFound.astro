---
/**
 * The error page (source: templates/ja_morgan/error.php): a centred panel (the site header and footer stay: an unknown address answers 404 with the chrome, DECISIONS D16) with the huge code, the title,
 * one line and a button home. Every word is the site entry's.
 */
import Base from '@/layouts/Base.astro'
import type { Chrome } from '@/lib/chrome'
import { href, type Locale } from '@/lib/i18n'
import { stampFor } from '@/lib/stamps'

interface Props {
  chrome: Chrome
  locale: Locale
}
const { chrome, locale } = Astro.props
const { site } = chrome
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
Astro.response.status = 404
---

<Base chrome={chrome} title={site.not_found_title ?? site.not_found_code ?? ''} currentPath="/404" robots="noindex, nofollow" bodyClass="mg-error-body">
	<main id="main" class="mg-error">
		<div class="mg-error-wrap">
			<div class="mg-error-info">
				<span class="mg-error-code" {...$c('not_found_code')}>{site.not_found_code}</span>
				<h1 {...$c('not_found_title')}>{site.not_found_title}</h1>
			</div>
			<div class="mg-error-other">
				<p {...$c('not_found_text')}>{site.not_found_text}</p>
				<div class="mg-error-redirect"><a href={href(locale, '/')} {...$c('not_found_back_label')}>{site.not_found_back_label}</a></div>
			</div>
		</div>
	</main>
</Base>
