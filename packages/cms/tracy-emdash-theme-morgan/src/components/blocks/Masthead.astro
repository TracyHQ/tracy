---
/**
 * The title band under the header (Joomla mod_jamasthead, one title / description / picture per menu item): a picture under a dark
 * veil, a centred white title and description. `entry` is a `masthead` entry; `title` overrides its title (an article's own).
 */
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'

interface Props {
  entry: Record<string, any> | null
  title?: string
  /** keep the entry's description under an overriding title */
  describe?: boolean
}
const { entry, title, describe = false } = Astro.props
const $m = stampFor(Astro.request, 'masthead', entry ? { id: entry.id, slug: entry.slug } : null)
const bg = mediaUrl(entry?.background)
const heading = title ?? entry?.title
---

{entry && (
	<div class="mg-masthead mg-sec-masthead" style={bg ? `background-image:url('${bg}')` : undefined}>
		<div class="mg-container">
			<div class="mg-masthead-detail">
				{title ? <h1 class="mg-masthead-title">{heading}</h1> : <h1 class="mg-masthead-title" {...$m('title')}>{heading}</h1>}
				{(!title || describe) && entry.description && <p class="mg-masthead-desc" {...$m('description')}>{entry.description}</p>}
				<slot />
			</div>
		</div>
	</div>
)}
