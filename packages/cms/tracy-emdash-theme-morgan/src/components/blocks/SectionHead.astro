---
/**
 * The title block every section opens with (the source's `.section-title`): the small red label (the module's sub-heading),
 * the heading and an optional lead. `center` centres it; the heading is the entry's `title` unless `titleField` says otherwise.
 */
import { stampFor } from '@/lib/stamps'
import Lines from './Lines.astro'

interface Props {
  entry: Record<string, any>
  collection: string
  center?: boolean
  lead?: string
  leadField?: string
  tag?: 'h2' | 'h3'
}
const { entry, collection, center = false, lead = '', leadField = 'block_intro', tag = 'h3' } = Astro.props
const $s = stampFor(Astro.request, collection, { id: entry.id, slug: entry.slug })
const Heading = tag
const has = entry.section_label || entry.title || lead
---

{has && (
	<div class:list={['mg-sec-title', center && 'is-center']}>
		{entry.section_label && <div class="mg-sub" {...$s('section_label')}><span>{entry.section_label}</span></div>}
		{entry.title && <Heading class="mg-sec-h" {...$s('title')}><Lines text={entry.title} /></Heading>}
		{lead && <p class="mg-lead" {...$s(leadField)}><Lines text={lead} /></p>}
	</div>
)}
