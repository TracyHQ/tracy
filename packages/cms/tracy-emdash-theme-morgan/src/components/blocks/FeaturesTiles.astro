---
/**
 * acm-features style-4 ("Our Services"): a centred heading and lead, then a four-column grid of tiles that alternate a coloured text
 * tile (icon, title, text, link) and a picture. `content_align` says on which side of its row the text tile sits.
 */
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { href, type Locale } from '@/lib/i18n'
import { dataHref } from '@/lib/data-links'
import PostGlyph from '@/components/site/PostGlyph.astro'
import Section from './Section.astro'
import Lines from './Lines.astro'

interface Props {
  entry: Record<string, any>
  name: string
  locale: Locale
  live: (url: string) => boolean
}
const { entry, name, locale, live } = Astro.props
const $s = stampFor(Astro.request, 'features_intro', { id: entry.id, slug: entry.slug })
const items = (entry.items ?? []) as Record<string, any>[]
---

<Section entry={entry} name={name}>
	<div class="mg-container">
		<div class="mg-sec-title is-center">
			{entry.section_label && <div class="mg-sub" {...$s('section_label')}><span>{entry.section_label}</span></div>}
			{entry.ft_desc && <h2 class="mg-sec-h mg-tiles-h" {...$s('ft_desc')}><Lines text={entry.ft_desc} /></h2>}
		</div>
	</div>
	<div class="mg-tiles">
		{items.map((it, i) => (
			<div class="mg-tile-row">
				{it.content_align === 'left' && <div class="mg-tile mg-tile-pic">{it.img_intro && <img src={mediaUrl(it.img_intro) ?? ''} alt="" width="360" height="360" loading="lazy" {...$s(`items.${i}.img_intro`)} />}</div>}
				<div class:list={['mg-tile', 'mg-tile-text', it.content_bg]}>
					{it.img_icon && <img class="mg-tile-icon" src={mediaUrl(it.img_icon) ?? ''} alt="" width="40" height="40" loading="lazy" {...$s(`items.${i}.img_icon`)} />}
					<h4 {...$s(`items.${i}.title`)}>{it.title}</h4>
					<p {...$s(`items.${i}.description`)}>{it.description}</p>
					{it.ft_link_title && it.ft_link && live(it.ft_link) && <a class="mg-tile-link" href={dataHref(it.ft_link, (p) => href(locale, p))} {...$s(`items.${i}.ft_link_title`)}>{it.ft_link_title}<PostGlyph name="arrow" /></a>}
					{it.ft_link_title && !(it.ft_link && live(it.ft_link)) && <span class="mg-tile-link" {...$s(`items.${i}.ft_link_title`)}>{it.ft_link_title}<PostGlyph name="arrow" /></span>}
				</div>
				{it.content_align !== 'left' && <div class="mg-tile mg-tile-pic">{it.img_intro && <img src={mediaUrl(it.img_intro) ?? ''} alt="" width="360" height="360" loading="lazy" {...$s(`items.${i}.img_intro`)} />}</div>}
			</div>
		))}
	</div>
</Section>
