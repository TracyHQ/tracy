---
/** acm-clients style-1: a row of greyed client logos above the footer, with a hairline on top. */
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import Section from './Section.astro'

interface Props {
  entry: Record<string, any>
  name: string
}
const { entry, name } = Astro.props
const $s = stampFor(Astro.request, 'clients', { id: entry.id, slug: entry.slug })
const items = (entry.items ?? []) as Record<string, any>[]
const cols = Math.max(1, Math.min(8, Number(entry.columns) || 6))
const opacity = Math.max(0, Math.min(100, Number(entry.img_opacity) || 30)) / 100
---

<Section entry={entry} name={name}>
	<div class="mg-container">
		<ul class="mg-clients" style={`--cols:${cols};--op:${opacity}`}>
			{items.map((it, i) => (
				<li>{it.client_logo && <img src={mediaUrl(it.client_logo) ?? ''} alt={it.client_name || ''} width="160" height="60" loading="lazy" {...$s(`items.${i}.client_logo`)} />}</li>
			))}
		</ul>
	</div>
</Section>
