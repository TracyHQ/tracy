---
/** acm-teams style-1: a centred heading, a grid of people (picture, name, position) and the yellow hiring strip. */
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { href, type Locale } from '@/lib/i18n'
import { dataHref } from '@/lib/data-links'
import Section from './Section.astro'
import SectionHead from './SectionHead.astro'

interface Props {
  entry: Record<string, any>
  name: string
  locale: Locale
  live: (url: string) => boolean
}
const { entry, name, locale, live } = Astro.props
const $s = stampFor(Astro.request, 'teams', { id: entry.id, slug: entry.slug })
const items = (entry.items ?? []) as Record<string, any>[]
const cols = Math.max(1, Math.min(4, Number(entry.columns) || 4))
const link = entry.more_link && live(entry.more_link) ? dataHref(entry.more_link, (p) => href(locale, p)) : null
---

<Section entry={entry} name={name}>
	<div class="mg-container">
		<SectionHead entry={entry} collection="teams" center />
		<div class="mg-team" style={`--cols:${cols}`}>
			{items.map((it, i) => (
				<div class="mg-member">
					<div class="mg-member-pic"><img src={mediaUrl(it.avatar) ?? ''} alt="" width="300" height="300" loading="lazy" {...$s(`items.${i}.avatar`)} /></div>
					<div class="mg-member-info">
						<h4 {...$s(`items.${i}.title`)}>{it.title}</h4>
						<span {...$s(`items.${i}.position`)}>{it.position}</span>
					</div>
				</div>
			))}
		</div>
		{entry.more_title && (
			<p class="mg-hiring">
				<span {...$s('more_title')}>{entry.more_title}</span>
				{entry.more_cta && (link ? <a href={link} {...$s('more_cta')}>{entry.more_cta}</a> : <b {...$s('more_cta')}>{entry.more_cta}</b>)}
			</p>
		)}
	</div>
</Section>
