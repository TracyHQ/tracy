---
/**
 * acm features-intro style-4 (text beside a picture or a YouTube video, 6/6 from 992 px; the video is a click-to-play facade, the
 * player is created by script only after the click) and style-5 (a grid of cards: number, picture and title and description).
 * `style` picks which one. A link of `#` is not a link (D11): the card title is plain text.
 */
import type { Chrome } from '@/lib/chrome'
import SectionHead from '@/components/blocks/SectionHead.astro'
import { href } from '@/lib/i18n'
import { spacing } from '@/lib/layout'
import { mediaUrl } from '@/lib/media'
import { stampFor } from '@/lib/stamps'
import { liveLinks } from '@/lib/link-gate'
import { dataHref } from '@/lib/data-links'
import { aboutDesc } from '@/lib/about-desc'

interface Props {
  entry: Record<string, any>
  chrome: Chrome
  style?: 'style-4' | 'style-5'
}
const { entry, chrome, style = 'style-5' } = Astro.props
const $f = stampFor(Astro.request, 'features_intro', { id: entry.id, slug: entry.slug })
const items: any[] = entry.items ?? []
const link = (u: string) => dataHref(u, (p) => href(chrome.locale, p))
const live = await liveLinks(Astro.request, chrome.locale, [entry.button_link, ...items.map((i) => i.link)])
const img = mediaUrl(entry.img)
const isVideo = entry.img_video === 'video' && entry.id_video
const textFirst = entry.align !== 'left'
const cols = Math.min(4, Math.max(1, Number(entry.columns) || 3))
const align = ['left', 'right'].includes(entry.align) ? entry.align : 'center'
const type = entry.type ?? 'image'
const desc = aboutDesc(entry.desc)
---

{style === 'style-4' && (
	<section class:list={['fr-section', spacing(entry.slug)]}>
		<SectionHead entry={entry} collection="features_intro" />
		<div class="fr-fa4">
			<div class="fr-fa4-row">
				<div class:list={['fr-fa4-text', textFirst ? 'is-right' : 'is-left']}>
					<div class="fr-fa4-box">
						{entry.title && <h2 class="fr-fa4-title" {...$f('title')}>{entry.title}</h2>}
						{desc && <div class="fr-fa4-desc" {...$f('desc')} set:html={desc} />}
						{entry.button && live(entry.button_link) && (
							<div class="fr-fa4-btn"><a class="fr-btn" href={link(entry.button_link)!} {...$f('button')}>{entry.button}</a></div>
						)}
					</div>
				</div>
				<div class="fr-fa4-media">
					{isVideo ? (
						<div class="fr-fa4-video" data-fr-yt={entry.id_video} data-title={entry.title}>
							{img && <img src={img} alt="" width="900" height="600" loading="lazy" {...$f('img')} />}
							<button type="button" class="fr-fa4-play" aria-label={entry.title}>
								<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
							</button>
						</div>
					) : (
						img && <div class="fr-fa4-img"><img src={img} alt="" width="672" height="672" loading="lazy" {...$f('img')} /></div>
					)}
				</div>
			</div>
		</div>
	</section>
)}

{style === 'style-5' && items.length > 0 && (
	<section class:list={['fr-section', spacing(entry.slug)]}>
		<SectionHead entry={entry} collection="features_intro" />
		<div class="fr-container">
			<ul class={`fr-fa5 is-${align}`} style={`--fa-lg:${cols};--fa-md:${Math.min(cols, 2)}`}>
				{items.map((it, i) => {
					const pic = mediaUrl(it.img_icon)
					return (
						<li class="fr-fa5-item">
							<div class="fr-fa5-inner">
								{type === 'number' && <div class="fr-fa5-number" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></div>}
								{type !== 'number' && pic && <div class="fr-fa5-icon"><img src={pic} alt="" width="100" height="100" loading="lazy" {...$f(`items[${i}].img_icon`)} /></div>}
								{it.title && (
									<h3 class="fr-fa5-title" {...$f(`items[${i}].title`)}>
										{live(it.link) ? <a href={link(it.link)!}>{it.title}</a> : it.title}
									</h3>
								)}
								{it.description && <div class="fr-fa5-desc" {...$f(`items[${i}].description`)}>{it.description}</div>}
							</div>
						</li>
					)
				})}
			</ul>
		</div>
	</section>
)}

<script>
	// Click-to-play facade: nothing from the video host is requested before the click.
	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest('.fr-fa4-play')
		const box = btn?.closest<HTMLElement>('[data-fr-yt]')
		if (!btn || !box) return
		const iframe = document.createElement('iframe')
		iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.frYt ?? '')}?autoplay=1`
		iframe.title = box.dataset.title ?? ''
		iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
		iframe.allowFullscreen = true
		box.replaceChildren(iframe)
		iframe.focus()
	})
</script>
