---
import type { Chrome, ChromeMenuItem } from '@/lib/chrome'
import { stampFor } from '@/lib/stamps'
import { href } from '@/lib/i18n'
import { brandLogos, logoSpots } from '@/lib/brand'
import { getSiteSettings } from 'emdash'
import BrandLogo from '@/components/site/BrandLogo.astro'
import PostGlyph from '@/components/site/PostGlyph.astro'
import { liveLinks } from '@/lib/link-gate'
import { menuUrls, pruneMenu } from '@/lib/menu-gate'
import { dataHref } from '@/lib/data-links'
import { telHref } from '@/lib/tel'

interface Props {
  chrome: Chrome
  currentPath: string
}
const { chrome, currentPath } = Astro.props
const { site, locale } = chrome
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const settings = await getSiteSettings()
const logos = brandLogos(settings, site.logo_dark, site.brand_name)
const active = (item: ChromeMenuItem): boolean => {
  const u = item.url
  if (u === '/') return currentPath === '/'
  return u !== '' && (currentPath === u || currentPath.startsWith(`${u}/`))
}
// the menu without the pages the customer unticked, and the pages under them
const live = await liveLinks(Astro.request, locale, menuUrls(chrome.primary))
const primary = pruneMenu(chrome.primary, live)
const phone = telHref(site.topbar_phone)
---

{(site.topbar_address || site.topbar_phone) && (
	<div class="mg-topbar">
		<div class="mg-container mg-topbar-in">
			{site.topbar_address && (
				<p class="mg-topbar-item" {...$c('topbar_address')}><PostGlyph name="pin" />{site.topbar_address}</p>
			)}
			{site.topbar_phone && (
				<p class="mg-topbar-item">
					<PostGlyph name="handset" />
					{phone ? <a href={phone} {...$c('topbar_phone')}>{site.topbar_phone}</a> : <span {...$c('topbar_phone')}>{site.topbar_phone}</span>}
				</p>
			)}
		</div>
	</div>
)}
<header class="mg-header">
	<div class="mg-container mg-header-in">
		<a class="mg-brand" href={href(locale, '/')} aria-label={site.brand_name}>
			<BrandLogo spots={logoSpots(logos, 'themed')} alt={logos.alt || site.brand_name} imgClass="mg-logo-img">
				<span class="mg-logo">{site.brand_name}<b>.</b></span>
			</BrandLogo>
		</a>
		<nav class="mg-nav" aria-label={site.menu_label}>
			<ul>
				{primary.map((item) => (
					<li class:list={[active(item) && 'is-active']}>
						<a href={dataHref(item.url, (p) => href(locale, p))} aria-current={active(item) ? 'page' : undefined}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="mg-header-r">
			<button type="button" class="mg-theme" data-theme-toggle aria-label={site.theme_label} title={site.theme_label} {...$c('theme_label')}>
				<span class="mg-theme-moon" aria-hidden="true"><PostGlyph name="moon" /></span>
				<span class="mg-theme-sun" aria-hidden="true"><PostGlyph name="sun" /></span>
			</button>
			<button type="button" class="mg-toggle" data-offcanvas-open aria-expanded="false" aria-controls="offcanvas" aria-label={site.menu_label}>
				<PostGlyph name="bars" />
			</button>
		</div>
	</div>
</header>
<div class="mg-offcanvas" id="offcanvas" data-offcanvas>
	<div class="mg-offcanvas-backdrop" data-offcanvas-close></div>
	<div class="mg-offcanvas-panel" role="dialog" aria-modal="true" aria-label={site.menu_label}>
		<div class="mg-offcanvas-head">
			<span class="mg-logo">{site.brand_name}<b>.</b></span>
			<button type="button" class="mg-offcanvas-close" data-offcanvas-close aria-label={site.close_label}>×</button>
		</div>
		<ul>
			{primary.map((item) => (
				<li class:list={[active(item) && 'is-active']}><a href={dataHref(item.url, (p) => href(locale, p))}>{item.label}</a></li>
			))}
		</ul>
	</div>
</div>
<script is:inline>
	(function () {
		var panel = document.getElementById('offcanvas');
		var open = document.querySelector('[data-offcanvas-open]');
		if (panel && open) {
			var set = function (on) {
				panel.classList.toggle('is-open', on);
				open.setAttribute('aria-expanded', on ? 'true' : 'false');
				if (!on) open.focus();
			};
			open.addEventListener('click', function () { set(true); });
			panel.querySelectorAll('[data-offcanvas-close]').forEach(function (b) { b.addEventListener('click', function () { set(false); }); });
			document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && panel.classList.contains('is-open')) set(false); });
		}
		// the colour theme: a click flips it and saves the choice, as the source's toggle does (`?theme=` is read by Base.astro and not saved)
		var t = document.querySelector('[data-theme-toggle]');
		if (t) t.addEventListener('click', function () {
			var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			try { localStorage.setItem('tracy-morgan-theme', next); } catch (e) {}
		});
	})();
</script>
