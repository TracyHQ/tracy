---
/**
 * The meta line of an article (Joomla `dl.article-info`): the author with a person glyph, the date with a calendar glyph. Author names
 * are plain text (the source's author listing pages do not exist here). The source also prints a hit counter; a static site has none
 * and the template does not invent one (DECISIONS D13).
 */
import type { PostRow } from '@/lib/posts'
import { formatDate } from '@/lib/i18n'
import PostGlyph from './PostGlyph.astro'

interface Props {
  post: PostRow
  tag: string
  by: string
  stamp: (field: string) => Record<string, string>
  /** The by-label's own stamp (chrome entry). */
  byStamp?: Record<string, string>
  eager?: boolean
}
const { post, tag, by, stamp, byStamp = {} } = Astro.props
---

<div class="mg-meta">
	{post.author && (
		<span class="mg-meta-author">
			<PostGlyph name="user" /><span class="mg-sr" {...byStamp}>{by}</span>{' '}<span {...stamp('author')}>{post.author}</span>
		</span>
	)}
	{post.date && <span class="mg-meta-date"><PostGlyph name="calendar" /><time datetime={post.date} {...stamp('date')}>{formatDate(post.date, tag)}</time></span>}
</div>
