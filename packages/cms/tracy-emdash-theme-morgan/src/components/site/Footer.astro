---
import type { Chrome } from '@/lib/chrome'
import { stampFor } from '@/lib/stamps'
import { fill, href } from '@/lib/i18n'
import { liveLinks } from '@/lib/link-gate'
import { dataHref } from '@/lib/data-links'
import PostGlyph from '@/components/site/PostGlyph.astro'

interface Props {
  chrome: Chrome
}
const { chrome } = Astro.props
const { site, locale, footer } = chrome
const $c = stampFor(Astro.request, 'chrome', chrome.entry)
const copyright = fill(site.copyright, { year: new Date().getUTCFullYear(), name: site.brand_name })
const live = await liveLinks(Astro.request, locale, footer.flatMap((c) => c.links.map((l) => l.link)))
const socials = [
  { glyph: 'facebook', url: String(site.footer_social_facebook_url ?? ''), field: 'footer_social_facebook_url' },
  { glyph: 'twitter', url: String(site.footer_social_twitter_url ?? ''), field: 'footer_social_twitter_url' },
  { glyph: 'instagram', url: String(site.footer_social_instagram_url ?? ''), field: 'footer_social_instagram_url' }
].filter((s) => s.url)
---

<footer class="mg-footer">
	<div class="mg-footer-main">
		<div class="mg-container">
			<div class="mg-footer-cols">
				{footer.map((col) => (
					<div class="mg-footer-col">
						<h3>{col.title}</h3>
						<ul>
							{col.links.map((l) => {
								const $l = stampFor(Astro.request, 'footer_links', { id: l.id, slug: l.slug })
								return (
									<li>
										{l.link && live(l.link)
											? <a href={dataHref(l.link, (p) => href(locale, p))} {...$l('label')}>{l.label}</a>
											: <span {...$l('label')}>{l.label}</span>}
									</li>
								)
							})}
						</ul>
					</div>
				))}
				{socials.length > 0 && (
					<div class="mg-footer-col mg-footer-social">
						<h3 {...$c('footer_social_title')}>{site.footer_social_title}</h3>
						<ul class="mg-social">
							{socials.map((s) => (
								<li><a class={`is-${s.glyph}`} href={s.url} aria-label={s.glyph} rel="noopener" {...$c(s.field)}><PostGlyph name={s.glyph} /></a></li>
							))}
						</ul>
					</div>
				)}
			</div>
			<div class="mg-copyright">
				<p class="mg-copyright-line" {...$c('copyright')}>{copyright}</p> <p class="mg-copyright-line" {...$c('copyright_credit')}>{site.copyright_credit}</p>
			</div>
		</div>
	</div>
</footer>
