{
  "id": "tracy-morgan",
  "label": "JA Morgan",
  "version": "0.1.0",
  "locales": [
    "en"
  ],
  "defaultLocale": "en",
  "site": {
    "title": "JA Morgan",
    "tagline": ""
  },
  "contentOrder": [
    "posts",
    "pages",
    "slideshow",
    "features_intro",
    "accordion",
    "testimonials",
    "teams",
    "clients",
    "masthead",
    "contact",
    "footer_links",
    "chrome"
  ],
  "forms": {
    "file": "tools/forms.json",
    "bindings": [
      {
        "form": "contact-{locale}",
        "collection": "contact",
        "slug": "contact-info",
        "field": "form_id"
      }
    ]
  },
  "mail": {
    "fromEmail": "no-reply@ja-morgan.example",
    "fromName": "JA Morgan"
  },
  "audit": {
    "indexable": [
      "^/(?!search)(?!404$).*"
    ],
    "noindex": [
      "^/search"
    ],
    "notFound": [
      "^/404$"
    ],
    "canonicalQuery": [
      "page"
    ],
    "unknownProbes": [
      "/blog/nope"
    ],
    "alternates": "all-locales"
  },
  "vendor": {
    "name": "JoomlArt",
    "domains": [
      "joomlart.com"
    ]
  },
  "qa": {
    "expectedStatus": {
      "/404": 404
    },
    "theme": {
      "selector": "html",
      "attribute": "data-theme",
      "values": {
        "light": null,
        "dark": "dark"
      },
      "storageKey": "tracy-morgan-theme"
    }
  },
  "$comment": "Template identity and site-specific wiring read by the generic tools. Demo content: the JA Morgan sample site (Joomla 6 quickstart 1.0.9)."
}
