# Copy to .env for a deployed site. Development needs none of these.
# Encryption key for plugin secrets at rest (generate: npx emdash secrets generate). Keep it; losing it loses the secrets.
EMDASH_ENCRYPTION_KEY=
# Public origin the site builds absolute URLs against (media, canonical, Open Graph) when behind a proxy.
EMDASH_SITE_URL=
# Where data.db lives (default ./data). uploads/ stays next to the app.
SITE_DATA_DIR=./data
# Runtime bind for `node dist/server/entry.mjs` (README examples: 4370 dev, 4371 built; clean-install.sh takes the port as an argument).
HOST=127.0.0.1
PORT=4371
# Optional for tools/bootstrap-site.sh: seed the site owner as an admin (email-link sign-in lands on an existing account).
TRACY_OWNER_EMAIL=
TRACY_OWNER_NAME=
