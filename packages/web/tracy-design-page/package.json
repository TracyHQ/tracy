{
  "name": "@tracy/design-page",
  "version": "0.1.0",
  "description": "The public Design inspiration page at cowork.tracy.ai/design-inspiration — the 154 design inspirations wearing Tracy's words, or a visitor's own once they type their domain; the same components the dsh tab renders, on doors that need no seat (ADR 0011)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-assets.mjs && vite",
    "build": "node scripts/build-assets.mjs && vite build",
    "build:dev": "node scripts/build-assets.mjs && vite build --mode dev",
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/web/tracy-design-page"
  },
  "dependencies": {
    "@tracy/core": "workspace:^",
    "@tracy/ui": "workspace:^",
    "linkedom": "0.18.13",
    "lucide-react": "^0.525.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
