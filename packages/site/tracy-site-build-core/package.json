{
  "name": "@tracy/site-build-core",
  "version": "0.2.0",
  "description": "Everything a Build plugin shares, whatever the CMS: the engine that runs a job's stages and writes docs/agents/build, the session's standing task list, the retry question, the seat-door and copy-door clients, and the Build tab with its two chat cards. A SOURCE library — no lib/, no cordis row; the two plugins (@tracy/dsh-site-build-wordpress, @tracy/dsh-site-build-joomla) bundle it into their own lib/",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host/host.ts",
    "./client": "./src/client/client.tsx",
    "./client/strings": "./src/client/strings.ts",
    "./client/api": "./src/client/api.ts",
    "./build": "./src/host/build.mjs",
    "./stages": "./src/host/stages-shared.mjs",
    "./design-record": "./src/host/design-record.mjs",
    "./design-check": "./src/host/design-check.mjs",
    "./design-probe": "./src/host/design-probe.mjs",
    "./library-ids": "./src/host/library-ids.mjs",
    "./quickstarts": "./src/quickstarts.mjs",
    "./todos": "./src/host/todos.mjs",
    "./words": "./src/host/words.mjs",
    "./host-messages": "./src/host-messages.mjs",
    "./package.json": "./package.json",
    "./questions": "./src/questions.mjs",
    "./tracy-setting": "./src/tracy-setting.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/site/tracy-site-build-core"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tracy/core": "workspace:^",
    "@tracy/ui": "workspace:^",
    "lucide-react": "^0.525.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
