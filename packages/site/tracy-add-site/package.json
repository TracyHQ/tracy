{
  "name": "@tracy/dsh-add-site",
  "version": "0.6.28",
  "description": "Add a site to Tracy from inside dsh: one wizard, two origins — create a new site on the fleet, or import one that already exists",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/site/tracy-add-site"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1-tracy.40 <0.24.1"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tracy/core": "workspace:^",
    "@tracy/ui": "workspace:^",
    "@tracy/wo-views": "workspace:^",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "website-opportunities": "workspace:*"
  },
  "license": "MIT"
}
