{
  "name": "@tracy/dsh-site-build-emdash",
  "version": "0.1.0",
  "description": "Build a NEW EmDash site from its base template: the EmDash Build tab on better-sidebar, a name-only form, two stages (check · shot) — the quickstart the fleet restores already carries the template, the pages and the copy, so there is nothing to theme, style, write or seed — and one agent tool, tracy_site_build_emdash. Everything shared with the WordPress and Joomla plugins is @tracy/site-build-core, bundled in.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "words",
    "cordis.patch.yml",
    "questions.json"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/site/tracy-site-build-emdash"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1-tracy.40 <0.24.1"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tracy/ui": "workspace:^",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "@tracy/site-build-core": "workspace:^"
  },
  "license": "MIT"
}
