{
  "name": "@tracy/dsh-chat-input",
  "version": "0.5.0",
  "description": "Tracy's first screen above dsh's input bar \u2014 the bar itself stays dsh's, dressed by dsh-brand.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/ui/tracy-chat-input"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1-tracy.40 <0.24.1"
  },
  "devDependencies": {
    "@tracy/core": "workspace:^",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "dependencies": {
    "@tracy/ui": "workspace:^"
  }
}
