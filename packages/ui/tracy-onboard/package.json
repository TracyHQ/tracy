{
  "name": "@tracy/dsh-onboard",
  "version": "0.1.0",
  "description": "The Getting started screen, on the web and in the desktop app: pick your AI account, appearance and language, and in the app the programs found on this computer and notifications when the agent finishes. Shown once per account on the web and in the app; reopened from the account menu.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/ui/tracy-onboard"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@tracy/core": "workspace:^",
    "@tracy/dsh-model-plan": "workspace:^",
    "@tracy/dsh-settings": "workspace:^",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
