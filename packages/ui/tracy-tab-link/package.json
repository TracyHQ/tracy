{
  "name": "@tracy/dsh-tab-link",
  "version": "0.1.3",
  "description": "The address bar names the side-card tab in sight (?tab=&site=), a pasted address opens that tab, and a double-click on the tab strip gap resets the right column width",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1-tracy.40 <0.24.1"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tracy/core": "workspace:^",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
