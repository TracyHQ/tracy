# Settings for `docker compose up`. Copy this file to `.env` and fill in what you use; `.env` is never committed.

# Required: the operator token, at least 24 characters. The README's quickstart appends it to .env:
#   printf 'OPERATOR_TOKEN=%s\n' "$(openssl rand -hex 32)" >> .env

# The port on this machine's loopback (http://localhost:<HOST_PORT>).
HOST_PORT=8080

# Optional: who signs outreach drafts, and the address people use to reach the server.
OPERATOR_NAME=
# PUBLIC_ORIGIN=http://localhost:8080

# Provider keys. Each is optional: a key left empty turns its source off, and OpenStreetMap needs no key.
# OpenStreetMap search uses public Overpass instances, which rate-limit busy addresses; set your own (an https
# address the server can reach on the internet) to search through it instead.
# OVERPASS_URL=https://overpass.example.com/api/interpreter
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
RAPIDAPI_KEY=
SCRAPECREATORS_API_KEY=
LITESCRAPE_API_KEY=
DEEPSEEK_API_KEY=

# Tracy, for "Build it with Tracy" (connect on the Operator page, Tracy tab). Left commented, the server uses Tracy
# itself. To use another Tracy (a test deployment), uncomment both lines and change them: TRACY_API_URL is where that
# Tracy answers /v1, when it is another address.
# TRACY_URL=https://cowork.tracy.ai
# TRACY_API_URL=https://api.tracy.ai

# Shared research hub (off by default; see README "The shared research hub").
# HUB_URL=https://hub.example.com
# HUB_TOKEN=
# HUB_CONTRIBUTE=0
# HUB_SERVE=0
