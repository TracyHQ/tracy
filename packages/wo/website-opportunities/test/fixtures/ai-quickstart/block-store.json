{
  "$comment": "An invented block store description (ADR 0046) for an invented template, used by the contract check tests. No real template or business.",
  "schema": "tracy-ai-quickstart-block-store/v1",
  "roleVocabularyVersion": "place-content-roles/3",
  "template": { "slug": "example-template", "version": "1.0.0" },
  "blocks": [
    {
      "id": "header-main",
      "type": "header",
      "positions": ["header"],
      "items": { "min": 1, "max": 1 },
      "noData": { "rule": "hide" },
      "fields": [
        { "name": "cta_label", "kind": "contact.cta_label", "type": "text", "limit": 18 },
        { "name": "cta_link", "kind": "contact.cta_url", "type": "link" },
        { "name": "sticky", "type": "design" }
      ]
    },
    {
      "id": "hero-home",
      "type": "hero",
      "positions": ["masthead", "content-top"],
      "items": { "min": 1, "max": 1 },
      "noData": { "rule": "fallback", "fallback": "editorial heading over the template picture" },
      "fields": [
        { "name": "heading", "kind": "business.tagline", "type": "text", "limit": 42 },
        { "name": "lead", "kind": "business.summary", "type": "text", "limit": 160 },
        {
          "name": "photo",
          "kind": "business.hero_image",
          "type": "image",
          "frame": { "width": 1600, "height": 900 }
        },
        { "name": "background", "type": "design" }
      ]
    },
    {
      "id": "services-grid",
      "itemsLabel": "Bakes",
      "type": "services",
      "positions": ["content"],
      "items": { "min": 2, "max": 3 },
      "noData": { "rule": "hide" },
      "fields": [{ "name": "heading", "kind": "editorial.heading", "type": "text", "limit": 30 }],
      "itemFields": [
        {
          "name": "name",
          "kind": "offering.name",
          "type": "text",
          "limit": 24,
          "slots": ["module-13.1", "module-13.2", "module-13.3"]
        },
        {
          "name": "price",
          "kind": "offering.price",
          "type": "number",
          "slots": ["module-13.4", "module-13.5", "module-13.6"]
        },
        {
          "name": "icon",
          "kind": "editorial.item_icon",
          "type": "icon",
          "storage": "image-file",
          "frame": { "width": 48, "height": 48 },
          "slots": ["module-13.7", "module-13.8", "module-13.9"]
        },
        {
          "name": "link",
          "kind": "editorial.navigation_url",
          "type": "link",
          "derived": "the item page address"
        }
      ],
      "itemLists": [
        {
          "name": "sessions",
          "label": "Baking days",
          "items": { "min": 0, "max": 2 },
          "itemsFrom": {
            "min": "invented: a card lays out with no session row",
            "max": "invented: the most session rows a stored item holds"
          },
          "fields": [
            {
              "name": "day",
              "kind": "offering.schedule",
              "type": "text",
              "limit": 20,
              "slots": [["module-13.10", "module-13.12"], ["module-13.14"], []]
            },
            {
              "name": "time",
              "kind": "offering.schedule",
              "type": "text",
              "limit": 16,
              "slots": [["module-13.11", "module-13.13"], ["module-13.15"], []]
            }
          ]
        }
      ]
    },
    {
      "id": "footer-main",
      "type": "footer",
      "positions": ["footer"],
      "items": { "min": 1, "max": 1 },
      "noData": { "rule": "hide" },
      "fields": [{ "name": "copyright", "kind": "business.copyright", "type": "text", "limit": 80 }],
      "lists": [
        {
          "name": "opening-hours",
          "label": "Opening hours",
          "items": { "min": 2, "max": 2 },
          "itemsFrom": {
            "min": "invented: the footer column draws both stored lines",
            "max": "invented: the lines the template stores"
          },
          "fields": [
            {
              "name": "line",
              "kind": "offering.schedule",
              "type": "text",
              "limit": 32,
              "slots": [["module-14.1", "module-14.2"]]
            }
          ]
        }
      ]
    }
  ]
}
