{
  "name": "website-opportunities",
  "license": "Apache-2.0",
  "version": "0.1.9",
  "description": "Website Opportunities domain: discovery, crawling, connectors, media, brand and site brief logic for finding local businesses that need a better website",
  "type": "module",
  "private": true,
  "exports": {
    "./domain": "./domain/index.mjs",
    "./domain/*": "./domain/*",
    "./src/*": "./src/*",
    "./ui": "./ui/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "domain",
    "src",
    "ui"
  ],
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.11",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "tinyld": "1.3.4"
  },
  "devDependencies": {
    "acorn": "8.18.0"
  },
  "optionalDependencies": {
    "impit": "0.14.7"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/standalone/server.js",
    "test:ci": "node --import tsx ../../../scripts/ci/turbo-setup.mjs --check --task-part owner=packages/wo/website-opportunities"
  }
}
