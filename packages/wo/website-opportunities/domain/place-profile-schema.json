  "required": [
    "schema",
    "schemaVersion",
    "business",
    "classification",
    "offerings",
    "people",
    "faqs",
    "quotes",
    "events",
    "media",
    "links",
    "sources",
    "evidence",
    "coverage",
    "conflicts",
    "claims",
    "brand",
    "extensions"
  ],
  "additionalProperties": false,
