                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["hex"],
                "additionalProperties": false
              }
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        },
        "fonts": {
          "$ref": "#/$defs/listFact"
        },
        "tagline": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9.-]*:[A-Za-z0-9._-]+$": {
          "$ref": "#/$defs/fact"
        }
      },
      "additionalProperties": false
    }
