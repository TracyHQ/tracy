        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
