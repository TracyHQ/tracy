        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      },
      "required": ["id", "value", "evidenceRefs"],
      "additionalProperties": false
