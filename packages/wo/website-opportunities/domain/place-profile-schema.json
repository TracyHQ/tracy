          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      },
      "required": ["id", "value", "evidenceRefs"],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {},
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      },
      "required": ["id", "value", "evidenceRefs"],
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["amount", "unit"],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["exact", "from", "range", "free", "on_request", "unknown"]
        },
        "raw": {
          "type": "string",
          "maxLength": 200
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "minAmount": {
          "type": "number",
          "minimum": 0
        },
        "maxAmount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priceScale": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "billingPeriod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["kind", "raw"],
      "additionalProperties": false
    },
    "providerCategory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "primaryType": {
              "type": "string",
