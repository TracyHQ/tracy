            "code": {
              "enum": [
                "food",
                "beauty",
                "health",
                "fitness",
                "hospitality",
                "travel",
                "professional",
                "creative",
                "education",
                "retail",
                "auto",
                "home",
                "events",
                "nonprofit",
                "other"
