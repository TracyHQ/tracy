    "offerings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offering"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "faqs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faq"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "claims": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statistic"
          }
        },
        "recognitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recognition"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      },
      "required": ["statistics", "recognitions", "relationships"],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/textFact"
        },
        "logo": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "object",
              "properties": {
                "mediaId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "format": "http-url"
                }
              },
              "required": ["mediaId"],
              "additionalProperties": false
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
