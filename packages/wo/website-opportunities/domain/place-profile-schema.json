              "minLength": 1,
              "maxLength": 2000
            },
            "relationship": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "http-url"
            }
          },
          "required": ["name", "relationship"],
          "additionalProperties": false
