{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracy.ai/schemas/website-opportunities/place-profile-1.json",
  "title": "Place profile 1.0.0",
  "description": "Source-backed facts and verbatim quotations, independent of a website template. Entity facts keep related values together; evidence is provenance, not an approval to publish.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "website-opportunities/place-profile"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "madeAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "business": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "$ref": "#/$defs/nameFact"
        },
        "branch": {
          "$ref": "#/$defs/textFact"
        },
        "address": {
          "$ref": "#/$defs/textFact"
        },
        "phone": {
          "$ref": "#/$defs/textFact"
        },
        "email": {
          "$ref": "#/$defs/textFact"
        },
        "nationalPhoneNumber": {
          "$ref": "#/$defs/textFact"
        },
        "internationalPhoneNumber": {
          "$ref": "#/$defs/textFact"
        },
        "location": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number"
                },
                "longitude": {
                  "type": "number"
                }
              },
              "required": ["latitude", "longitude"],
              "additionalProperties": false
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        },
        "addressComponents": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        },
        "hours": {
          "$ref": "#/$defs/listFact"
        },
        "serviceAreas": {
          "$ref": "#/$defs/listFact"
        },
        "amenities": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        },
        "reservable": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "boolean"
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "derivation": {
              "$ref": "#/$defs/derivation"
            }
          },
          "required": ["id", "value", "evidenceRefs"],
          "additionalProperties": false
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "providerCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providerCategory"
          }
