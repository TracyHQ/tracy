        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      },
      "required": ["id", "value", "evidenceRefs"],
      "additionalProperties": false
    },
    "listFact": {
      "type": "object",
