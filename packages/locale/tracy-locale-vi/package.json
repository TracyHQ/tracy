{
  "name": "@tracy/dsh-tracy-locale-vi",
  "version": "0.2.59",
  "description": "Vietnamese dictionaries for the dsh Web client — registers `vi` into every namespace dsh ships.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "language.json"
  ]
}
