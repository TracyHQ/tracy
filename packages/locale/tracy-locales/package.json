{
  "name": "@tracy/dsh-tracy-locales",
  "version": "0.1.0",
  "description": "Tracy's own namespaces in German, French, Italian, Dutch, Chinese and Spanish, plus dsh namespaces no language pack covers for those languages; owns the Spanish language entry.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "languages.json"
  ]
}
