{
  "source": "tracy-essence/emdash-0.x@0.1.0",
  "pages": ["/", "/contact", "/category/blog-health", "/category/blog-design"],
  "page": "#f8f8ff",
  "rules": [
    [".es-strip-item", "background-color", "band", 0, "--color-ink"],
    [".es-strip-item::before", "background-color", "band", 0],
    [".es-strip-content .es-pill.es-strip-pill", "background-color", "bg", 0],
    [".es-strip-content h3", "color", "on-band", 0],
    [".es-strip-content h3 a:hover", "color", "on-band", 0],
    [".es-strip-meta a, .es-strip-meta b", "color", "on-band", 0],
    [".es-card", "background-color", "bg", 0, "--color-surface"],
    [".es-card-badge", "background-color", "bg", 0],
    [".es-card .es-pill", "background-color", "bg", 0, "--color-bg"],
    [".es-card-title a", "color", "heading", 0, "--color-heading"],
    [".es-card-title a:hover", "color", "accent-text", 0, "--color-accent-text-hover"],
    [".es-card-meta a, .es-card-author", "color", "heading", 0, "--color-heading"],
    [".es-card-hits svg", "color", "accent-text", 0, "--color-accent-text"],
    [".es-card-more", "color", "heading", 0, "--color-heading"],
    [".es-card-more:hover", "color", "accent-text", 0, "--color-accent-text-hover"],
    ["body", "background-color", "bg", 0, "--color-bg"],
    ["h1, h2, h3, h4, h5, h6", "color", "heading", 0, "--color-heading"],
    ["a:hover", "color", "accent-text", 0, "--color-accent-text-hover"],
    [".es-btn", "color", "on-accent", 0, "--color-accent-on"],
    [".es-btn", "background-color", "accent", 0, "--color-accent"],
    [".es-btn:hover", "color", "on-accent", 0, "--color-accent-on"],
    [".es-btn:hover", "background-color", "accent", 0, "--color-accent-hover"],
    [".es-pill", "color", "heading", 0, "--color-heading"],
    [".es-pill", "background-color", "bg", 0, "--color-band"],
    [".es-pagination a, .es-pagination span", "background-color", "band", 0, "--color-heading"],
    [".es-pagination .is-active span", "color", "on-accent", 0, "--color-accent-on"],
    [".es-pagination .is-active span", "background-color", "accent", 0, "--color-accent"],
    [".es-pagination a:hover", "color", "muted", 0, "--color-accent-on"],
    [".es-pagination a:hover", "background-color", "accent", 0, "--color-accent"],
    [".es-page-count", "background-color", "band", 0, "--color-heading"],
    [".es-brand", "color", "heading", 0, "--color-heading"],
    [".es-nav li > a, .es-nav li > span", "color", "heading", 0, "--color-heading"],
    [
      ".es-nav li > a:hover, .es-nav li.is-active > a, .es-nav li.is-active > span",
      "color",
      "accent-text",
      0,
      "--color-accent-text"
    ],
    [".es-nav .es-sub", "background-color", "bg", 0, "--color-surface"],
    [".es-nav .es-sub a", "color", "heading", 0, "--color-heading"],
    [".es-nav .es-sub a:hover", "color", "accent-text", 0, "--color-accent-text"],
    [".es-icon-btn", "color", "heading", 0, "--color-heading"],
    [".es-icon-btn:hover", "color", "accent-text", 0, "--color-accent-text"],
    [".es-footer-menu a", "color", "heading", 0, "--color-heading"],
    [".es-footer-menu a:hover", "color", "accent-text", 0, "--color-accent-text"],
    [".es-searchbox input", "color", "heading", 0, "--color-heading"],
    [".es-searchbox input", "background-color", "bg", 0, "--color-surface"],
    [".es-offcanvas", "background-color", "bg", 0, "--color-surface"],
    [".es-offcanvas li > a, .es-offcanvas li > span", "color", "heading", 0, "--color-heading"],
    [".es-social-off", "color", "accent-text", 0, "--color-accent-text"],
    [".es-contact .ec-form-label:has(.ec-form-required)", "color", "heading", 0, "--color-heading"],
    [".es-contact .ec-form-input:not([type=\"checkbox\"])", "color", "heading", 0, "--color-heading"],
    [".es-contact .ec-form-input:not([type=\"checkbox\"])", "background-color", "bg", 0, "--color-surface"],
    [".es-contact .ec-form-submit", "color", "on-accent", 0, "--color-accent-on"],
    [".es-contact .ec-form-submit", "background-color", "accent", 0, "--color-accent"],
    [".es-contact .ec-form-submit:hover", "background-color", "accent", 0, "--color-accent-hover"],
    [".es-contact .ec-form-status", "color", "heading", 0, "--color-heading"],
    [".es-box", "background-color", "bg", 0, "--color-surface"],
    [".es-header.is-inner", "background-color", "bg", 0, "--color-band"],
    [".es-sec-title", "color", "heading", 0, "--color-heading"],
    [".es-card.is-highlight", "background-color", "band", 0],
    [".es-card.is-highlight .es-card-pic a::after", "background-color", "band", 0],
    [".es-card.is-highlight .es-card-title a, .es-card.is-highlight .es-card-more", "color", "on-band", 0],
    [
      ".es-card.is-highlight .es-card-by a, .es-card.is-highlight .es-card-by .es-card-author",
      "color",
      "on-band",
      0
    ],
    [".es-card.is-highlight .es-pill", "background-color", "bg", 0]
  ],
  "vars": [],
  "inline": [],
  "colours": {
    "#212529": "band",
    "#ffffff": "bg",
    "#f8f8ff": "bg",
    "#1a3eed": "accent-text",
    "#4d6bff": "accent-text",
    "#494c4f": "band"
  }
}
