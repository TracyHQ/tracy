{
  "source": "quickstart/ja-vega/wp7@1.1.15",
  "pages": ["/", "/about-us/", "/category-blog/", "/services"],
  "page": "#ffffff",
  "rules": [
    [".screen-reader-text:focus", "background-color", "surface", 0],
    [".skip-link.screen-reader-text:focus", "color", "fg", 0],
    [".skip-link.screen-reader-text:focus", "background-color", "surface", 0],
    [".tracy .jv-btn .wp-block-button__link", "color", "on-band", 0],
    [".jv-header", "color", "muted", 0, "--jv-on-night"],
    [".jv-header", "background-color", "band", 0],
    [
      ".jv-header .jv-nav .wp-block-navigation-item__content, .jv-mega__link, .jv-mega__trigger",
      "color",
      "muted",
      0,
      "--jv-on-night"
    ],
    [".jv-theme-toggle", "color", "muted", 0, "--jv-on-night"],
    [".tracy .jv-support__label", "color", "accent-text", 0, "--jv-amber"],
    [".jv-support__phone a", "color", "muted", 0, "--jv-on-night"],
    [".jv-drawer-toggle span", "background-color", "bg", 0, "--jv-on-night"],
    [".jv-hero", "background-color", "band", 0, "--jv-night"],
    [".tracy .jv-hero__title", "color", "on-band", 0, "--jv-on-night"],
    [".jv-hero__badge", "color", "on-band", 0, "--jv-on-night"],
    [".jv-hero__badge .jv-accent", "color", "on-band", 0, "--jv-amber"],
    [".tracy-motion-dot", "background-color", "surface", 0],
    [".jv-stats", "background-color", "band", 0, "--jv-night"],
    [".tracy .jv-stats__figure", "color", "on-band", 0, "--jv-on-night"],
    [".tracy .jv-arrow .wp-block-button__link", "background-color", "bg", 0],
    [".jv-story", "background-color", "band", 0, "--jv-night"],
    [".jv-story__box", "color", "on-band", 0, "--jv-on-night"],
    [".jv-story__category, .jv-story__category a", "color", "on-band", 0, "--jv-on-night"],
    [".tracy .jv-story__title", "color", "on-band", 0, "--jv-on-night"],
    [".jv-story__title a, .jv-story__more", "color", "on-band", 0, "--jv-on-night"],
    [".jv-cta", "color", "on-band", 0],
    [".jv-cta .jv-eyebrow", "color", "on-band", 0],
    [".tracy .jv-cta__line", "color", "on-band", 0],
    [".jv-main :where(input[type=\"submit\"], button[type=\"submit\"])", "color", "muted", 0],
    [".jv-header__menu", "background-color", "band", 0, "--jv-night"],
    [
      ".jv-mega__links .wp-block-navigation-item__content, .jv-mega__card-title a, .jv-mega__project-title a",
      "color",
      "muted",
      0,
      "--jv-on-night"
    ],
    [".jv-pill::before", "background-color", "accent", 0],
    [
      ".jv-prose :is(.btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-dark)",
      "color",
      "muted",
      0
    ],
    [".jv-prose :is(.btn-warning, .btn-info, .btn-light)", "color", "fg", 0]
  ],
  "vars": [
    ["--wp-block-synced-color", "accent"],
    ["--wp-admin-theme-color", "accent"],
    ["--wp-admin-theme-color-darker-10", "accent"],
    ["--wp-admin-theme-color-darker-20", "accent"],
    ["--wp--preset--color--pale-pink", "accent"],
    ["--wp--preset--color--vivid-red", "accent"],
    ["--wp--preset--color--luminous-vivid-orange", "accent"],
    ["--wp--preset--color--luminous-vivid-amber", "accent"],
    ["--wp--preset--color--light-green-cyan", "accent"],
    ["--wp--preset--color--vivid-green-cyan", "accent"],
    ["--wp--preset--color--pale-cyan-blue", "accent"],
    ["--wp--preset--color--vivid-cyan-blue", "accent"],
    ["--wp--preset--color--vivid-purple", "accent"],
    ["--wp--preset--color--accent", "accent"],
    ["--wp--preset--color--accent-hover", "accent"],
    ["--wp--preset--color--accent-active", "accent"],
    ["--wp--preset--color--success", "accent"],
    ["--wp--preset--color--warn", "accent"],
    ["--wp--preset--color--danger", "accent"],
    ["--jv-amber", "accent-text"]
  ],
  "inline": [],
  "colours": {
    "#dddddd": "surface",
    "#444444": "fg",
    "#eeeeee": "surface",
    "#ffffff": "on-band",
    "#000000": "band",
    "#f59e0b": "accent-text",
    "#121316": "band",
    "#e9ecef": "surface",
    "#3b8bff": "accent"
  }
}
