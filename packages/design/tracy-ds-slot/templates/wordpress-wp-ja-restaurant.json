    "button-primary": "a.btn.btn-lg.btn-primary",
    "section": "main .t3-section"
  },
  "discovered": {
    "page": "body: the page colour #f4f2e7 (tokens.css --bg, measured on the running source)",
    "display": "the welcome heading of the hero (h1.hero-heading), as on the Joomla source: 58px",
    "displayFace": "Teko 300, tracking 0.103em",
    "heading": "section titles (h2.t3-section-title): 36px",
    "body": "first body paragraph",
    "button-primary": "first filled, coloured call to action: rgb(210, 74, 36)"
  },
  "discoveredNote": "taken from the Joomla contract (joomla-ja-restaurant.json) and the port's tokens.css, which were measured on the running Joomla source; not re-read by discover.mjs on a WordPress stand of this theme (no stand in this pass)",
