        "background-color": "var(--ds-c-warn-bg) !important"
      },
      ".label-danger": {
        "color": "var(--ds-c-danger-text) !important",
        "background-color": "var(--ds-c-danger-bg) !important"
      },
      ".btn-info": {
        "color": "var(--ds-c-info-text) !important",
        "background": "transparent !important",
        "border": "1px solid var(--ds-c-info-text) !important"
      },
      ".btn-info:hover, .btn-info:focus, .btn-info:active": {
        "color": "var(--ds-c-info-text) !important",
        "background": "var(--ds-c-info-bg) !important"
      },
      "code, kbd, pre, samp": {
        "font-family": "var(--ds-font-mono, monospace)"
      },
      ".list-group-item.active": {
        "border-radius": "var(--ds-btn-radius)"
      },
      ".panel-success > .panel-heading .panel-title": {
        "color": "var(--ds-c-heading)"
      },
      ".panel-info > .panel-heading .panel-title": {
        "color": "var(--ds-c-heading)"
      },
      ".panel-warning > .panel-heading .panel-title": {
        "color": "var(--ds-c-heading)"
      },
      ".panel-danger > .panel-heading .panel-title": {
        "color": "var(--ds-c-heading)"
      },
      ".view-contact .contact-links ul li a::before": {
        "border-radius": "inherit"
      }
    }
  },
  "sideNote": "Bootstrap 3's status components (alerts, panels, labels, the info button), whose literal pale grounds and status words the release's bootstrap.css keeps (no tokenizing reached them): they wear the system's status pairs, as JA Restaurant and JA Social II (the same T3 Bootstrap) do. A panel's title reads the heading colour on its status ground (HIER-2: the warning title in warn-text read 4.95:1 beside body text at 10.37:1), its card the system's surface; code takes the system's mono face; the typography page's active list item the system's button corner (20/10/2026, 1.0.3, preview probe v10); the contact page's network buttons take the system's button corner, and the hover fill drawn by their ::before follows that corner (border-radius: inherit, a no-op at the template's square corner)",
  "pictureRules": {
    ".t3-masthead .ja-masthead::after, .acm-slideshow::before": {
      "background-image": "none",
      "background-color": "var(--ds-c-accent)",
      "mask-image": "url(\"data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='196'%20height='196'%3E%3Cimage%20width='196'%20height='196'%20href='data:image/png%3Bbase64,'/%3E%3C/svg%3E\")",
      "mask-size": "100% 100%",
      "mask-repeat": "no-repeat",
      "-webkit-mask-size": "100% 100%",
      "-webkit-mask-repeat": "no-repeat"
    }
  },
  "pictureNote": "the round stamp under the page masthead and the home slideshow (images/decor/decor_<theme>.png, 196 x 196: one brand colour drawn on transparency, the same stamp in every colour theme) stayed the template's orange under every system (ACCENT-LEAK on 24 of 28 pages, 20/10/2026): the stamp's own alpha, re-encoded at 16 levels into a PNG inside an inline SVG (a data URI, nothing fetched), masks a fill of the system's accent",
  "buttonNote": "the blog's Read more (.readmore a.btn) is an underlined text link the template styles as a button with no padding: the system's button padding made it a 141 x 48 box (CLIP-1, 20/10/2026), so it is left out of selectors.button and keeps its link look in the system's colours"
}
