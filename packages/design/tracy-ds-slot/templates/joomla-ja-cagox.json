{
  "schema": "tracy-ds-template/v1",
  "extends": "joomla-t3-ja",
  "template": "joomla/ja-cagox",
  "minVersion": {
    "quickstart/ja-cagox/j6": "1.0.3"
  },
  "maxVersion": {
    "quickstart/ja-cagox/j6": "1.0.3"
  },
  "release": "quickstart/ja-cagox/j6@1.0.3",
  "roles": {
    "page": "body",
    "display": "div.slideshow-content h2.block-title",
    "heading": "div.features-content h3",
    "body": "div.features-content p",
    "card": "ul.vmproduct > li",
    "section": "div.acm-features"
  },
  "discovered": {
    "page": "body: the page is white; the video band is a photo, not the page ground",
    "display": "largest heading near the top: the hero slide title, 55px",
    "displayFace": "Playfair Display 900, tracking 0em",
    "displayPhone": "34px",
    "heading": "the home section titles (OUR STORY), Montserrat 700 16px capitals",
    "body": "the running text of the home story sections",
    "card": "the product cards of the home tabs",
    "section": "the story sections under the video band"
  },
  "keepScopes": [],
  "baseSystem": "od:apple",
  "alphaText": true,
  "baseTokens": {
    "--bg": "#ffffff",
    "--fg": "#444444",
    "--fg-2": "#222222",
    "--accent": "#da4e35",
    "--accent-hover": "#c33c24",
    "--surface": "#f7f7f7",
    "--meta": "#999999",
    "--success": "#5cb85c",
    "--warn": "#f0ad4e",
    "--danger": "#d9534f",
    "--border": "#eeeeee",
    "--muted": "#666666",
    "--font-display": "\"Playfair Display\", serif",
    "--font-body": "\"Playfair Display\", serif",
    "--accent-on": "#ffffff"
  },
  "darkTokens": {},
  "extraPalettes": [
    {
      "fg": "#333333",
      "fg-2": "#111111",
      "muted": "#555555",
      "meta": "#aaaaaa",
      "accent-hover": "#a4321e",
      "border": "#dddddd",
      "border-soft": "#e5e5e5",
      "surface": "#f2f2f2"
    },
    {
      "fg-2": "#000000",
      "border": "#cccccc",
      "surface": "#f5f5f5"
    },
    {
      "border": "#f7f7f7",
      "surface": "#eeeeee"
    }
  ],
  "baseNote": "T3 less/variables.less (colours) and the default home page (discover.mjs, 1440): page #fff, body text #444, headings #222, the accent #da4e35 and its readable shade #c33c24 (links, the active tab). The display line and the body are Playfair Display; labels, menus and buttons Montserrat (they read the body face role in the stylesheets)",
  "selectors": {
    "displaySize": "h2.block-title",
    "heading": [".t3-wrapper h2", ".t3-wrapper h3"],
    "button": [".btn:not(.off-canvas-toggle):not(.btn-block)"],
    "buttonPrimary": [],
    "card": ["ul.vmproduct > li"],
    "container": ["#t3-mainbody .container, .container"],
    "bodyFace": ["body"],
    "inkImages": [
      ".logo .logo-img[src$=\"/images/joomlart/logo/logo-default.png\"]",
      ".logo .logo-img-sm[src$=\"/images/joomlart/logo/logo-mobile.png\"]",
      ".t3-header:not(.dark-style) .vmCartModule .total_products::before"
    ]
  },
  "displayImportant": true,
  "displayImportantNote": "js/script.js sets the slideshow title to 55px as an inline style on windows at least 768px wide and 768px tall; only !important beats it (Notion, Airbnb and nine more systems read 55px at 1440x900 without it)",
  "contrast": {
    "accent-text": ".t3-wrapper a:not([class*=btn]):not(:has(img))",
    "muted": ".t3-wrapper p:not([class*=hero]):not([class*=banner]):not([class*=slide]):not(.block-intro)",
    "body": ".t3-wrapper p, .t3-wrapper li",
    "heading": ".t3-wrapper :is(h1, h2, h3, h4)",
    "footer": ".t3-footer a, #t3-footer a"
  },
  "module": {
    "title": "Tracy design system",
    "position": "head-search",
    "ordering": 0,
    "style": "System-none",
    "why": "head-search is in the header block every layout of the quickstart loads (tpls/blocks/header.php) and renders whenever a module sits in it; off-canvas renders earlier on the home page (byte 7340 against 24720 of 14 positions tried) but only while the style's off-canvas option is on"
  },
  "ready": true,
  "readyNote": "Release-specific acceptance is measured by flow.mjs, preview-check.mjs and preview-parity.mjs, with results in design-system-measurement.json.",
  "bands": {
    ".block-slideshow-item:not(.dark-style)": {
      "ground": "#ffffff",
      "texts": ["#000000", "#111111"],
      "fill": true,
      "important": true,
      "picture": true,
      "paint": {
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      },
      "media": "(min-width: 768px)"
    },
    ".slideshow-content.dark-style": {
      "ground": "#000000",
      "texts": ["#ffffff", "#aaaaaa"],
      "fill": true,
      "important": true,
      "paint": {
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    },
    ".block-slideshow-item.dark-style": {
      "ground": "#333333",
      "texts": ["#ffffff"],
      "fill": true,
      "important": true,
      "picture": true,
      "paint": {
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      },
      "media": "(min-width: 768px)"
    },
    ".block-hero.dark-style": {
      "ground": "#ffffff",
      "texts": ["#000000", "#111111"],
      "fill": true,
      "important": true,
      "picture": true,
      "paint": {
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    },
    ".block-hero.light-style": {
      "ground": "#ffffff",
      "texts": ["#000000", "#111111"],
      "fill": true,
      "important": true,
      "picture": true,
      "paint": {
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    },
    ".block-video": {
      "ground": "#000000",
      "texts": ["#ffffff"],
      "fill": true,
      "important": true,
      "picture": true,
      "paint": {
        ".block-content": {
          "background-color": "ground"
        }
      }
    },
    ".t3-footer": {
      "ground": "#111111",
      "texts": ["#aaaaaa", "#ffffff"],
      "fill": true,
      "important": true,
      "paint": {
        ".module small a": {
          "color": "accent"
        },
        ".copyright small a": {
          "color": "accent"
        }
      }
    },
    ".slideshow-content:not(.dark-style)": {
      "ground": "#ffffff",
      "texts": ["#000000", "#444444"],
      "fill": true,
      "repaint": true,
      "important": true,
      "media": "(max-width: 767px)",
      "paint": {
        ".btn-border, .btn-default": {
          "background-color": "ground",
          "border-color": "text",
          "color": "text"
        },
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    },
    ".hero-content.col-md-6": {
      "ground": "#ffffff",
      "texts": ["#000000", "#444444"],
      "fill": true,
      "repaint": true,
      "important": true,
      "media": "(max-width: 767px)",
      "paint": {
        ".btn-border, .btn-default": {
          "background-color": "ground",
          "border-color": "text",
          "color": "text"
        },
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    },
    ".hero-content.col-md-offset-6": {
      "ground": "#ffffff",
      "texts": ["#000000", "#444444"],
      "fill": true,
      "repaint": true,
      "important": true,
      "paint": {
        ".btn-border, .btn-default": {
          "background-color": "ground",
          "border-color": "text",
          "color": "text"
        },
        ".btn-border:hover, .btn-border:focus, .btn-default:hover, .btn-default:focus": {
          "background-color": "text",
          "border-color": "text",
          "color": "ground"
        }
      }
    }
  },
  "bandsNote": "Plain headers and slideshow grounds follow the page. Photo text and outline buttons are paired to the actual photograph ground, including the bright landing photograph whose source class is dark-style. Its right-hand caption and all phone hero captions wear opaque paired system panels where words otherwise cross both pale and dark areas of a photograph. The footer wears its own paired band colours. A photo slide's own ground, shown while its photograph loads and wherever it does not reach, matches the photograph its words are paired to: a light slide wears a light system colour (the page under a light system, the page text under a dark one) and a dark slide a dark one (the system's ink under a light system, the page under a dark one). That ground is drawn as a one-colour picture layer as well as a colour: it stands in for the photograph, so it is never read as a band of its own, and the words over it are judged against the photograph.",
  "maxVersionNote": "1.0.3 is rebuilt from template 2.0.3 with release-joomla.mjs. Release-specific measurements accompany the content contract; older source versions are outside this measured range.",
  "followRules": {
    ".t3-header, .t3-slideshow": {
      "background-color": "bg!",
      "color": "fg!"
    },
    ".reset .form-validate p, .remind .form-validate p": {
      "background-color": "surface!",
      "color": "fg!",
      "border-color": "border!"
    },
    ".checkout-button-top": {
      "border-color": "border-soft!"
    },
    ".block-slideshow .slick-slider": {
      "background-color": "bg!"
    },
    ".block-slideshow.style-1:has(.block-slideshow-item.active.light-style) .carousel-indicators li": {
      "border-color": "ink!"
    },
    ".block-slideshow.style-1:has(.block-slideshow-item.active.light-style) .carousel-indicators li.active": {
      "background-color": "ink!"
    },
    ".block-slideshow.style-1:has(.block-slideshow-item.active.dark-style) .carousel-indicators li": {
      "border-color": "on-ink!"
    },
    ".block-slideshow.style-1:has(.block-slideshow-item.active.dark-style) .carousel-indicators li.active": {
      "background-color": "on-ink!"
    },
    ".t3-header .vmCartModule .total_products": {
      "border-color": "fg!"
    },
    ".t3-slideshow .block-slideshow .carousel-control span": {
      "background-color": "on-ink!"
    },
    ".t3-header .off-canvas-toggle, .t3-header .off-canvas-toggle .fa, .t3-header .navbar-default .navbar-nav > li > a, .t3-header .vmCartModule .total_products": {
      "color": "fg!"
    },
    ".t3-header .navbar-default .navbar-nav > li > a .caret": {
      "border-top-color": "fg!",
      "border-bottom-color": "fg!"
    },
    "#fp-nav": {
      "background-color": "surface!",
      "color": "fg!"
    },
    "#fp-nav ul li a span": {
      "border-color": "fg!"
    },
    "#fp-nav ul li a.active span": {
      "background-color": "fg!"
    }
  },
  "measureStill": true,
  "sideRules": {
    "light": {
      ".block-slideshow-item:not(.dark-style)": {
        "background-color": "var(--ds-c-bg)!important",
        "background-image": "linear-gradient(var(--ds-c-bg), var(--ds-c-bg))!important"
      },
      ".block-slideshow-item.dark-style": {
        "background-color": "var(--ds-c-ink)!important",
        "background-image": "linear-gradient(var(--ds-c-ink), var(--ds-c-ink))!important"
      },
      ".t3-header.dark-style .logo-img[src$=\"/images/joomlart/logo/logo-default-light.png\"], .t3-header.dark-style .logo-img-sm[src$=\"/images/joomlart/logo/logo-mobile-light.png\"], .t3-header.dark-style .vmCartModule .total_products::before": {
        "filter": "invert(1) hue-rotate(180deg)!important"
      }
    },
    "dark": {
      ".block-slideshow-item:not(.dark-style)": {
        "background-color": "var(--ds-c-fg)!important",
        "background-image": "linear-gradient(var(--ds-c-fg), var(--ds-c-fg))!important"
      },
      ".block-slideshow-item.dark-style": {
        "background-color": "var(--ds-c-bg)!important",
        "background-image": "linear-gradient(var(--ds-c-bg), var(--ds-c-bg))!important"
      }
    }
  }
}
