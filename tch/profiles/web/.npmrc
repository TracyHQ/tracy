# npmjs, and only npmjs -- but this profile does not install anything anyway.
#
# dsh materializes a profile by running pnpm INSIDE this directory, and pnpm reads only the
# project-level .npmrc plus the user and global ones; it does not walk up to the repository root.
# That is why the file exists at all. What it used to say -- a private registry holding @tracy/*
# and the `-tracy.N` forks -- is gone: those packages are workspace members of this repository
# now, and `scripts/materialize-profile.mjs` links them straight in.
registry=https://registry.npmjs.org
