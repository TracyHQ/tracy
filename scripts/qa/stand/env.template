# QA stand env overrides — applied by make-env.mjs on top of deploy/.env.example of the tree under
# test (tasks/todo-daily-qa.md §4.5). Every key of .env.example is kept; the keys below replace its
# value; keys .env.example does not have are appended.
#
# Markers: {{QA_HOME}}, {{QA_TOOL_DIR}} are absolute paths; {{secret}} is a fresh random value;
# {{copy:NAME}} is copied from the shared checkout's deploy/.env (only MODEL_API_KEY is allowed);
# {{releases-token}} is the content of --releases-token-file, or empty.
# Every DEMO_*, CLOUDFLARE_*, GITHUB_APP_*, GOOGLE_*, GITHUB_OAUTH_* key is forced empty.

QA_HOME={{QA_HOME}}
QA_TOOL_DIR={{QA_TOOL_DIR}}

TRACY_ORIGIN=http://qa.tracy.test:36080
SITE_DOMAIN=qa.tracy.test
SITE_DOMAIN_ALIASES=
SESSION_DOMAIN=qa.tracy.test
# The public /v1 API answers only on this host (apps/tracy-web/src/lib/api-host.js); the gate's
# `apiHost` default (gate/gate.mjs) is its hostname.
API_ORIGIN=http://api.qa.tracy.test:36080
# The docs site is served only at the root of its own host; tracy-web does not start without it.
DOCS_ORIGIN=http://docs.qa.tracy.test:36080
BADGE_URL=

SESSION_SECRET={{secret}}
# Seat API keys on: without a pepper `/api/me/keys` answers API_KEYS_NOT_CONFIGURED and the
# PRs that touch the public API cannot be checked.
API_KEY_PEPPER={{secret}}
MCP_TRACY_ACTOR_SECRET={{secret}}
HOST_local_SECRET={{secret}}
SEAT_local_SECRET={{secret}}

HOST_NAME=local
HOSTS=local
HOST_local_ORIGIN=http://tracy-host:36720
HOST_local_DSH_ORIGIN=http://tracy-dsh:8080

TRACY_SITES_ROOT={{QA_HOME}}/sites
TRACY_PRIVATE_ROOT={{QA_HOME}}/private
TRACY_DSH_HOME={{QA_HOME}}/dsh-home
ONBOARDING_HOME=

DATABASE_URL=postgres://tracy:tracy@postgres:5432/tracy
POSTGRES_PORT=36730
TEST_DATABASE_URL=postgres://tracy:tracy@127.0.0.1:36730/tracy
WEB_PORT=36080
QA_WEB_HOST_PORT=36081
QA_DSH_PORT=36700
TRACY_HOST_PORT=36720
MINIO_PORT=36740
ARTIFACT_S3_ENDPOINT=http://host.docker.internal:36740
ARTIFACT_S3_PUBLIC_ENDPOINT=
TRACY_MIGRATE_S3_ENDPOINT=http://host.docker.internal:36740

APP_IMAGE_TAG=qa
APP_IMAGE_TAG_PREVIOUS=qa-prev
DSH_IMAGE_TAG=qa

TRACY_NETWORK_PREFIX=10.91.36
TRACY_SITE_NETWORK=tracy-qa_tracy
TRACY_SITE_DNS=10.91.36.53
TRACY_SITE_SUBNET_PREFIX=10.241
SITE_ADDRESS_PREFIX=qa-
SITE_PORT_MIN=53000
SITE_PORT_MAX=53019

# The product's egress fence only blocks mail ports and cannot run in a container on a Mac; the QA
# fence (netfilter chain QA-EGRESS + the qa-egress proxy) replaces it.
TRACY_EGRESS_FENCE=off
LOCAL_LOGIN_PREVIEW=0
MAIL=console
SITE_MAIL=off
TRACY_ENVIRONMENT=qa

MODEL_API_KEY={{copy:MODEL_API_KEY}}
OPENROUTER_API_KEY=
TRACY_RELEASES_GITHUB_TOKEN={{releases-token}}
TRACY_LOCAL_RELEASES_DIR=
