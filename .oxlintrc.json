{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": { "es2024": true },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".claude/worktrees/**",
    // Astro's cache for the API documentation site (generated `.d.ts`, not authored code).
    "apps/tracy-docs/.astro/**",
    // The Welcome popup's animated scenes, copied as they are from the approved prototype
    // (`apps/tracy-web/src/welcome/route.js`): not authored in this tree.
    "apps/tracy-web/src/welcome/scenes/**",
    // dsh plugin client bundles — generated by esbuild, not authored code.
    "**/lib/*.js",
    // Motion library installed into the themes — also an esbuild bundle, generated from
    // `packages/cms/tracy-cms-motion/src/`. Editing it in place edits a build that the next
    // regeneration wipes; the source is where linting means something.
    "packages/cms/tracy-wordpress-theme/src/tracy/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/tracy-base/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-tracy-business/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-kinetic/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-morgan/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-vega/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-nova/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-essence/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-impact/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-restaurant/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-diner/assets/js/tracy-motion.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-fresco/assets/js/tracy-motion.js",
    "packages/cms/tracy-joomla-template/src/tpl_tracy/media/js/tracy-motion.js",
    // Same kind, same reason: the agent live preview is generated from `packages/cms/tracy-cms-preview/src/`,
    // minified and copied byte-identical into the themes. Linting it lints esbuild output — and fixing
    // what the linter says turns the `cms-preview --check` gate red on the next run.
    "packages/cms/tracy-wordpress-theme/src/tracy/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/tracy-base/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-tracy-business/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-kinetic/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-morgan/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-vega/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-nova/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-essence/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-impact/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-restaurant/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-diner/assets/js/tracy-preview.js",
    "packages/cms/tracy-wordpress-theme/src/wp-ja-fresco/assets/js/tracy-preview.js",
    "packages/cms/tracy-joomla-template/src/tpl_tracy/media/js/tracy-preview.js",
    // The same bundle as a string module for the site proxy; same run, same gate.
    "apps/tracy-web/src/bar/tracy-preview.generated.js",
    // A JA template's own script (JoomlArt's code, its own style) with a Tracy block appended, applied over the
    // release when it is cut (template-patches/README.md): linting it is linting JoomlArt's file, and "fixing"
    // it rewrites what the release ships. Only the dark-mode patches, by path.
    "packages/cms/tracy-joomla-quickstart/template-patches/ja-dark-mode/**/js/template.js",
    // The desktop app's window shell bundle (build/build-shell.mjs), gitignored.
    "packages/desktop/tracy-desktop/src/generated/**",
    // 🔒 THIS CODE'S HOME IS ANOTHER REPO — `lab3-ai/mention-network-shopify`, folder `gitpush-noti/`.
    // Excluded for the same reason as `vendor/**`: it follows that repo's formatting (`;`,
    // trailing commas), while this repo pins `semicolons: asNeeded` + `trailingCommas: none`. Forcing
    // our rules on it makes every line drift from upstream, and pushing back home becomes an
    // unreadable diff. Change the code there, then pull it in.
    "gitpush-noti/**",
    "vendor/**",
    "tch/**",
    "data/**",
    ".teamshare/**",
    // 🔒 ALSO A BUNDLE, AND ITS SOURCE IS NOT IN THIS REPO. The file header says so:
    // `// src/shared/utils/webrootZonesCli.ts` — the source lives in `tracy-desk`. It guards the core
    // zones on a fleet host: runs here, edited there. Changing `var` to `const` in it edits a build
    // the next regeneration wipes. An open cross-repo drift point — written down so it doesn't stay
    // silent. (`tracy-infra` excludes this exact file for the same reason.)
    "packages/fleet/tracy-fleet-operation/scripts/lib/webroot-zones.cjs"
  ],
  "categories": {
    // ONLY `correctness`. Adding `suspicious` and `perf` produces hundreds of warnings on working
    // code, and since the gate runs `--deny-warnings` it would stay red forever. A gate that is always
    // red is a gate that gets ignored. Same scope as `tracy-desk` and `tracy-infra` use.
    "correctness": "error"
  },
  "rules": {
    // `x != null` is deliberate: "neither null nor undefined" in one expression.
    // Flagging it forces `x !== null && x !== undefined` — longer, no safer.
    "eqeqeq": ["warn", "always", { "null": "ignore" }],
    "no-var": "error",
    // Gates talk to people through stdout/stderr; `console` is the only channel. In a
    // Worker, `console` is also the only way to reach `wrangler tail`.
    "no-console": "off",
    // `cond ? a() : b()` as a STATEMENT is an existing idiom in `scripts/test/services.test.mjs`
    // (`entry.isDirectory() ? walk(full) : out.push(full)`). It reads fine, and changing it just to
    // please a rule is another PR's job.
    "no-unused-expressions": ["error", { "allowTernary": true }],
    // OFF FOR FALSE POSITIVES, each site checked, not switched off blindly. The rule reads `method`
    // as a string constant; in `seat-registry/src/artifacts.js:151` and `src/index.js:741` it is a
    // VARIABLE, and `body: body || undefined` means "no body, send nothing" — exactly the
    // `undefined` fetch expects. Two sites, both false alarms.
    // (`tracy-infra` turns off this exact rule for the same reason on the same files.)
    "no-invalid-fetch-options": "off"
  },
  "overrides": [
    {
      // Gates and tools: run on Node under `tsx`.
      "files": ["scripts/**/*.{ts,mjs,js}"],
      "env": { "node": true, "es2024": true }
    },
    {
      // Electron main process: Node.
      "files": ["packages/desktop/**/*.{js,cjs,mjs}"],
      "env": { "node": true, "es2024": true }
    },
    {
      // Plugin build scripts: Node, run with `node scripts/build-client.mjs`.
      "files": ["packages/*/*/scripts/*.mjs"],
      "env": { "node": true, "es2024": true }
    },
    {
      "files": ["**/*.test.{ts,tsx,mjs}", "**/test/**"],
      "env": { "node": true, "es2024": true }
    }
  ]
}
