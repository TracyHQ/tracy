{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:ci": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/check-tests.ts",
        "$TURBO_ROOT$/scripts/test-timing-reporter.mjs",
        "$TURBO_ROOT$/scripts/test-database.ts",
