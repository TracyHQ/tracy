    "pages": [
      {
        "what": "A new page: a post of type page whose body is the theme's own text section (heading, then one title + text pair per question). The receipt gives its id; a bare draft is not a page.",
        "where": {
          "kind": "post",
          "field": "post_content"
        },
        "door": {
          "tool": "tracy_site",
          "call": {
            "action": "content.update",
            "params": {
              "kind": "post",
              "fields": {
                "post_type": "page",
                "post_title": "<title>",
                "post_name": "<slug>",
                "post_status": "publish",
                "post_content": "<!-- wp:group {\"tagName\":\"section\",\"className\":\"wtb-section wtb-text\"} -->\n<section class=\"wp-block-group wtb-section wtb-text\">\n<!-- wp:group {\"className\":\"wtb-inner wtb-text__inner\"} -->\n<div class=\"wp-block-group wtb-inner wtb-text__inner\">\n<!-- wp:group {\"className\":\"wtb-text__copy\"} -->\n<div class=\"wp-block-group wtb-text__copy\">\n<!-- wp:group {\"className\":\"wtb-head\"} -->\n<div class=\"wp-block-group wtb-head\">\n<!-- wp:heading {\"className\":\"wtb-heading\"} -->\n<h2 class=\"wp-block-heading wtb-heading\"><page heading></h2>\n<!-- /wp:heading -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"wtb-text__list\"} -->\n<div class=\"wp-block-group wtb-text__list\">\n<!-- wp:group {\"className\":\"wtb-text__point\"} -->\n<div class=\"wp-block-group wtb-text__point\">\n<!-- wp:paragraph {\"className\":\"wtb-text__point-title\"} -->\n<p class=\"wtb-text__point-title\"><question></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"wtb-text__point-text\"} -->\n<p class=\"wtb-text__point-text\"><answer></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- one more wtb-text__point group per further heading and paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</section>\n<!-- /wp:group -->"
              },
              "apply_id": "<new id>"
            }
          }
        },
