      {
        "what": "Then its menu link: add a navigation-link block to the Header menu (nav post 68) where wanted: content.get outline:true numbers its blocks and gives rev; +<i> inserts before block i, +<count> appends.",
        "versions": ["1.1.0"],
        "where": {
          "kind": "post",
          "id": 68,
          "field": "post_content"
        },
        "door": {
          "tool": "tracy_site",
          "call": {
            "action": "content.update",
            "params": {
              "kind": "post",
              "id": 68,
              "rev": "<rev of that read>",
              "blocks": {
                "+<i>": "<!-- wp:navigation-link {\"label\":\"<title>\",\"type\":\"page\",\"id\":<page id>,\"url\":\"<page url>\",\"kind\":\"post-type\"} /-->"
              },
              "apply_id": "<new id>"
            }
          }
        },
        "languages": "One navigation post per language; the other language's page goes in its twin post.",
        "proof": [
