        "where": {
          "kind": "article",
          "field": "fulltext",
          "catid": 263
        },
        "door": {
          "tool": "tracy_site",
          "call": {
            "action": "content.update",
            "params": {
              "kind": "article",
              "id": 0,
              "fields": {
                "title": "<title>",
                "catid": 263,
                "state": 1,
                "language": "en-GB",
                "fulltext": "<h3><question></h3><p><answer></p>"
              },
              "apply_id": "<new id>"
            }
          },
          "then": {
            "tool": "tracy_site",
            "call": {
              "action": "content.update",
              "params": {
                "kind": "menuItem",
                "id": 0,
