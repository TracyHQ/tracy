    "fflate": "0.8.3",
    "hono": "4.13.11",
    "impit": "0.14.7",
    "papaparse": "5.5.3",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "ssh2": "1.17.0",
