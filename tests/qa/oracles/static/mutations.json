{
  "about": "Recorded mutations of product files, applied only inside a scratch overlay (never the real tree). A mutation proves a gate case RED when, after a green positive control, the SAME gate command exits non-zero and prints a line matching `expect.output`. Output that looks like a load failure is never accepted as RED.",
  "mutations": [
    {
      "id": "plugin-identity-name-drift",
      "gate": "plugin-identity",
      "description": "Rename the inbox plugin's package.json name so it disagrees with its cordis row and bundle id (the 2026-08-30 silent-render-nothing failure).",
      "oracle": {
        "source": "CLAUDE.md",
        "ref": "§2 rule 2"
      },
      "assertionId": "static.plugin-identity.names-must-match",
      "edits": [
        {
          "file": "packages/site/tracy-inbox/package.json",
          "op": "replace",
          "find": "\"name\": \"@tracy/dsh-inbox\"",
          "replace": "\"name\": \"@tracy/dsh-inboxx\""
        }
      ],
      "expect": {
        "output": [
          "__ModuleLoader__ id is \"@tracy/dsh-inbox\" but the package is named \"@tracy/dsh-inboxx\""
        ]
      }
    },
    {
      "id": "self-contained-link-dependency",
      "gate": "self-contained",
      "description": "Point a workspace dependency at a link: path outside registry/workspace.",
      "oracle": {
        "source": "CLAUDE.md",
        "ref": "§2 rule 1"
      },
      "assertionId": "static.self-contained.no-link-dependency",
      "edits": [
        {
          "file": "packages/ui/tracy-assistant/package.json",
          "op": "replace",
          "find": "\"@tracy/core\": \"workspace:^\"",
          "replace": "\"@tracy/core\": \"link:../../core/tracy-core\""
        }
      ],
      "expect": {
        "output": [
          "packages/ui/tracy-assistant/package.json: devDependencies.\"@tracy/core\" is \"link:../../core/tracy-core\""
        ]
      }
    },
    {
      "id": "interface-languages-missing-key",
      "gate": "interface-languages",
      "description": "Delete one translated Vietnamese key of the inbox plugin.",
      "oracle": {
        "source": "CLAUDE.md",
        "ref": "§9 i18n"
      },
      "assertionId": "static.interface-languages.missing-key-detected",
      "edits": [
        {
          "file": "packages/locale/tracy-locale-vi/vi/tracy-inbox.json",
          "op": "json-delete-key",
          "key": "act.comment.mention"
        }
      ],
      "expect": {
        "output": ["Translate the string where the arrow points"]
      }
    },
    {
      "id": "doc-links-broken-link",
      "gate": "doc-links",
      "description": "Add a markdown link to a file that does not exist.",
      "oracle": {
        "source": "scripts/check-doc-links.ts",
        "ref": "header: every pointer must arrive somewhere"
      },
      "assertionId": "static.doc-links.broken-link-detected",
      "edits": [
        {
          "file": "docs/references/directory-map.md",
          "op": "append",
          "text": "\n[qa](docs/references/qa-does-not-exist.md)\n"
        }
      ],
      "expect": {
        "output": ["qa-does-not-exist.md"]
      }
    },
    {
      "id": "compose-yaml-unparseable",
      "gate": "compose-yaml",
      "description": "Append an unterminated flow mapping to deploy/compose.yml.",
      "oracle": {
        "source": "scripts/check-compose-yaml.ts",
        "ref": "header: every compose file under deploy/ must parse"
      },
      "assertionId": "static.compose-yaml.parse-error-detected",
      "edits": [
        {
          "file": "deploy/compose.yml",
          "op": "append",
          "text": "\n  qa_broken: {image: x,\n"
        }
      ],
      "expect": {
        "output": ["qa_broken"]
      }
    },
    {
      "id": "workflow-scripts-renamed-script",
      "gate": "workflow-scripts",
      "description": "Make a workflow step name a script path that does not exist.",
      "oracle": {
        "source": "scripts/check-workflow-scripts.ts",
        "ref": "header: every script path in .github/workflows exists"
      },
      "assertionId": "static.workflow-scripts.missing-script-detected",
      "edits": [
        {
          "file": ".github/workflows/branch-fresh-check.yml",
          "op": "replace",
          "find": "        run: node scripts/check-branch-fresh.mjs --ci",
          "replace": "        run: node scripts/check-branch-fresh-qa-missing.mjs --ci"
        }
      ],
      "expect": {
        "output": ["check-branch-fresh-qa-missing.mjs"]
      }
    },
    {
      "id": "vocabulary-banned-word",
      "gate": "vocabulary",
      "description": "Put a banned word (Workbench) in a code file as a label.",
      "oracle": {
        "source": "docs/references/vocabulary.md",
        "ref": "banned words"
      },
      "assertionId": "static.vocabulary.banned-word-detected",
      "edits": [
        {
          "file": "packages/core/tracy-core/src/interface-languages/index.mjs",
          "op": "append",
          "text": "\nexport const QA_BANNED_LABEL = 'Workbench'\n"
        }
      ],
      "expect": {
        "output": ["Workbench"]
      }
    }
  ]
}
