{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:audit-kit:schema:automation-result:2",
  "title": "audit-kit automation result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "outcome",
    "repository",
    "revision",
    "run_id",
    "assurance_target",
    "command",
    "exit_code",
    "started_at",
    "finished_at",
    "environment",
    "artifacts",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "adapter": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["success", "failure", "cancelled", "skipped"] },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "assurance_target": {
      "description": "Declared control-evidence target from core/applicability.md.",
      "enum": ["T1", "T2", "T3"]
    },
    "command": {
      "description": "Trusted verification command. Secret values must be supplied through the secret environment map, never embedded here.",
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "description": "Process exit code; null only when the command did not start or the job was cancelled.",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_os", "runner_arch", "workflow_ref"],
      "properties": {
        "runner_os": { "type": "string", "minLength": 1 },
        "runner_arch": { "type": "string", "minLength": 1 },
        "workflow_ref": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "description": "Paths or URIs retained as evidence by this run.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "description": "Explicit structured findings supplied by the project. An empty array means this run supplied none; it does not prove that no finding exists.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "f_state", "r_state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "control_id": {
            "type": "string",
            "pattern": "^CTRL-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "title": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "f_state": { "enum": ["F0", "F1", "F2", "F3"] },
          "r_state": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source"],
            "properties": {
              "kind": { "enum": ["self-reported", "tool", "independent"] },
              "source": { "type": "string", "minLength": 1 }
            }
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "red_on_bug": {
                "description": "Command/output proving the expected assertion fails on the buggy revision.",
                "type": "string"
              },
              "fail_to_pass": {
                "description": "Evidence that the same reproduction passes on the fix candidate (supports R2).",
                "type": "string"
              },
              "pass_to_pass": {
                "description": "Evidence that the applicable pre-existing suite remains green (supports R3).",
                "type": "string"
              },
              "positive_control": {
                "description": "Result of a known-good case through the same harness; pass means the harness accepts correct behavior.",
                "enum": ["pass", "fail", "not-run"]
              },
              "negative_control": {
                "description": "Result of a known-bad/fault-injected case; pass means the harness detects the bad behavior.",
                "enum": ["pass", "fail", "not-run"]
              }
            }
          },
          "evidence": {
            "description": "Artifact paths/URIs supporting the stated F/R states.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "f_state": { "const": "F3" } },
              "required": ["f_state"]
            },
            "then": {
              "required": ["oracle"],
              "properties": {
                "oracle": {
                  "required": ["kind", "source"],
                  "properties": { "kind": { "const": "independent" } }
                }
              }
            }
          }
        ]
      }
    }
  }
}
