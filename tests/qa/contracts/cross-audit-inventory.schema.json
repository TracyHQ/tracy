{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:audit-kit:schema:cross-audit-inventory:1",
  "title": "cross-audit repository inventory v1",
  "description": "Deterministic inventory of the target's first-party files with explicit exclusions, plus detected stacks, surfaces, test runners, scripts and monorepo layout. Detection is EVIDENCE, not truth: every detection carries its supporting evidence and a confidence, and anything uncertain stays in `unresolved` rather than being asserted. The inventory is bounded (file lists are capped and the cap is disclosed) and computed read-only against the pinned target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "target_digest",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Exact artifact version. Pinned rather than pattern-matched so a standalone contract check agrees with the runtime gate (crossaudit.common.CURRENT_VERSION): 1.0.0 coverage semantics differ from 1.1.0, so accepting both here would validate artifacts the engine rejects.",
      "const": "1.1.0"
    },
    "kind": {
      "const": "cross-audit-inventory"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "description": "First-party paths (relative to the target root) that support this detection.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "files_capped",
        "stacks",
        "surfaces",
        "test_runners",
        "scripts",
        "monorepo",
        "unresolved"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "files_capped": {
          "type": "boolean"
        },
        "files_sample": {
          "description": "A bounded, sorted sample of first-party paths for provenance. `file_count` is the true total; `files_capped` says whether the sample is partial.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "reason"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "capability_candidates": {
          "description": "Risk capabilities PROPOSED from first-party paths and declared dependencies, with the evidence that proposed them. Advisory only: a candidate never becomes an obligation by itself, and the operator must disposition every capability in the run config — including ones no candidate names, because a heuristic that did not match is not a finding of absence.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidence_total": {
                "type": "integer",
                "minimum": 1,
                "description": "Total paths that matched, present ONLY when `evidence` was truncated. A silently-cut evidence list reads as the whole story; this makes the cut visible."
              }
            }
          }
        },
        "stacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "surfaces": {
          "description": "Detected product surfaces. `value` is one of web/api/cli/mobile/data/library.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "test_runners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "command",
              "evidence"
            ],
            "properties": {
              "role": {
                "enum": [
                  "build",
                  "start",
                  "test",
                  "lint",
                  "typecheck",
                  "other"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "monorepo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_monorepo"
          ],
          "properties": {
            "is_monorepo": {
              "type": "boolean"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unresolved": {
          "description": "Facts detection could not settle. These remain open questions for the auditor, never silently resolved.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
