# ─────────────────────────────────────────────────────────────────────────────
# TCH — profile `web` (./run.sh web).  Copy to `.env`, then fill SETUP_KEY.
#
# ONE ENV FILE PER PROFILE, and not for tidiness: `dsh-passwords` declares the
# gateway port in the env file, not through a flag.  Two profiles sharing one
# file means two password doors bidding for one port — the second one dies with
# EADDRINUSE and shuts itself down while its dsh keeps serving, so the browser
# returns 401 and IT LOOKS EXACTLY LIKE IT IS WORKING.
#
#   .env          → profile `web`     gateway 51711, dsh 51710
#   .env.desktop  → profile `desktop` gateway 51721, dsh 51720
#   .env.native   → profile `native`  gateway 51731, dsh 51730
#
# Full guide (ports, which values are secret, where to get them):
#   docs/references/env.md
# ─────────────────────────────────────────────────────────────────────────────

# The only value you must supply.  Generate your own, never reuse anyone else's:
#   openssl rand -hex 24
# It seeds the first-run master account.  After that first run dsh-passwords
# freezes the derived keys below into this file by itself and rotates SETUP_KEY.
SETUP_KEY=

# Leave the next three EMPTY on a fresh checkout.  They are derived from
# SETUP_KEY and written back here on first successful setup (dsh-passwords F-07).
# Filling them by hand is only for restoring an existing database.
MCP_JWT_SECRET=
MCP_INTERNAL_SECRET=
MCP_DB_ENC_KEY=

# Absolute path — the gateway does not always run with the repo as its cwd.
# Replace with your own checkout.  `data/` is gitignored.
MCP_DB_PATH=/ABSOLUTE/PATH/TO/TCH/data/platform.db

# 🔒 AUTO_TLS=0 is MANDATORY locally: if the certificate request fails the
# gateway REFUSES to start rather than falling back to plain HTTP.
MCP_GATEWAY_AUTO_TLS=0
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PORT=51711
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:51710
MCP_GATEWAY_PUBLIC_HOST=127.0.0.1:51711
